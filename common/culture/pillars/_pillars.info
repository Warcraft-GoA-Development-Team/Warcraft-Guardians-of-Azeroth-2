###########
# Pillars
###########
#
# Pillars have the same structure as general cultural traits (see _cultural_traits.info ), except for a few added fields:
# 	* type
# 	* color
# 	* audio_parameter
# 
# If no description is set and no description matching the entry key exists then will use <type>_generic_label_desc as the key

pillar_key = {

	# usual cultural traits
	parameters = { ... }

	# type: what type of pillar this is. choose between:
	# * ethos				(Ethos)
	# * heritage	 		(Heritage)
	# * language	 		(Language)
	# * martial_custom		(Martial custom)
	# * head_determination	(Head Determination)
	#
	type = some_type

	# head_determination_type
	# only used by "head_determination" pillar types. Used to determine who gets to be culture head.
	# default is domain
	# choose between:
	#	* domain (character with the highest number of counties of this culture is culture head)
	#	* herd (character with the biggest herd is culture head)
	#
	head_determination_type = domain

	# color: a color used for map mode
	# only used for displaying the language. Only valid with the "language" pillar type
	# supports scripted colors and static colors
	#
	color = some_color

	# audio_parameter: flag
	# a parameter used for the audio ambiance, also accessible with "[CulturePillar.GetAudioParameter]" in GUI and localization.
	# only valid with the "heritage" pillar type.
	#
	audio_parameter = some_parameter
}

