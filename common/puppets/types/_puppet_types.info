# Puppets are characters that rulers can manipulate to achieve actions they would normally not be able to.

puppet_type_key = {
	
	# interaction: interaction used to set up a puppet of this type. The game does not set the puppet up automatically, 
	# you need to run set_puppet yourself in the interaction.
	# set up ai_targets in the interaction to be able to select the puppet from a list in the UI
	#
	interaction = interaction_to_make_puppet

	# can_have: is the ruler allowed to have this puppet?
	# scope:
	#	root: the ruler who would use this puppet
	#
	can_have = { faith = faith:catholic }

	# is_valid: Is the set up puppet still valid? will be checked daily and if the puppet becomes "invalid" they will be removed.
	# scope:
	#	root: the ruler who would use this puppet
	#	scope:puppet: the character acting as puppet
	#
	is_valid = { scope:puppet = { piety > major_piety_value } }

	# priority: integer script value used to sort puppet entries in the intrigue window.
	# root scope: the ruler opening the window.
	#
	priority = { ... }

	# The actions this puppet will be able to take, see _puppet_actions.info
	# Make sure every action is only used by one puppet
	actions = {
		puppet_action_key_1
		puppet_action_key_2
	}

	# asset: triggered set of gfx asset for UI visualisation. You must provide a default entry without trigger as fallback.
	# 	first asset that satisfies the trigger is used for display.
	asset = {
		# which condition should be satisfied in order for these assets to be used
		# scopes:
		#	root: the puppeteer
		#	scope:puppet: the puppet
		trigger = {}
		icon = "icon path"
		background = "background path"
	}

	# animation: triggered animation that will be used for UI visualisation. You must provide a default entry without trigger as fallback.
	#	first reference that satisfies the trigger is used for display.
	animation = {
		# scopes:
		#	root: the puppeteer
		#	scope:puppet: the puppet
		trigger = {}
		reference = "obsequious_bow"
	}

	# color: color used for UI visualisation of this puppet type (GetColor in GUI)
	#
	color = { 0.5 0.5 0.5 1 }
}

# Localization: puppet_type_key = name, puppet_type_key_desc = description
