	type widget_rite_icon = widget {
		size = { 80 80 }

		tooltipwidget = {
			rite_tooltip = {}
		}

		icon = {
			using = Visible_Rite_Not_Heresy
			size = { 100% 100% }
			texture = "[Rite.GetIcon]"

			glow = {
				color = { 0 0 0 0.3 }
				glow_radius = 4
			}
		}

		icon = {
			using = Visible_Rite_Heresy
			size = { 100% 100% }
			texture = "[Rite.GetIcon]"

			glow = {
				color = { 0.25 0 0 0.6 }
				glow_radius = 8

				glow_generation_rules= {
					glow_alpha_mask = 0
					glow_blur_passes = 10
					glow_texture_downscale = 5.5f
					glow_ignore_inside_pixels = yes
				}
			}
		}
	}
}

template Glow_Tenet_Animation {
	state = {
		name = "glow_animation_a"
		next = "glow_animation_b"
		trigger_on_create = yes
		alpha = 0.8
		using = Animation_Curve_Default
		duration = 2
	}

	state = {
		name = "glow_animation_b"
		next = "glow_animation_a"
		alpha = 0.5
		using = Animation_Curve_Default
		duration = 2
	}
}

types FaithMessageTypes
{
	type container_message_doctrine = container {
		datacontext = "[GetPlayer]"
		datacontext = "[Character.GetFaith]"
		datacontext = "[Character.GetRite]"

		tooltip = "FAITH_WINDOW_DOCTRINE_TOOLTIP_WITH_FAITH"
		using = tooltip_se

		icon = {
			name = "doctrine_banner_background"
			datacontext = "[DoctrineType.GetGroup]"
			datacontext = "[DoctrineGroupType.GetCategory]"

			size = { 66 88 }
			texture = "gfx/interface/icons/faith_doctrines/doctrine_banner.dds"

			icon_doctrine = {
				name = "doctrine_icon_main"
				visible = "[DoctrineCategoryType.HasTag( 'main' )]"
				parentanchor = center
				position = { 0 -3 }
				size = { 50 50 }
				texture = "[DoctrineType.GetIcon]"
			}

			icon_doctrine = {
				name = "doctrine_icon_other"
				visible = "[And( Not( DoctrineCategoryType.HasTag( 'main' ) ), Not( DoctrineCategoryType.HasTag( 'special' ) ) )]"
				parentanchor = center
				position = { 0 -3 }
				size = { 50 50 }
				texture = "[DoctrineType.GetGroup.GetIcon]"
			}

			icon_doctrine = {
				name = "doctrine_icon_special"
				visible = "[DoctrineCategoryType.HasTag( 'special' )]"
				parentanchor = center
				position = { 0 -3 }
				size = { 50 50 }
				texture = "[DoctrineType.GetIcon]"
			}
		}
	}

	type container_message_faith = container {
		tooltipwidget = {
			faith_tooltip = {}
		}
		using = tooltip_se

		highlight_icon = {
			name = "icon"
			texture = "[Faith.GetIcon]"
			size = { 90 90 }
			alpha = 0.85
		}
	}

	type container_message_rite = container {
		tooltipwidget = {
			rite_tooltip = {}
		}

		using = tooltip_se

		highlight_icon = {
			name = "icon"
			texture = "[Rite.GetIcon]"
			size = { 90 90 }
			alpha = 0.85
		}
	}
}

template Visible_Rite_Heresy
{
	visible = "[GreaterThanOrEqualTo_CFixedPoint( CalcDivergenceScore( Rite.Self ), Rite.GetFaith.GetHeresyThreshold )]"
}

template Visible_Rite_Not_Heresy
{
	visible = "[LessThan_CFixedPoint( CalcDivergenceScore( Rite.Self ), Rite.GetFaith.GetHeresyThreshold )]"
}

template Visible_RiteItem_Heresy
{
	visible = "[GreaterThanOrEqualTo_CFixedPoint( RiteItem.GetDivergenceScore, RiteItem.GetHeresyThreshold )]"
}

template Visible_RiteItem_Not_Heresy
{
	visible = "[LessThan_CFixedPoint( RiteItem.GetDivergenceScore, RiteItem.GetHeresyThreshold )]"
}

template Tenet_Glows {
	icon = {
		name = "core_tenet_glow"
		block "core_tenet_glow" {
			visible = "[Rite.HasTenet( TenetType.Self )]"
		}
		size = { 100% 100% }
		texture = "gfx/interface/icons/faith_tenets/tenet_banner_glow.dds"
		color = { 0.45 0.5 0.55 1 }
		alpha = 0.5

		using = Glow_Tenet_Animation
	}

	icon = {
		name = "not_core_tenet_glow"
		block "not_core_tenet_glow" {
			visible = no
		}
		size = { 100% 100% }
		texture = "gfx/interface/icons/faith_tenets/tenet_banner_heretical_glow.dds"
		color = { 0.85 0.75 0.45 0.6 }
		alpha = 0.2

		using = Glow_Tenet_Animation
	}

	icon = {
		name = "prohibited_tenet_glow"
		visible = "[Faith.HasTenetStatus( TenetType.Self, 'prohibited' )]"
		size = { 100% 100% }
		texture = "gfx/interface/icons/faith_tenets/tenet_banner_heretical_glow.dds"
		color = { 0.85 0.5 0.3 1 }
		alpha = 0.5

		using = Glow_Tenet_Animation
	}
}

template Background_Challenger {
	background = {
		texture = "gfx/interface/component_masks/patterns/mask_pattern_06.dds"
		using = Color_Red
		spriteType = Corneredtiled
		alpha = 0.35
		block "bg_margins" {
			margin_top = 15
			margin_right = 5
			margin_bottom = -4
		}

		modify_texture = {
			block "bg_fade" {
				texture = "gfx/interface/component_masks/mask_fade_halfcircle.dds"
				mirror = vertical
			}
			blend_mode = alphamultiply
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_rough_edges.dds"
			spriteType = Corneredtiled
			spriteborder = { 20 20 }
			texture_density = 2
			blend_mode = alphamultiply
		}
	}
}

template Divergence_Marker {
	background = {
		texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
		spriteType = Corneredtiled
		spriteborder = { 40 8 }
		texture_density = 2

		margin_bottom = 2

		modify_texture = {
			name = "mask"
			texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
			spriteType = Corneredstretched
			spriteborder = { 0 0 }
			blend_mode = alphamultiply
		}
	}

	icon = {
		size = { 25 25 }
		texture = "gfx/interface/icons/icon_rite_divergence.dds"
	}
}
