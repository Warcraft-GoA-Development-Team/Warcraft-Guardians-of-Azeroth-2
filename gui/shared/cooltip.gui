		}

		blockoverride "subtitle_text" {
			text = "LAW_TOOLTIP_SUBTITLE"
		}

		blockoverride "concept_link" {
			text = [law|E]
		}

		blockoverride "extra_data" {
			cooltip_paragraph = {
				text = "[Law.GetEffectDescription]"
			}
		}
