					text_single = {
						autoresize = yes
						fontsize_min = 14
						using = Font_Size_Small

						align = right
						text = "[Epidemic.GetType.GetName]"
						default_format = "#weak"
						fonttintcolor = "[TooltipInfo.GetTintColor]"
						max_width = 200
