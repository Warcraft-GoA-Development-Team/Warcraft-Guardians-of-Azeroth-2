# Puppet actions are interactions or decisions that you can only take via puppet characters.
# Localize puppet_action_description_[puppet_action_key] to get a readable generic string for UI visualisation
# (used for type = character_interaction and type = trigger; decision and great_project actions use the decision title / great project name)
puppet_action_key = {
	# type: what kind of action is this. defaults to character_interaction
	# possible values:
	#  character_interaction
	#  decision
	#  great_project
	#  trigger (no linked interaction/decision/project; only is_enabled, which is required. Checked from script with is_puppet_action_valid)
	type = character_interaction

	# the key for the interaction enabled by  this action, if it is a character interaction
	interaction = some_interaction_key
   
	# the key for the decision enabled by this action, if it is a decision
	decision = some_decision_key

	# the key for the great project enabled by  this action, if it is a great project
	great_project = some_great_project_type_key

	# trigger for either enabling the interaction or decision, or additional conditions that this "action" represents
	# scope:
	#	root: the puppeteer
	#	scope:puppet: the puppet
	#
	is_enabled = { trigger }

	# bool. type = character_interaction only: yes lists the interaction among the highlighted (special) interactions
	# of its category in the intrigue window puppet entry, no among the generic ones. default is no
	#
	is_important = no

	# For type = decision puppet actions:
	#	The decision executes with ROOT = the puppet (not the puppeteer).
	#	scope:puppeteer is available in the decision scope (triggers, effects, cost)
	#	to reference the ruler who commanded the action.
}
