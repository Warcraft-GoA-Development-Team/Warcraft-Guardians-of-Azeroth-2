######################################################
################### FAITH WINDOW #####################
######################################################
@rite_button_width = 340
@rite_button_height = 40
@faith_action_margin = 10

window = {
	name = "faith_window"
	widgetid = "faith_window"
	datacontext = "[FaithWindow.GetReligionSubWindow]"
	datacontext = "[FaithWindow.GetRiteSubWindow]"
	datacontext = "[FaithWindow.GetTenetSubWindow]"
	datacontext = "[FaithWindow.GetChallengersWindow]"
	datacontext = "[FaithWindow.GetFaith]"
	datacontext = "[FaithWindow.GetSelectedRite]"
	datacontext = "[GetVariableSystem]"

	allow_outside = yes
	movable = no
	layer = middle

	using = Window_Size_Sidebar
	using = Window_Background_Sidebar

	state = {
		name = default_tab
		trigger_on_create = yes
		on_start = "[FaithWindow.SetActiveTab( 'tab_beliefs' )]"
	}

	state = {
		name = _show
		position = { 0 0 }
		on_start = "[GetVariableSystem.Set( 'hide_bottom_left_HUD', 'true' )]"

		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		position = { -60 0 }
		on_start = "[GetVariableSystem.Clear( 'hide_bottom_left_HUD' )]"

		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	### Top Section (Above Tabs)
	vbox = {
		datacontext = "[FaithWindow.GetSelectedRite]"

		using = Window_Margins_Sidebar

		hbox = {
			layoutpolicy_horizontal = expanding
			margin_left = 5
			spacing = 5

			background = {
				using = Background_Header
				margin_top = 5
				margin_left = 5
				margin_right = 5
				margin_bottom = 10
			}

			background = {
				using = Background_Header_Pattern
				margin_top = 5
				margin_left = 5
				margin_right = 5
				margin_bottom = 10
			}

			background = {
				using = Background_Area_Dark
				margin_top = -80
				margin_left = 0
				margin_right = 4
				margin_bottom = 10
				alpha = 0.7

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_textured_vertical_up.dds"
					blend_mode = alphamultiply
				}
			}

			widget_rite_and_banner = {}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin_top = 4

				### Header (Rite)
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 5

					background = {
						using = Visible_Rite_Heresy
						using = Status_Bad
						alpha = 0.2

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_corner.dds"
							mirror = horizontal
							blend_mode = alphamultiply
						}
					}

					### Rite Name
					vbox = {
						layoutpolicy_horizontal = expanding

						text_single = {
							layoutpolicy_horizontal = expanding

							state = {
								name = "faith_view_refresh"
								using = Animation_Refresh_FadeOut
							}

							state = {
								using = Animation_Refresh_FadeIn
							}

							text = "[Rite.GetNameNoTooltip]"
							align = nobaseline
							using = Font_Size_Big
							using = Font_Type_Flavor

							tooltipwidget = {
								rite_tooltip = {}
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							margin_left = 1

							text_single = {
								using = Visible_Rite_Not_Heresy
								max_width = 180
								text = "FAITH_VIEW_RITE_STATUS"
								align = nobaseline
							}

							hbox = {
								using = Visible_Rite_Heresy
								spacing = 8

								icon = {
									size = { 20 20 }
									alwaystransparent = yes
									texture = "gfx/interface/icons/symbols/icon_warning.dds"

									datacontext = "[FaithWindow.GetDivergenceBreakdown( FaithWindow.GetSelectedRite.Self )]"

									tooltipwidget = {
										widget_rite_divergence_tooltip = {}
									}
								}

								text_single = {
									max_width = 150
									text = "FAITH_VIEW_RITE_HERESY"
									align = nobaseline
								}
							}

							hbox = {
								visible = "[IsPlayerRite]"
								spacing = 8

								divider_light = {
									layoutpolicy_vertical = expanding
								}

								text_single = {
									max_width = 120
									text = "RITE_COOLTIP_YOUR_RITE"
									align = nobaseline
								}
							}

							expand = {}
						}
					}

					vbox = {
						layoutpolicy_vertical = expanding
						spacing = 4

						hbox = {
							layoutpolicy_horizontal = expanding
							margin_top = 4

							expand = {}

							buttons_window_control = {
								margin = { 8 0 }

								blockoverride "button_close"
								{
									onclick = "[FaithWindow.Close]"
								}

								blockoverride "button_back"
								{
									visible = "[HasViewHistory]"
									onclick = "[OpenFromViewHistory]"
									tooltip = "[GetViewHistoryTooltip]"
								}

								blockoverride "button_me"
								{
									onclick = "[DefaultOnCharacterClick(GetPlayer.GetID)]"
								}
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							expand = {}

							widget = {
								visible = "[Not( FaithWindow.IsActiveTab( 'tab_beliefs' ) )]"
								size = { 0 36 }
							}

							button_standard_hover = {
								visible = "[FaithWindow.IsActiveTab( 'tab_beliefs' )]"
								minimumsize = { -1 20 }
								onclick = "[GetVariableSystem.Toggle( 'compact_faith_window' )]"
								down = "[GetVariableSystem.Exists( 'compact_faith_window' )]"
								shortcut = "compact_faith_window"

								tooltip = "FAITH_VIEW_EXPAND_DOCTRINES_TT"
								using = tooltip_es

								flowcontainer = {
									resizeparent = yes
									margin = { 3 3 }
									margin_left = 7

									text_single = {
										max_width = 150
										text = "FAITH_VIEW_EXPAND_DOCTRINES"
										parentanchor = vcenter

										align = nobaseline
										default_format = "#clickable"
									}

									button_menu = {
										alwaystransparent = yes
									}
								}
							}
						}
					}
				}

				divider_light = {
					layoutpolicy_horizontal = expanding

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
						blend_mode = alphamultiply
					}
				}

				### Sub-Header (Faith)
				hbox = {
					layoutpolicy_horizontal = expanding
					margin_top = 4
					margin_right = 4
					spacing = 25

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						widget = {
							size = { 40 40 }

							### Faith Icon
							button = {
								parentanchor = center
								size = { 40 40 }

								onclick = "[FaithWindow.SetSelectedRite( Faith.GetMainRite.Self )]"
								onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"

								texture = "[Faith.GetIcon]"

								glow = {
									color = { 0 0 0 0.2 }
									glow_radius = 3
								}

								tooltipwidget = {
									faith_tooltip = {}
								}
							}
						}

						hbox = {
							spacing = 5

							icon = {
								visible = "[Not( Faith.IsUnreformed )]"
								size = { 30 30 }
								texture = "gfx/interface/icons/icon_organized_faith.dds"

								text_single = {
									size = { 100% 100% }
									autoresize = no
									alpha = 0
									text = "[organized|E]"
								}
							}

							icon = {
								visible = "[Faith.IsUnreformed]"
								size = { 30 30 }
								texture = "gfx/interface/icons/icon_unreformed_faith.dds"

								text_single = {
									size = { 100% 100% }
									autoresize = no
									alpha = 0
									text = "[GetDoctrineType('unreformed_faith_doctrine').GetBaseName]"
								}
							}
						}

						### Faith Name
						text_single = {
							layoutpolicy_horizontal = expanding
							text = "FAITH_VIEW_PART_OF_FAITH"
							align = nobaseline
							autoresize = no
						}

						expand = {}

						### Fervor
						hbox = {
							tooltip = "FERVOR_TT"
							spacing = 4
							margin_bottom = 4

							icon = {
								texture = "gfx/interface/icons/icon_fervor.dds"
								size = { 22 22 }
							}

							text_single = {
								text = "FAITH_WINDOW_FERVOR_SHORT"
								default_format = "#high"
								max_width = 60
								margin_bottom = 1
							}

							container = {
								icon = {
									position = { 0 5 }
									size = { 22 22 }

									icon = {
										visible = "[GreaterThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)0' )]"
										size = { 100% 100% }

										texture = "gfx/interface/icons/aptitude_icons.dds"
										framesize = { 26 26 }
										frame = "[Select_int32( GreaterThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)1'), '(int32)5', '(int32)4' )]"
										using = Color_Green
									}

									icon = {
										visible = "[LessThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)0' )]"
										size = { 100% 100% }

										texture = "gfx/interface/icons/aptitude_icons.dds"
										framesize = { 26 26 }
										frame = "[Select_int32( LessThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)-1'), '(int32)1', '(int32)2' )]"
										using = Color_Red
									}
								}
							}
						}
					}

					### Other Rites
					button_sidepanel_right = {
						onclick = "[TenetWindow.Toggle]"
						onclick = "[ReligionWindow.Close]"
						onclick = "[RiteWindow.Close]"
						down = "[TenetWindow.IsVisible]"
						shortcut = faith_details

						tooltip = "FAITH_VIEW_FAITH_DETAILS_TT"
						using = tooltip_nw

						blockoverride "button_text"
						{
							text = "FAITH_VIEW_FAITH_DETAILS"
							max_width = 200
						}
					}
				}

				expand = {}
			}
		}

		### Tabs
		hbox = {
			name = "tabs"
			layoutpolicy_horizontal = expanding

			button_tab = {
				shortcut = "tab_1"
				onclick = "[FaithWindow.SetActiveTab( 'tab_beliefs' )]"
				down = "[FaithWindow.IsActiveTab( 'tab_beliefs' )]"

				alwaystransparent = "[FaithWindow.IsActiveTab( 'tab_beliefs' )]"

				blockoverride "tab_label"
				{
					text = "FAITH_BELIEFS"
					max_width = 140
				}

				blockoverride "icon_visible" {}

				blockoverride "tab_icon"
				{
					texture = "gfx/interface/icons/flat_icons/faith.dds"
					down = "[FaithWindow.IsActiveTab( 'tab_beliefs' )]"
				}
			}

			button_tab = {
				shortcut = "tab_2"
				onclick = "[FaithWindow.SetActiveTab( 'tab_holy_orders' )]"
				down = "[FaithWindow.IsActiveTab( 'tab_holy_orders' )]"

				alwaystransparent = "[FaithWindow.IsActiveTab( 'tab_holy_orders' )]"

				blockoverride "tab_label"
				{
					text = "FAITH_HOLY_ORDERS"
					max_width = 140
				}

				blockoverride "icon_visible" {}

				blockoverride "tab_icon"
				{
					texture = "gfx/interface/icons/flat_icons/holy_order.dds"
					down = "[FaithWindow.IsActiveTab( 'tab_holy_orders' )]"
				}
			}

			button_tab = {
				shortcut = "tab_3"
				onclick = "[FaithWindow.SetActiveTab( 'tab_holy_sites' )]"
				down = "[FaithWindow.IsActiveTab( 'tab_holy_sites' )]"

				alwaystransparent = "[FaithWindow.IsActiveTab( 'tab_holy_sites' )]"

				blockoverride "tab_label"
				{
					text = "FAITH_HOLY_SITES"
					max_width = 140
				}

				blockoverride "icon_visible" {}

				blockoverride "tab_icon"
				{
					texture = "gfx/interface/icons/flat_icons/holy_site.dds"
					down = "[FaithWindow.IsActiveTab( 'tab_holy_sites' )]"
				}
			}
		}

		## BELIEFS
		vbox = {
			name = "tab_beliefs"
			visible = "[FaithWindow.IsActiveTab( 'tab_beliefs' )]"
			visible_at_creation = no
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			state = {
				name = _show
				using = Animation_FadeIn_Quick
				on_start = "[SetMapMode( 'religions' )]"
			}

			state = {
				name = _hide
				alpha = 0
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				datacontext = "[GetIllustration( 'religion_interior' )]"

				### Top Area Background Texture
				background = {
					texture = "[Illustration.GetTexture( FaithWindow.GetFaith.MakeScope )]"
					fittype = centercrop
					alpha = 0.8
					using = Mask_Rough_Edges

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						alpha = 0.7
					}
				}

				### Divergence and opinion
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 10 }
					margin_bottom = 10

					background = {
						margin = { 10 0 }
						margin_top = 5
						using = Background_Area_Light
						alpha = 0.9
						using = Mask_Rough_Edges
					}

					widget = {
						layoutpolicy_horizontal = expanding
						size = { 0 60 }

						background = {
							using = Visible_Rite_Heresy
							margin_bottom = 14
							margin_left = 15

							using = Status_Bad
							alpha = 0.35

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_corner.dds"
								mirror = horizontal
								blend_mode = alphamultiply
							}
						}

						hbox = {
							layoutpolicy_vertical = expanding
							spacing = 5

							### Divergence
							vbox = {
								visible = "[Not( Rite.IsMain )]"
								margin = { 4 0 }
								spacing = 2

								tooltipwidget = {
									widget_rite_divergence_tooltip = {
										datacontext = "[FaithWindow.GetDivergenceBreakdown( FaithWindow.GetSelectedRite.Self )]"
									}
								}
								using = tooltip_se

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 5

									icon = {
										size = { 22 22 }
										texture = "gfx/interface/icons/icon_rite_divergence.dds"
									}

									text_single = {
										max_width = 150
										text = "FAITH_VIEW_DIVERGENCE_LABEL"
										align = nobaseline
									}

									text_single = {
										using = Visible_Rite_Not_Heresy
										text = "FAITH_VIEW_DIVERGENCE_VALUE"
										using = Font_Size_Medium
										default_format = "#high"
										align = nobaseline
									}

									text_single = {
										using = Visible_Rite_Heresy
										text = "FAITH_VIEW_DIVERGENCE_VALUE"
										using = Font_Size_Medium
										default_format = "#n"
										align = nobaseline
									}

									expand = {}
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 0 6 }

									spacing = 5

									vbox = {
										visible = no
										margin_bottom = 10

										button_rite_icon = {
											datacontext = "[Faith.GetMainRite]"
											size = { 30 30 }
										}
									}

									widget = {
										size = { 200 14 }

										progressbar_red = {
											size = { 100% 100% }
											max = "[GetDefine( 'NRite', 'RITE_CREATION_DIVERGENCE_FAITH_THRESHOLD' )]"
											value = "[CalcDivergenceScore( Rite.Self )]"
										}

										progressbar = {
											size = { 100% 100% }

											value = "[Rite.GetFaith.GetHeresyThreshold]"
											max = "[GetDefine( 'NRite', 'RITE_CREATION_DIVERGENCE_FAITH_THRESHOLD' )]"

											marker = {
												widget = {
													size = { 10 100% }

													icon = {
														parentanchor = vcenter
														size = { 4 150% }
														texture = "gfx/interface/window_factions/faction_progress_threshold.dds"
													}
												}
											}
										}
									}

									expand = {}
								}
							}

							expand = {}
						}

						# Main Rite
						hbox = {
							visible = "[Rite.IsMain]"
							layoutpolicy_horizontal = expanding
							spacing = 4

							button_challengers = {}

							vbox = {
								layoutpolicy_horizontal = expanding
								expand = {}

								margin_left = 6
								spacing = 4

								text_single = {
									visible = "[GreaterThan_int32( GetDataModelSize( Faith.GetRites ), '(int32)1' )]"
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "FAITH_VIEW_NUMBER_OF_RITES"
									align = nobaseline
								}

								text_single = {
									visible = "[EqualTo_int32( GetDataModelSize( Faith.GetRites ), '(int32)1' )]"
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "FAITH_VIEW_NO_OTHER_RITES"
									default_format = "#low"
									align = nobaseline
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									visible = no

									### Doctrine No Head
									text_single = {
										datacontext = "[GetDoctrine( 'doctrine_no_head' )]"
										visible = "[Faith.HasDoctrineByKey( 'doctrine_no_head' )]"
										layoutpolicy_horizontal = expanding
										text = "[DoctrineType.GetDescriptiveName( Faith.Self )]"
										align = nobaseline
									}

									### Doctrine Spiritual Head
									text_single = {
										datacontext = "[GetDoctrine( 'doctrine_spiritual_head' )]"
										visible = "[Faith.HasDoctrineByKey( 'doctrine_spiritual_head' )]"
										layoutpolicy_horizontal = expanding
										text = "[DoctrineType.GetDescriptiveName( Faith.Self )]"
										align = nobaseline
									}

									### Doctrine Temporal Head
									text_single = {
										datacontext = "[GetDoctrine( 'doctrine_temporal_head' )]"
										visible = "[Faith.HasDoctrineByKey( 'doctrine_temporal_head' )]"
										layoutpolicy_horizontal = expanding
										text = "[DoctrineType.GetDescriptiveName( Faith.Self )]"
										align = nobaseline
									}
								}

								text_single = {
									visible = "[DataModelHasItems( Faith.GetChallengers )]"
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "FAITH_VIEW_NUMBER_OF_CHALLENGERS"
									align = nobaseline
								}

								expand = {}
							}


							expand = {}
						}
					}

					container = {
						ignoreinvisible = yes

						### Head of Faith Doctrine
						flowcontainer = {
							ignoreinvisible = yes
							datamodel = "[FaithWindow.GetDoctrineCategoryItems]"

							item = {
								flowcontainer = {
									ignoreinvisible = yes
									datamodel = "[DoctrineCategoryItem.GetDoctrineGroupItems]"

									item = {
										icon_main_doctrine = {
											datacontext = "[DoctrineGroupItem.GetSelectedDoctrineItem]"
											datacontext = "[DoctrineItem.GetDoctrine]"
											visible = "[DoctrineGroupItem.GetGroupType.IsOnlyForMainRite]"

											divider_light = {
												size = { 20 4 }
												position = { -20 30 }
											}
											divider_light = {
												size = { 20 4 }
												position = { 48 30 }
											}

											blockoverride "main_doctrine_banner_background" {}

											blockoverride "main_doctrine_divergence" {
												container_doctrine_divergence = {
													parentanchor = top|right
													position = { 8 -4 }
												}
											}
										}
									}
								}
							}
						}
					}

					widget = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						# Rite Hostility
						vbox = {
							visible = "[And3( Not( ObjectsEqual( GetPlayer.GetFaith, Faith.Self ) ), GetPlayer.IsValid, Rite.IsVisibleInGui )]"
							spacing = 4

							expand = {}

							hbox = {
								layoutpolicy_horizontal = expanding
								expand = {}

								text_single = {
									max_width = 220

									text = "RITE_VIEW_OUR_VIEW"
									align = right|nobaseline
									elide = left
									default_format = "#low"
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								expand = {}

								text_single = {
									max_width = 220

									text = "RITE_VIEW_THEIR_VIEW"
									align = right|nobaseline
									elide = left
									default_format = "#low"
								}
							}

							expand = {}
						}

						# Your faith
						hbox = {
							datacontext = "[GetPlayer]"
							visible = "[ObjectsEqual( GetPlayer.GetFaith, Faith.Self )]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 10

							background = {
								visible = "[LessThan_CFixedPoint( GetPlayer.GetSpiritualFulfillment, '(CFixedPoint)0' )]"
								margin_bottom = 12
								margin_right = 15

								using = Status_Bad
								alpha = 0.3

								modify_texture = {
									texture = "gfx/interface/component_masks/mask_fade_corner.dds"
									blend_mode = alphamultiply
								}
							}

							background = {
								visible = "[GreaterThan_CFixedPoint( GetPlayer.GetSpiritualFulfillment, '(CFixedPoint)0' )]"
								margin_top = 12
								margin_bottom = 12
								margin_right = 15

								using = Status_Good
								color = { 0.2 0.5 0.7 0.12 }

								modify_texture = {
									texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
									blend_mode = alphamultiply
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4

								expand = {}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "[spiritual_fulfillment|E]"
									align = right|nobaseline
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "[Character.GetSpiritualFulfillmentLevelWithTooltip]"
									align = right|nobaseline
								}

								expand = {}
							}

							button_personal_beliefs = {}
						}
					}
				}

				### Characters
				vbox = {
					layoutpolicy_horizontal = expanding

					widget = {
						layoutpolicy_horizontal = expanding
						size = "[Select_CVector2f( GetVariableSystem.Exists( 'compact_faith_window' ), '(CVector2f)0,140', '(CVector2f)0,185' )]" # when changing size, also adjust ANTIPOPE widget

						vbox = {
							layoutpolicy_horizontal = expanding

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								margin = { 15 5 }
								margin_right = 0
								spacing = 20

								# Head of faith or challenger
								hbox = {
									spacer = {
										visible = "[IsCompactFaith]"
										size = { 15 0 }
									}

									hbox = {
										spacing = 20
										# HoF
										hbox = {
											datacontext = "[Faith.GetReligiousHead]"
											# always shown in main rite and in others if there aren't challengers
											visible = "[Or( Rite.IsMain, EqualTo_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild('items').CountVisibleChildren, '(int32)0') )]"

											# overwriting the same things for each widget
											blockoverride "text" {
												text = "[head_of_faith|E]"
											}
											blockoverride "head_of_faith" {
												widget_empty_head_of_faith_button = {
													visible = "[Not( Character.IsValid )]"
													parentanchor = center
													size = { 100% 100% }
												}
											}
											blockoverride "interactions_extra" {
												### College of Cardinals
												button_round = {
													visible = "[And4( Character.IsValid, ObjectsEqual( GetPlayer.GetFaith.Self, Faith.Self ), Faith.HasParameterByKey( 'has_clerical_electors' ), Faith.GetCollegeElectionTitle.HasElectionType( 'theocratic_elective' ) )]"
													size = { 40 40 }

													onclick = "[ToggleGameView( 'cardinals_window' )]"
													tooltip = "FAITH_VIEW_COLLEGE_OF_CARDINALS"
													using = tooltip_ne

													button_icon= {
														parentanchor = center
														size = { 24 24 }
														alwaystransparent = yes

														texture = "gfx/interface/icons/flat_icons/college_of_cardinals.dds"
													}

													glow = {
														color = { 0 0 0 0.5 }
														glow_radius = 8
													}
												}
											}

											widget_faith_character = {
												visible = "[Not( IsCompactFaith )]"
											}

											widget_faith_character_tiny = {
												visible = "[IsCompactFaith]"
											}
										}

										# Challenger
										hbox = {
											# show if there is a challenger of this rite
											visible = "[Or( GreaterThan_int32( PdxGuiWidget.AccessParent.AccessParent.FindChild('items').CountVisibleChildren, '(int32)0'), And( Rite.IsMain, DataModelHasItems( Faith.GetChallengers ) ) )]"


											# ANTIPOPE
											widget = {
												size = "[Select_CVector2f( GetVariableSystem.Exists( 'compact_faith_window' ), '(CVector2f)175,130', '(CVector2f)175,185' )]"

												widget = {
													size = { 180 100% }

													flowcontainer = {
														datamodel = "[Faith.GetChallengers]"

														ignoreinvisible = yes
														wrap_basedon = parent
														scissor =  yes
														overflowed_items_visibility = hide
														allow_outside = yes

														item = {
															container = {
																visible = "[Or( ObjectsEqual( Character.GetRite.Self, Rite.Self ), Rite.IsMain )]"
																datacontext = "[Challenger.GetChallengerTitle.GetHolder]"
																ignoreinvisible = yes

																blockoverride "text" {
																	text = "FAITH_VIEW_CHALLENGER_TITLE"
																}

																blockoverride "interactions_extra" {
																	container = {
																		visible = "[Not( Rite.IsMain )]"
																		button_challengers = {}
																	}
																}

																widget_faith_character = {
																	visible = "[Not( IsCompactFaith )]"
																	using = Background_Challenger
																}

																widget_faith_character_tiny = {
																	visible = "[IsCompactFaith]"
																	using = Background_Challenger
																	blockoverride "bg_fade" {
																		texture = "gfx/interface/component_masks/mask_fade_corner.dds"
																		mirror = horizontal
																	}
																}
															}
														}
													}
												}
											}
										}
									}

									# are there antipopes of this rite?
									hbox = {
										name = "items"
										datamodel = "[Faith.GetChallengers]"

										item = {
											hbox = {
												datacontext = "[Challenger.GetChallengerTitle.GetHolder]"
												visible = "[ObjectsEqual( Character.GetRite.Self, Rite.Self )]"
											}
										}
									}
								}

								# Head of rite
								# don't show if they are a challenger, they'll likely be on the left
								hbox = {
									datacontext = "[Rite.GetHeadOfRite]"
									visible = "[And3( Not( IsHoF( Character ) ), Character.IsValid, Not( ObjectsEqual( Character.GetChallenger, Character.Self ) ) )]"
									minimumsize = { 170 -1 }

									blockoverride "text" {
										text = "[head_of_rite|E]"
									}

									blockoverride "interactions_extra" {
										### College of Cardinals
										button_round = {
											visible = "[And4( ObjectsEqual( Character.Self, Faith.GetCollegeElectionTitle.GetHolder.Self ), ObjectsEqual( GetPlayer.GetFaith.Self, Faith.Self ), Faith.HasParameterByKey( 'has_clerical_electors' ), Faith.GetCollegeElectionTitle.HasElectionType( 'theocratic_elective' ) )]"
											size = { 40 40 }

											onclick = "[ToggleGameView( 'cardinals_window' )]"
											tooltip = "FAITH_VIEW_COLLEGE_OF_CARDINALS"
											using = tooltip_ne

											button_icon = {
												parentanchor = center
												size = { 24 24 }
												alwaystransparent = yes

												texture = "gfx/interface/icons/flat_icons/college_of_cardinals.dds"
											}

											glow = {
												color = { 0 0 0 0.5 }
												glow_radius = 8
											}
										}
									}

									widget_faith_character = {
										visible = "[Not( IsCompactFaith )]"
									}

									widget_faith_character_tiny = {
										visible = "[IsCompactFaith]"
									}
								}

								# Archbishop
								hbox = {
									name = "archbishop"
									visible = "[And3( GetPlayer.GetCapitalLocation.IsValid, IsPlayerRite, GetPlayer.GetFaith.HasParameterByKey( 'has_clerical_regions' ) )]"

									hbox = {
										datacontext = "[GetPlayer.GetCapitalLocation.GetClericalRegionHolder]"

										# hide if they are in one of the other spots and if they are an antipope of this rite
										visible = "[And3( Character.IsValid, Nor4( IsHoF( Character ), IsHoR( Character ), Character.IsLocalPlayer, And( ObjectsEqual( Character.GetChallenger, Character.Self ), ObjectsEqual( Character.GetRite, Rite.Self ) ) ), ObjectsEqual( Character.GetFaith, GetPlayer.GetFaith ) )]"

										blockoverride "text" {
											text = "FAITH_VIEW_YOUR_ARCHBISHOP"
										}

										widget_faith_character = {
											visible = "[Not( IsCompactFaith )]"
										}

										widget_faith_character_tiny = {
											visible = "[IsCompactFaith]"
										}
									}
								}

								expand = {}
							}
						}

						divider = {
							visible = "[Not( GetVariableSystem.Exists( 'compact_faith_window' ) )]"
							parentanchor = bottom
							position = { 0 1 }
							size = { 100% 4 }
						}
					}
				}
			}

			spacer = {
				size = { 0 6 }
			}

			### Core Tenets
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 15 0 }
				margin_bottom = 15

				button_standard_hover = {
					layoutpolicy_horizontal = expanding

					onclick = "[TenetWindow.Toggle]"
					onclick = "[GetVariableSystem.Set( 'quick_access_tenets', 'yes' )]"

					tooltip = "FAITH_VIEW_SUB_WINDOW_TENETS_BUTTON_TT"

					button = {
						size = { 100% 100% }
						visible = "[TenetWindow.IsVisible]"
						onclick = "[GetVariableSystem.Set( 'quick_access_tenets', 'yes' )]"
					}

					text_label_center = {
						parentanchor = center
						size = { 100% 26 }
						autoresize = no
						text = "FAITH_CORE_TENETS_HEADING"
						alwaystransparent = yes
					}

					button_select_arrow = {
						parentanchor = right|vcenter
						position = { -5 0 }
						size = { 20 20 }
						alwaystransparent = yes
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding

					state = {
						name = "faith_view_refresh"
						using = Animation_Refresh_FadeOut
					}

					state = {
						using = Animation_Refresh_FadeIn
					}

					blockoverride "core_tenet_glow" {
						visible = "[Faith.GetMainRite.HasTenet( TenetType.Self )]"
					}
					blockoverride "not_core_tenet_glow" {
						visible = "[And( Not( Faith.GetMainRite.HasTenet( TenetType.Self ) ), Not( Faith.HasTenetStatus( TenetType.Self, 'prohibited' ) ) )]"
					}

					flowcontainer = {
						name = "doctrines_grid_core_tenets"
						visible = "[Not( GetVariableSystem.Exists( 'compact_faith_window' ) )]"
						margin_top = 10

						datamodel = "[FaithWindow.GetCoreTenetItems]"
						wrap_count = 3

						item = {
							flowcontainer = {
								margin = { 25 0 }
								widget_tenet_item = {
									datacontext = "[TenetItem.GetTenet]"
									datacontext = "[TenetItem.GetFaith]"
									datacontext = "[TenetItem.GetRite]"

									blockoverride "popularity" {}
									blockoverride "text_popularity" {
										visible = no
									}
									blockoverride "margin_popularity_bg" {}
									blockoverride "divergence_text" {}
								}
							}
						}

						background = {
							using = Background_Area
							margin = { 40 0 }
							margin_top = -40
							margin_bottom = -80

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
								blend_mode = alphamultiply
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
								blend_mode = alphamultiply
								mirror = horizontal
							}
						}
					}

					flowcontainer = {
						name = "doctrines_compact_grid_core_tenets"
						visible = "[GetVariableSystem.Exists( 'compact_faith_window' )]"
						margin_bottom = 8

						datamodel = "[FaithWindow.GetCoreTenetItems]"
						wrap_count = 3

						item = {
							flowcontainer = {
								widget_tenet_item_compact = {
									datacontext = "[TenetItem.GetTenet]"
									datacontext = "[TenetItem.GetFaith]"
									datacontext = "[TenetItem.GetRite]"
								}
							}
						}
					}
				}
			}

			### Sins & Virtues
			widget_sins_virtues = {}

			spacer = {
				size = { 0 4 }
			}

			### Doctrines
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_left = -5

						datamodel = "[FaithWindow.GetDoctrineCategoryItems]"
						item = {
							vbox_doctrine_category = {}
						}

						# Warcraft - special on top + magic under "crime"

						# Warcraft
						vbox = {
							visible = "[DataModelHasItems(FaithWindow.GetCategoryHelper( 'special' ).GetCategory)]"
							layoutpolicy_horizontal = expanding
							spacing = 7

							text_label_center = {
								layoutpolicy_horizontal = expanding
								text = "FAITH_DOCTRINES_SPECIAL"
								default_format = "#low"
							}

							hbox = {
								layoutpolicy_horizontal = expanding

								# Warcraft
								hbox = {
									name = "important_doctrines"
									datamodel = "[FaithWindow.GetCategoryHelper( 'special' ).GetCategory]"
									#spacing = 15
									layoutpolicy_vertical = expanding
									minimumsize = { 0 108 }

									item = {
										vbox = {
											layoutpolicy_vertical = expanding
											minimumsize = { 100 0 }
											name = "doctrine_list_item"
											datacontext = "[DoctrineItem.GetDoctrine]"
											visible = "[FaithDoctrine.IsVisible]"

											tooltip = "FAITH_WINDOW_DOCTRINE_TOOLTIP"
											using = tooltip_se

											icon_doctrine = {
												name = "doctrine_group_icon"
												size = { 60 60 }
												texture = "[FaithDoctrine.GetIcon]"
											}

											text_single = {
												name = "doctrine_name"
												align = center
												#raw_text = "Bingo Bongo Tongo gyngo"
												text = "[FaithDoctrine.GetNameNoTooltip( DoctrineItem.GetFaith )]"
												default_format = "#high"
												multiline = yes
												max_width = 101   ##### minimum in order to look good in german
											}
											expand = {}
										}
									}
								}
							}
						}

						# Warcraft: Custom magic doctrines section (WARCRAFT-SPECIFIC)
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 12
							margin_bottom = -10

							text_label_center = {
								layoutpolicy_horizontal = expanding
								text = "FAITH_WC_DOCTRINES_MAGIC"
								default_format = "#low"
							}

							fixedgridbox = {
								flipdirection = yes
								addcolumn = 225
								addrow = 67
								datamodel_wrap = 2

								datamodel = "[FaithWindow.GetCategoryHelper( 'wc_magic' ).GetCategory]"
								item = {
									widget_doctrine_item = {}
								}
							}
						}
						# Warcraft - End
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding

				spacer = {
					size = { 0 8 }
					visible = "[NotZero( PdxGuiWidget.AccessParent.FindChild( 'actions' ).CountVisibleChildren )]"
				}

				### Actions
				hbox = {
					name = "actions"
					visible = "[And( GetPlayer.IsValid, Rite.IsVisibleInGui )]"
					layoutpolicy_horizontal = expanding
					spacing = 10
					margin = { 15 0 }
					margin_top = -2

					button_standard = {
						name = "edit_rite"
						visible = "[FaithWindow.CanEditRite]"
						layoutpolicy_horizontal = expanding
						maximumsize = { @rite_button_width -1 }
						minimumsize = { 0 @rite_button_height }

						onclick = "[OpenGameViewData( 'rite_creation', FaithWindow.GetSelectedRite )]"

						text = "RITE_CREATION_VIEW_BUTTON_EDIT"
						tooltip = "RITE_CREATION_VIEW_BUTTON_EDIT_TT"
						using = tooltip_nw
					}

					button_standard = {
						name = "convert_rite"
						visible = "[FaithWindow.ConvertButtonIsShown]"

						layoutpolicy_horizontal = expanding
						maximumsize = { @rite_button_width -1 }
						minimumsize = { 0 @rite_button_height }

						onclick = "[OpenGameViewData( 'faith_conversion', FaithWindow.GetSelectedRite )]"

						text = "FAITH_CONVERSION_CONVERT"
						using = tooltip_nw
					}

					button_standard = {
						name = "find_adherent"
						visible = "[Faith.CanStartFindCharacterOfFaithScheme]"

						layoutpolicy_horizontal = expanding
						maximumsize = { @rite_button_width -1 }
						minimumsize = { 0 @rite_button_height }

						onclick = "[Faith.StartFindCharacterOfFaithScheme]"

						text = "faith_find_adherent"
						tooltip = "faith_find_adherent_tt"
						using = tooltip_nw
					}

					button_standard = {
						name = "create_rite"
						visible = "[And( FaithWindow.CanCreateRite, Not( Or( IsActionEnabledByPuppet('puppet_trigger_can_create_rite'), IsActionEnabledByPuppet('puppet_trigger_can_create_faith') ) ) )]"

						layoutpolicy_horizontal = expanding
						maximumsize = { @rite_button_width -1 }
						minimumsize = { 0 @rite_button_height }

						onclick = "[OpenGameViewData( 'rite_creation', FaithWindow.GetSelectedRite )]"

						text = "CREATE_REFORM_RITE_BUTTON"
						tooltip = "CREATE_REFORM_RITE_BUTTON_TT"
						using = tooltip_nw
					}

					button_standard_puppet = {
						name = "create_rite_puppet"
						visible = "[And( FaithWindow.CanCreateRite, Or( IsActionEnabledByPuppet('puppet_trigger_can_create_rite'), IsActionEnabledByPuppet('puppet_trigger_can_create_faith') ) )]"

						layoutpolicy_horizontal = expanding
						maximumsize = { @rite_button_width -1 }
						minimumsize = { 280 @rite_button_height }

						onclick = "[OpenGameViewData( 'rite_creation', FaithWindow.GetSelectedRite )]"

						text = "CREATE_REFORM_RITE_BUTTON"

						tooltip = "CREATE_REFORM_RITE_BUTTON_TT"
						using = tooltip_nw

						blockoverride "puppet_banner" {
							puppet_action_flag_widget = {
								parentanchor = right|vcenter
								widgetanchor = right|vcenter
								position = { -7 2 }
								scale = 0.7
							}
						}
					}
				}

				spacer = {
					size = { 0 15 }
					visible = "[NotZero( PdxGuiWidget.AccessParent.FindChild( 'actions' ).CountVisibleChildren )]"
				}
			}
		}

		## HOLY ORDERS
		vbox = {
			name = "tab_holy_orders"
			datacontext = "[GetIllustration( 'religion_holding' )]"
			visible = "[FaithWindow.IsActiveTab( 'tab_holy_orders' )]"
			visible_at_creation = no
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			state = {
				name = _show
				on_start = "[SetMapMode( 'holy_orders' )]"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_background" {}
				blockoverride "scrollbox_background_fade" {}

				state = {
					name = _show
					using = Animation_FadeIn_Quick
				}

				state = {
					name = _hide
					alpha = 0
				}

				background = {
					using = Background_Area
				}

				background = {
					alpha = 0.5
					fittype = end
					texture = "[Illustration.GetTexture( FaithWindow.GetFaith.MakeScope )]"

					using = Mask_Rough_Edges

					modify_texture = {
						mirror = vertical
						blend_mode = alphamultiply
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					}
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "holy_orders"
						datacontext = "[GetPlayer]"
						layoutpolicy_horizontal = expanding

						vbox_holy_order_group = {
							blockoverride "group_header" {
								text = "FAITH_MONASTIC_HOLY_ORDERS_HEADER"
							}
							blockoverride "holy_order_filter" {
								visible = "[Not( HiredTroopItem.GetHolyOrder.IsMilitary )]"
							}
						}

						vbox_holy_order_group = {
							blockoverride "group_header" {
								text = "FAITH_MILITARY_HOLY_ORDERS_HEADER"
							}
							blockoverride "holy_order_filter" {
								visible = "[HiredTroopItem.GetHolyOrder.IsMilitary]"
							}
						}
					}
				}
			}

			### Footer | Decision Shortcuts
			hbox = {
				margin = { 10 10 }
				layoutpolicy_horizontal = expanding
				spacing = 10

				button_decision_entry = {
					datacontext = "[GetDecisionWithKey( 'create_holy_order_monastic_decision' )]"
					visible = "[Decision.IsShownForPlayer]"

					layoutpolicy_horizontal = expanding
					size = { 1 @rite_button_height }
					max_width = @rite_button_width

					onclick = "[OpenGameViewData( 'decision_detail', Decision.Self)]"
					using = tooltip_ne
				}

				button_decision_entry = {
					datacontext = "[GetDecisionWithKey( 'create_holy_order_decision' )]"
					visible = "[Decision.IsShownForPlayer]"

					layoutpolicy_horizontal = expanding
					size = { 1 @rite_button_height }
					max_width = @rite_button_width

					onclick = "[OpenGameViewData( 'decision_detail', Decision.Self)]"
					using = tooltip_ne
				}
			}
		}

		## HOLY SITES
		vbox = {
			name = "tab_holy_sites"
			datacontext = "[GetIllustration( 'religion_holding' )]"
			visible = "[FaithWindow.IsActiveTab( 'tab_holy_sites' )]"
			visible_at_creation = no
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			state = {
				name = _show
				on_start = "[SetMapMode( 'religions' )]"
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				blockoverride "scrollbox_background" {}
				blockoverride "scrollbox_background_fade" {}

				state = {
					name = _show
					using = Animation_FadeIn_Quick
				}

				state = {
					name = _hide
					alpha = 0
				}

				background = {
					visible = "[Not( FaithWindow.HasAnyHolySites )]"
					alpha = 0.5
					fittype = end
					texture = "[Illustration.GetTexture( FaithWindow.GetFaith.MakeScope )]"

					modify_texture = {
						mirror = vertical
						blend_mode = alphamultiply
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					}
				}

				background = {
					using = Background_Area
				}

				blockoverride "scrollbox_content"
				{
					vbox = {
						name = "holy_sites"
						layoutpolicy_horizontal = expanding

						spacing = 5

						### Holy Sites controlled by the selected Rite
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							datacontext = "[FaithWindow.GetFaith]"
							datacontext = "[FaithWindow.GetSelectedRite]"

							text_label_center = {
								visible = "[Not( IsDataModelEmpty( FaithWindow.GetSelectedRiteHolySiteItems ) )]"
								text = "FAITH_RITE_HOLY_SITES_HEADER"
								using = Font_Size_Medium
							}

							text_single = {
								visible = "[IsDataModelEmpty( FaithWindow.GetSelectedRiteHolySiteItems )]"
								layoutpolicy_horizontal = expanding
								margin = { 0 5 }
								text = "FAITH_RITE_HOLY_SITES_NONE"
								default_format = "#weak"
								align = center
							}

							holy_site_list = {
								datamodel = "[FaithWindow.GetSelectedRiteHolySiteItems]"
							}
						}

						### Holy Sites controlled by other Rites of the same Faith
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							datacontext = "[FaithWindow.GetFaith]"
							visible = "[Not( IsDataModelEmpty( FaithWindow.GetOtherRiteHolySiteItems ) )]"

							oncreate = "[BindFoldOutContext]"
							oncreate = "[PdxGuiFoldOut.SetShownBehavior( 'unfolded' )]"

							button_expandable_toggle_field = {
								blockoverride "text"
								{
									text = "FAITH_OTHER_RITES_HOLY_SITES_HEADER"
									default_format = "#clickable"
								}
							}

							vbox = {
								visible = "[PdxGuiFoldOut.IsUnfolded]"
								layoutpolicy_horizontal = expanding
								spacing = 5

								holy_site_list = {
									datamodel = "[FaithWindow.GetOtherRiteHolySiteItems]"
								}
							}
						}

						### Holy Sites controlled by rulers outside the Faith
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							datacontext = "[FaithWindow.GetFaith]"
							visible = "[Not( IsDataModelEmpty( FaithWindow.GetOtherFaithHolySiteItems ) )]"

							oncreate = "[BindFoldOutContext]"
							oncreate = "[PdxGuiFoldOut.SetShownBehavior( 'unfolded' )]"

							button_expandable_toggle_field = {
								blockoverride "text"
								{
									text = "FAITH_OTHER_FAITHS_HOLY_SITES_HEADER"
									default_format = "#clickable"
								}
							}

							vbox = {
								visible = "[PdxGuiFoldOut.IsUnfolded]"
								layoutpolicy_horizontal = expanding
								spacing = 5

								holy_site_list = {
									datamodel = "[FaithWindow.GetOtherFaithHolySiteItems]"
								}
							}
						}
					}
				}
			}

			### Footer | Decision Shortcuts
			hbox = {
				margin = { 10 10 }
				layoutpolicy_horizontal = expanding
				visible = "[ObjectsEqual( FaithWindow.GetFaith.Self, GetPlayer.GetFaith.Self )]"

				button_standard = {
					datacontext = "[FaithWindow.GetFaith]"
					visible = "[ObjectsEqual( FaithWindow.GetFaith.Self, GetPlayer.GetFaith.Self )]"
					layoutpolicy_horizontal = expanding
					max_width = @rite_button_width
					size = { 0 @rite_button_height }

					text = "FAITH_CREATE_HOLY_SITE_BUTTON"

					onclick = "[OpenGameViewData( 'holy_site_creation', Faith.GetID )]"
				}
			}
		}
	}

	window_religion_sub_window = {
		visible = "[ReligionWindow.IsVisible]"
	}

	window_rite_sub_window = {
		visible = "[RiteWindow.IsVisible]"
	}

	window_tenet_sub_window = {
		visible = "[TenetWindow.IsVisible]"
	}

	window_challengers_sub_window = {
		visible = "[ChallengersWindow.IsVisible]"
	}
}

######################################################
################ TYPES AND TEMPLATES #################
######################################################

template head_of_faith_widget_background {
	background = {
		using = Background_Area_Solid

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
			blend_mode = alphamultiply
			alpha = 0.2
			mirror = vertical
		}
	}

	background = {
		texture = "gfx/portraits/portrait_frame.dds"
		using = Color_Grey
		margin = { -4 -4 }
		alpha = 0.4
	}
}

types FaithWindow
{
	type widget_rite_and_banner = widget{
		size = { 94 125 }

		icon = {
			parentanchor = top|hcenter
			position = { 0 -5 }
			size = { 94 132 }
			texture = "gfx/interface/window_faith/faith_window_header_bg.dds"
		}

		widget_rite_icon = {
			parentanchor = center
			position = { 0 -7 }
		}
	}

	type vbox_holy_order_group = vbox {
		layoutpolicy_horizontal = expanding

		text_label_center = {
			visible = "[NotZero( PdxGuiWidget.AccessParent.FindChild( 'holy_orders_list' ).CountVisibleChildren )]"
			margin = { 0 5 }

			block "group_header" {}

			using = Font_Size_Medium
		}

		flowcontainer = {
			name = "holy_orders_list"
			allow_outside = yes
			direction = vertical
			spacing = 3
			ignoreinvisible = yes
			layoutpolicy_horizontal = expanding

			datamodel = "[FaithWindow.GetHolyOrders]"

			item = {
				button_holyorder_list_item = {
					size = { 545 92 }

					block "holy_order_filter" {}

					blockoverride "holyorder_button_size" {
						size = { 420 78 }
					}
					blockoverride "divergence_datacontext"
					{
						datacontext = "[FaithWindow.GetDivergenceBreakdown( HolyOrder.GetRite.Self )]"
					}
					blockoverride "rite_click" {
						onclick = "[FaithWindow.SetActiveTab( 'tab_beliefs' )]"
					}
				}
			}
		}
	}

	type holy_site_list_item = vbox {
		name = "faith_list_item"
		datacontext = "[HolySiteItem.GetHolySite]"
		datacontext = "[HolySite.GetBarony]"
		datacontext = "[Title.GetProvince.GetHolding]"

		layoutpolicy_horizontal = expanding

		# header
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 0 5 }
			spacing = 5

			background = {
				using = Background_Area_Light
			}

			background = {
				visible = "[And( HolySiteItem.IsEminent, And( HolySiteItem.GetHolySite.IsActive, HolySiteItem.IsHeldByFaith ) )]"
				texture = "gfx/interface/window_military/military_banner_blue.dds"
				margin_bottom = 8
				alpha = 0.8
			}

			background = {
				visible = "[And( HolySiteItem.IsEminent, Not( HolySiteItem.IsHeldByFaith ) )]"
				texture = "gfx/interface/window_military/military_banner_red.dds"
				margin_bottom = 8
				alpha = 0.8
			}

			background = {
				visible = "[And( HolySiteItem.IsEminent, And( Not( HolySiteItem.GetHolySite.IsActive ), HolySiteItem.IsHeldByFaith ) )]"
				texture = "gfx/interface/window_military/military_banner_gray.dds"
				margin_bottom = 8
			}

			background = {
				visible = "[And( Not( HolySiteItem.IsEminent ), Not( HolySiteItem.IsHeldByFaith ) )]"
				using = Status_Bad
				alpha = 0.35

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
					blend_mode = alphamultiply
				}
			}

			background = {
				visible = "[And( Not( HolySiteItem.IsEminent ), And( Not( HolySiteItem.GetHolySite.IsActive ), HolySiteItem.IsHeldByFaith ) )]"
				using = Status_Highlight
				alpha = 0.3

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
					blend_mode = alphamultiply
				}
			}


			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 10 }
				spacing = 5

				datacontext = "[HolySite.GetType]"

				hbox = {
					layoutpolicy_horizontal = expanding
					margin_left = 8

					hbox = {
						layoutpolicy_horizontal = expanding
						tooltip = "HOLY_SITE_TYPE_TOOLTIP"
						datacontext = "[HolySiteItem.GetFaith]"

						spacing = 12

						coa_title_small = {
							tooltip_visible = no
						}

						vbox = {
							spacing = 0

							text_single = {
								layoutpolicy_horizontal = expanding
								name = "name"
								text = "FAITH_VIEW_SITE_NAME"
								align = nobaseline
								using = Font_Size_Medium
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								name = "holy_site_tier"
								text = "FAITH_HOLY_SITE_TIER"
								default_format = "#low"
								align = nobaseline
								using = Font_Size_Small
							}
						}

						button_go_to_my_location = {
							onclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
							onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
							onrightclick = "[ToggleGameViewData( 'holding_view', Holding.GetProvince.Self )]"
							button_ignore = none
							tooltip = "GOTO_OPEN_PROVINCE"
						}

						expand = {}

					}
				}

				expand = {}

				widget = {
					size = { 200 60 }

					hbox = {
						layoutpolicy_horizontal = expanding

						hbox = {
							datamodel = "[RepeatedItem( '(int32)3' )]"
							spacing = 12
							margin_right = 4

							item = {
								widget = {
									size = { 55 55 }
									background = { using = Background_Area_Border }
									background = {
										using = Background_Area_Border_Solid
										margin = { -6 -6 }
									}
								}
							}
						}

						expand = {}
					}


					hbox = {
						layoutpolicy_horizontal = expanding

						hbox = {
							datamodel = "[HolySite.GetInventory.GetArtifacts]"
							spacing = 12
							margin_right = 4

							item = {
								button_artifact = {
									size = { 55 55 }
								}
							}
						}

						expand = {}
					}
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			datacontext = "[Title.GetProvince.GetHolding]"

			background = {
				visible = "[Not( Holding.IsEmpty )]"
				texture = "[Holding.GetIllustration]"
				alpha = 0.8
				margin_left = -300

				fittype = centercrop

				modify_texture = {
					texture = "gfx/interface/window_county/mask_holding_illustration.dds"
					blend_mode = alphamultiply
					alpha = 0.6
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
					blend_mode = alphamultiply
				}
			}

			background = {
				visible = "[Holding.IsEmpty]"
				texture = "[Holding.GetProvince.GetTerrain.GetIllustration]"
				alpha = 0.7
				margin_left = -300

				fittype = centercrop

				modify_texture = {
					texture = "gfx/interface/window_county/mask_holding_illustration.dds"
					blend_mode = alphamultiply
					alpha = 0.8
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
					blend_mode = alphamultiply
				}
			}

			background = {
				using = Background_Area
				margin = { 3 3 }
			}

			# faith
			hbox = {
				layoutpolicy_horizontal = expanding

				margin = { 14 6 }
				spacing = 10

				background = {
					using = Background_Area_Dark
					alpha = 0.5

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
						blend_mode = alphamultiply
						mirror = horizontal
						alpha = 0.5
					}
				}

				hbox = {
					datacontext = "[HolySite.GetCounty.GetHolder]"
					visible = "[HolySite.GetCounty.HasHolder]"
					spacing = 1

					button_rite_icon = {
						datacontext = "[HolySite.GetController.GetRite]"
						size = { 50 50 }

						onclick = "[FaithWindow.SetSelectedRite( Rite.Self )]"
						onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"
					}

					widget = {
						size = { 30 30 }

						coa_realm_tiny_crown = {
							parentanchor = center
							position = { 0 -3 }
							scale = 0.95
						}
					}
				}

				spacer = {}

				hbox = {
					layoutpolicy_horizontal = expanding
					datacontext = "[HolySite.GetController.GetRite]"

					text_multi = {
						name = "held_by"
						visible = "[HolySiteItem.IsHeldByFaith]"
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 200
						max_height = 50

						text = "HOLY_SITE_UNDER_CONTROL_UI"
						align = nobaseline
					}

					text_multi = {
						name = "not_held_by"
						visible = "[Not( HolySiteItem.IsHeldByFaith )]"
						layoutpolicy_horizontal = expanding
						autoresize = yes
						max_width = 200
						max_height = 50

						text = "HOLY_SITE_NOT_UNDER_CONTROL_UI"
						align = nobaseline
						default_format = "#x"
					}
				}

				expand = {}

				button_standard = {
					size = { 205 33 }
					onclick = "[ToggleGameViewData( 'holy_site', HolySite.Self )]"
					text = "OPEN_HOLY_SITE_WINDOW"
				}
			}

			# all effects
			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 16 10 }
				datacontext = "[HolySiteItem.GetHolySite]"

				vbox = {
					layoutpolicy_vertical = expanding

					state = {
						name = "faith_view_refresh"
						using = Animation_Refresh_FadeOut
					}

					state = {
						using = Animation_Refresh_FadeIn
					}

					# uses Faith datacontext of the window (except for holder effects)
					vbox_holy_site_effects = {
						spacing = 5
						blockoverride "active_effects_format" {
							align = nobaseline
							default_format = "#emp;bold"
						}

						blockoverride "inactive_effects_format" {
							align = nobaseline
							default_format = "#emp;bold;low"
						}
						# hides a standalone line about a wrong faith, we already have it above
						blockoverride "show_wrong_faith" {
							visible = no
						}

						expand = {}
					}
				}

				expand = {}
			}

		}
	}

	type holy_site_list = vbox {
		layoutpolicy_horizontal = expanding
		margin = { 0 5 }
		spacing = 10

		item = {
			holy_site_list_item = {}
		}
	}

	type widget_sins_virtues = widget {
		size = { 592 94 }
		layoutpolicy_horizontal = expanding

		background = {
			using = Background_Area
		}

		state = {
			name = "faith_view_refresh"
			using = Animation_Refresh_FadeOut
		}

		state = {
			using = Animation_Refresh_FadeIn
		}

		### Banner
		widget = {
			size = { 100% 39 }
			layoutpolicy_horizontal = expanding

			icon = {
				parentanchor = center
				size = { 100% 100% }
				texture = "gfx/interface/window_faith/sin_virtue_banner.dds"
			}

			icon = {
				parentanchor = left|vcenter
				position = { 15 0 }
				size = { 60 60 }
				texture = "gfx/interface/window_faith/sin_icon_background.dds"

				icon = {
					parentanchor = center
					size = { 40 40 }

					texture = "gfx/interface/icons/traits/sin.dds"
					alwaystransparent = yes
				}
			}

			text_single = {
				parentanchor = left|vcenter
				position = { 80 -1 }
				text = "FAITH_WINDOW_SINS"
				using = Font_Size_Medium
				align = nobaseline
			}

			text_single = {
				parentanchor = right|vcenter
				position = { -80 -1 }
				text = "FAITH_WINDOW_VIRTUES"
				using = Font_Size_Medium
				align = nobaseline|left
			}

			icon = {
				parentanchor = right|vcenter
				position = { -15 0 }
				size = { 60 60 }
				texture = "gfx/interface/window_faith/virtue_icon_background.dds"

				icon = {
					parentanchor = center
					size = { 40 40 }

					texture = "gfx/interface/icons/traits/virtue.dds"
					alwaystransparent = yes
				}
			}
		}

		### Sins & Virtues | Traits
		hbox = {
			name = "sins_and_virtues"
			margin_top = 40
			margin_bottom = 5
			spacing = 5

			expand = {}

			widget = {
				size = { 285 45 }

				hbox = {
					expand = {}

					### Sinful Traits
					overlappingitembox = {
						name = "sins"
						maximumsize = { 285 45 }
						minimumsize = { 0 45 }
						autoresize = yes
						ignoreinvisible = yes
						righttoleft = yes

						block "datamodel_sins"
						{
							datamodel = "[FaithWindow.GetSins]"
						}
						item = {
							icon = {
								datacontext = "[VirtueOrSinItem.GetTrait]"
								size = { 45 45 }
								alwaystransparent = yes
								texture = "[Trait.GetIcon( GetPlayer )]"

								tooltipwidget = {
									using = faith_window_trait_tooltip
								}

								block "tooltip_placement"
								{
									using = tooltip_ne
									tooltip_offset = { 0 20 }
								}
							}
						}
					}
				}

			}

			divider_light = {
				size = { 4 45 }
			}

			widget = {
				size = { 285 45 }

				hbox = {
					### Virtous Traits
					overlappingitembox = {
						name = "virtues"
						maximumsize = { 285 45 }
						minimumsize = { 0 45 }
						autoresize = yes
						ignoreinvisible = yes

						block "datamodel_virtues"
						{
							datamodel = "[FaithWindow.GetVirtues]"
						}
						item = {
							icon = {
								datacontext = "[VirtueOrSinItem.GetTrait]"
								size = { 45 45 }
								alwaystransparent = yes
								texture = "[Trait.GetIcon( GetPlayer )]"

								tooltipwidget = {
									using = faith_window_trait_tooltip
								}

								block "tooltip_placement"
								{
									using = tooltip_ne
									tooltip_offset = { 0 20 }
								}
							}
						}
					}

					expand = {}
				}
			}

			expand = {}
		}
	}

	type widget_tenet_item = widget {
		size = { 130 200 }
		allow_outside = yes

		block "tenet_enabled" {
			enabled = "[Not( Faith.HasTenetStatus( TenetType.Self, 'unknown' ) )]"
		}

		tooltipwidget = {
			using = tenet_type_tooltip
		}
		using = tooltip_es

		using = Tenet_Glows

		highlight_icon = {
			name = "doctrine_group_bg"
			size = { 130 200 }
			texture = "[Faith.GetTenetBackgroundIcon( Rite.Self, TenetType.Self )]"
		}

		block "tenet_icon"
		{
			widget = {
				position = { 0 -10 }
				size = { 130 200 }
				allow_outside = yes
				alwaystransparent = yes
				visible = "[TenetType.IsValid]"

				highlight_icon = {
					name = "doctrine_group_icon"
					widgetanchor = center
					parentanchor = center

					size = { 130 200 }
					texture = "[TenetItem.GetIcon]"
					alpha = 0.85
				}
			}
		}

		block "tenet_add_icon"
		{
			button_plus = {
				name = "doctrine_group_icon"
				visible = "[Not( TenetType.IsValid )]"

				position = { 35 70 }
				size = { 60 60 }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			margin_bottom = 15

			expand = {}

			text_label_center = {
				name = "tenet_name"
				layoutpolicy_horizontal = expanding
				maximumsize = { 130 44 }
				visible = "[TenetType.IsValid]"
				fontsize_min = 12
				multiline = yes
				align = center
				elide = right
				block "tenet_name" {
					text = "[TenetType.GetNameNoTooltip( Rite.Self )]"
				}
				default_format = "#high"

				using = Font_Size_Medium
			}
		}

		block "prohibited_warning" {}

		widget = {
			parentanchor = top|right

			block "tenet_badges_layout"
			{
				size = { 25 50 }
			}

			vbox = {
				container_tenet_divergence = {}
				container_tenet_popularity = {}
				expand = {}
			}
		}

		block "divergence_text" {
			icon = {
				visible = "[And( TenetType.IsValid, Not( Faith.GetMainRite.HasTenet( TenetType.Self ) ) )]"
				parentanchor = bottom|hcenter
				position = { 0 5 }
				size = { 25 25 }

				icon = {
					parentanchor = center
					size = { 20 20 }

					texture = "gfx/interface/icons/icon_rite_divergence.dds"
					tooltip = "RITE_CREATION_TENET_DIVERGENCE_TT"
				}
			}
		}
	}

	type widget_tenet_creation_item = widget_tenet_item {
		datacontext = "[TenetItem.GetTenet]"
		datacontext = "[TenetItem.GetFaith]"
		datacontext = "[TenetItem.GetRite]"

		blockoverride "tenet_enabled" {}

		blockoverride "divergent_tenet" {
			visible = no
		}

		blockoverride "divergence_change" {
			hbox = {
				layoutpolicy_horizontal = expanding
				margin_left = 20
				margin_bottom = 5
				visible = "[TenetType.IsValid]"

				text_label_left = {
					text = "RITE_CREATION_TENET_DIVERGENCE_TT"
				}

				expand = {}
			}
		}

		blockoverride "input_info_text_bottom"
		{
			visible = "[TenetType.IsValid]"
			text = "RITE_CREATION_VIEW_TENET_CLICK_TO_SELECT"
			tooltip = "[RiteCreationWindow.GetTenetCostTooltip( TenetType.Self )]"
		}

		blockoverride "divergence_text"
		{
			text_label_center = {
				parentanchor = bottom|hcenter
				layoutpolicy_horizontal = expanding
				visible = "[TenetType.IsValid]"
				position = { 0 7 }
				text = "RITE_CREATION_TENET_DIVERGENCE"
				tooltip = "RITE_CREATION_TENET_DIVERGENCE_TT"
			}
		}
	}


	type widget_tenet_item_compact = widget {
		size = { 185 82 }
		enabled = "[Not( Faith.HasTenetStatus( TenetType.Self, 'unknown' ) )]"

		tooltipwidget = {
			using = tenet_type_tooltip
		}
		using = tooltip_es

		flowcontainer = {
			visible = "[TenetType.IsValid]"
			parentanchor = vcenter
			position = { 65 -1 }
			margin_left = 10

			background = {
				using = Background_Area_Dark

				modify_texture = {
					name = "mask"
					texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
				}
			}

			text_multi = {
				name = "doctrine_name"
				size = { 110 64 }
				margin_right = 5
				margin_bottom = 2
				margin_left = 6

				block "tenet_name" {
					text = "[TenetType.GetNameNoTooltip( Rite.Self )]"
				}
				default_format = "#high"
				align = vcenter|nobaseline
			}
		}

		block "tenet_glow"
		{
			icon = {
				visible = "[Rite.GetFaith.GetMainRite.HasTenet( TenetType.Self )]"
				texture = "gfx/interface/icons/faith_tenets/tenet_banner_glow_small.dds"
				size = { 84 92 }
				parentanchor = left
				position = { -6 -3 }
				color = { 0.85 0.75 0.45 0.3 }
				alpha = 0.2

				using = Glow_Tenet_Animation
			}

			icon = {
				visible = "[Not( Rite.GetFaith.GetMainRite.HasTenet( TenetType.Self ) )]"
				texture = "gfx/interface/icons/faith_tenets/tenet_banner_glow_small.dds"
				size = { 84 92 }
				parentanchor = left
				position = { -6 -3 }
				color = { 0.85 0.75 0.45 1 }
				alpha = 0.4

				using = Glow_Tenet_Animation
			}
		}

		### Banner
		highlight_icon = {
			size = { 72 88 }
			parentanchor = vcenter
			texture = "[Faith.GetTenetBackgroundSmallIcon( Rite.Self, TenetType.Self )]"

			### Sprite
			proportional_icon = {
				size = { 95% 95% }
				parentanchor = top|hcenter

				texture = "[TenetItem.GetIcon]"
				alpha = 0.85
			}

			widget = {
				size = { 25 50 }
				parentanchor = top|right
				position = { 6 -2 }

				vbox = {
					container_tenet_divergence = {}
					container_tenet_popularity = {
						blockoverride "text_popularity" {
							visible = no
						}
						blockoverride "margin_popularity_bg" {}
					}
					expand = {}
				}
			}
		}
	}

	type container_tenet_popularity = container {
		block "popularity_visibility"
		{
			visible = "[Not( Faith.HasTenetStatus( TenetType.Self, 'unknown' ) )]"
		}

		ignoreinvisible = yes
		block "popularity" {}

		flowcontainer = {
			datacontext = "[GetScriptedGui( 'using_tenet_popularity_gui' )]"
			visible = "[And( TenetType.IsValid, IsUsingTenetPopularity( Faith ) )]"
			ignoreinvisible = yes
			tooltip = "FAITH_TENET_ITEM_POPULARITY_TT"

			background = {
				texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
				spriteType = Corneredtiled
				spriteborder = { 40 8 }
				texture_density = 2

				block "margin_popularity_bg" {
					margin = { 10 0 }
				}
				margin_bottom = 2

				modify_texture = {
					name = "mask"
					texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = alphamultiply
				}
			}
			icon_tenet_popularity = {
				name = "tenet_popularity_value_very_popular"
				datacontext = "[GetScriptedGui( 'tenet_popularity_gui_very_popular' )]"
				frame = 4
			}

			icon_tenet_popularity = {
				name = "tenet_popularity_value_popular"
				datacontext = "[GetScriptedGui( 'tenet_popularity_gui_popular' )]"
				frame = 3
			}

			icon_tenet_popularity = {
				name = "tenet_popularity_value_neutral"
				datacontext = "[GetScriptedGui( 'tenet_popularity_gui_neutral' )]"
				frame = 2
			}

			icon_tenet_popularity = {
				name = "tenet_popularity_value_unpopular"
				datacontext = "[GetScriptedGui( 'tenet_popularity_gui_unpopular' )]"
				frame = 1
			}

			text_single = {
				text = "[Faith.GetTenetPopularityScore( TenetType.Self )]"
				min_width = 30
				block "text_popularity" {}
			}
		}

		block "tenet_divergence" {}
	}

