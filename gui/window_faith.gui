	type vbox_expanded_doctrine_category = vbox {
		datacontext = "[DoctrineCategoryItem.GetCategoryType]"
		visible = "[DoctrineCategoryType.IsVisible]"
		layoutpolicy_horizontal = expanding

		oncreate = "[BindFoldOutContext]"
		oncreate = "[PdxGuiFoldOut.Unfold]"

		button_expandable_toggle_field = {
			blockoverride "text"
			{
				text = "FAITH_VIEW_DOCTRINE_CATEGORY_TITLE"
				default_format = "#T"
			}
		}

		### Doctrine Groups with their selected Doctrine
		vbox = {
			visible = "[PdxGuiFoldOut.IsUnfolded]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin_left = 10

			datamodel = "[DoctrineCategoryItem.GetDoctrineGroupItems]"
			item = {
				vbox_expanded_doctrine_group = {}
			}
		}
	}

	type vbox_doctrine_category = vbox {
		datacontext = "[DoctrineCategoryItem.GetCategoryType]"
		visible = "[DoctrineCategoryType.IsVisible]"
		layoutpolicy_horizontal = expanding
		margin_bottom = 5

		### Main Group - Style
		vbox = {
			visible = "[DoctrineCategoryType.HasTag( 'main' )]"
			layoutpolicy_horizontal = expanding

			button_standard_hover = {
				layoutpolicy_horizontal = expanding

				onclick = "[TenetWindow.Toggle]"
				onclick = "[GetVariableSystem.Set( 'quick_access_doctrines', 'yes' )]"

				tooltip = "FAITH_VIEW_SUB_WINDOW_DOCTRINES_BUTTON_TT"

				button = {
					size = { 100% 100% }
					visible = "[TenetWindow.IsVisible]"
					onclick = "[GetVariableSystem.Set( 'quick_access_doctrines', 'yes' )]"
				}

				text_label_center = {
					parentanchor = center
					size = { 100% 26 }
					autoresize = no
					text = "FAITH_VIEW_DOCTRINE_CATEGORY_TITLE"
					alwaystransparent = yes
				}

				button_select_arrow = {
					parentanchor = right|vcenter
					position = { -5 0 }
					size = { 20 20 }
					alwaystransparent = yes
				}
			}

			### Doctrine Groups with their selected Doctrine
			flowcontainer = {
				ignoreinvisible = yes
				spacing = 5
				margin_top = 2

				datamodel = "[DoctrineCategoryItem.GetDoctrineGroupItems]"
				wrap_length = 560

				item = {
					widget_main_doctrine_item = {
						datacontext = "[DoctrineGroupItem.GetSelectedDoctrineItem]"
						datacontext = "[DoctrineItem.GetDoctrine]"
						datacontext = "[DoctrineItem.GetFaith]"

						visible = "[Nor3( ObjectsEqual( DoctrineType.Self, GetDoctrine( 'doctrine_spiritual_head' ).Self ), ObjectsEqual( DoctrineType.Self, GetDoctrine( 'doctrine_temporal_head' ).Self ), ObjectsEqual( DoctrineType.Self, GetDoctrine( 'doctrine_no_head' ).Self ) )]"

						margin = { 4 0 }

						blockoverride "doctrine_divergence_glow" {
							icon_divergent_doctrine_glow = {}
						}

						blockoverride "doctrine_divergence_icon" {
							container_doctrine_divergence = {
								parentanchor = top|right
								position = { 8 -4 }
							}
						}
					}
				}
			}
		}

		### Default - Style
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[Not( DoctrineCategoryType.HasTag( 'main' ) )]"

			### Doctrine Category Title
			text_label_center = {
				layoutpolicy_horizontal = expanding

				text = "FAITH_VIEW_DOCTRINE_CATEGORY_TITLE"
			}

			### Doctrine Groups with their selected Doctrine
			fixedgridbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				addrow = 50
				addcolumn = 275

				datamodel_wrap = 2
				flipdirection = yes

				datamodel = "[DoctrineCategoryItem.GetDoctrineGroupItems]"
				item = {
					widget_doctrine_group_item = {}
				}
			}
		}
	}

	type window_religion_sub_window = window {
		name = "religion_window"
		datacontext = "[ReligionWindow.GetReligion]"
		size = { 590 80% }
		position = { 620 75 }

		layer = middle
		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "RELIGION_WINDOW_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[ReligionWindow.Close]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 15 0 }
				margin_bottom = 5
				spacing = 5

				hbox = {
					spacing = 5

					text_single = {
						text = "SORT_BY"
						align = nobaseline
					}

					dropdown_sort_characterlist = {
						datamodel = "[ReligionWindow.GetOrderByOptions]"
						onselectionchanged = "[ReligionWindow.OnOrderBySelectionChanged]"
						selectedindex = "[ReligionWindow.GetOrderBySelectedIndex]"

						blockoverride "text_button_drop" {
							text = "[OrderFaithOption.GetName]"
						}
					}

					button_standard = {
						name = "sort_order"
						size = { 25 25 }
						onclick = "[ReligionWindow.RevertSortOrder]"

						tooltip = "FAITH_SORT_ORDER"
						using = tooltip_nw

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 25 25 }
							texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
							framesize = { 66 66 }

							frame = "[BoolTo1And2(ReligionWindow.GetSortOrder)]"

							blockoverride "button_frames"
							{
								effectname = "NoHighlight"
							}
						}
					}
				}

				expand = {}

				### Only Selected religion faiths
				hbox = {
					layoutpolicy_horizontal = expanding
					max_width = 550
					spacing = 5

					expand = {}

					button_checkbox_label = {
						onclick = "[ReligionWindow.OnShowOnlyReligionFaiths]"

						blockoverride "text"
						{
							text = "RELIGION_SHOW_ONLY"
							max_width = 180
						}
						blockoverride "checkbox"
						{
							checked = "[ReligionWindow.ShowOnlyReligionFaiths]"
						}
					}

					tooltip = "[ReligionWindow.GetShowOnlyReligionFaithsTooltip]"
					using = tooltip_ne
				}
			}

			scrollbox = {
				name = "faiths_scroll_area"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						datamodel = "[ReligionWindow.GetFaiths]"
						layoutpolicy_horizontal = expanding

						item = {
							button_standard_hover = {
								# Warcraft
								visible = "[Not(EqualTo_string(Faith.GetNameNoTooltip, 'Error'))]"
								# End Warcraft
								name = "show_faith_info"
								size = { 0 80 }
								layoutpolicy_horizontal = expanding

								state = {
									name = _mouse_click
									on_finish = "[OpenGameViewData( 'faith', Faith.Self )]"
								}

								background = {
									visible = "[Faith.IsSelected]"
									using = Background_Area
								}

								onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"
								tooltipwidget = { faith_tooltip_click = {} }
								using = tooltip_es

								divider_light = {
									alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"
									size = { 100% 3 }
									parentanchor = bottom
									position = { 0 1 }
								}

								hbox = {
									margin = { 10 5 }
									alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"

									icon = {
										name = "faith_icon"
										texture = "[Faith.GetIcon]"
										size = { 60 60 }
									}

									vbox = {
										margin_left = 10
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding

										hbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding

											text_single = {
												name = "faith_name"

												text = "FAITH_COOLTIP_GETNAME"
												align = left|nobaseline
												using = Font_Size_Medium
												default_format = "#high"
												max_width = 240
											}

											expand = {}

											text_single = {
												name = "religion_faith_name"
												margin_right = 5

												text = "FAITH_RELIGION"
												min_width = 160
												align = right|nobaseline
											}
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding

											icon = {
												texture = "gfx/interface/icons/icon_fervor.dds"
												size = { 22 22 }
											}

											text_single = {
												name = "fervor"

												text = "FAITH_WINDOW_FERVOR"
												using = Font_Size_Small
												align = left|nobaseline
											}

											expand = {}
										}

										text_single = {
											name = "counties"
											layoutpolicy_horizontal = expanding

											text = "FAITH_WINDOW_COUNTIES"
											align = left|nobaseline
											default_format = "#low"
											autoresize = no
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type widget_challenger_item = widget {
		datacontext = "[CharacterListItem.GetCharacter]"
		size = { 580 110 }

		divider = {
			parentanchor = bottom|hcenter
			size = { 100% 3 }
		}

		hbox = {
			spacing = 10

			portrait_head_small = {}

			button_standard = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				onclick = "[CharacterListItem.OnClick('character')]"
				enabled = "[CharacterListItem.IsSelectable]"
				tooltip = "[CharacterListItem.GetUnselectableReason]"

				framesize = { 252 80 }
				spriteType = Corneredtiled
				spriteborder = { 10 30 }

				block "button_texture"
				{
					texture = "gfx/interface/buttons/button_entry_characterlist.dds"
				}

				character_list_arrow = {
					name = "character_list_arrow"
				}

				using = default_character_list_overlay

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					margin = { 12 6 }

					# Name and age
					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							alwaystransparent = yes

							text = "[Character.GetUINameNoTooltip|U]"
							using = Font_Size_Medium
							align = nobaseline
						}

						expand = {}

						vbox = {
							using = character_age_or_death_text
						}
					}

					# Title, relation, rite
					vbox = {
						layoutpolicy_horizontal = expanding

						datacontext = "[ChallengersWindow.GetChallengerItemForCharacter( Character.Self )]"

						spacing = 6

						text_single = {
							name = "character_relation"
							visible = "[Character.HasRelationTo( GetPlayer )]"
							layoutpolicy_horizontal = expanding
							autoresize = no

							text = "[Character.GetRelationToString( GetPlayer )]"
							tooltip = "EXTENDED_RELATIONS_TOOLTIP"
							default_format = "#low"
							align = nobaseline
							alwaystransparent = yes
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6

							coa_realm_tiny = {
								datacontext = "[Challenger.GetChallengerTitle]"
							}

							hbox = {
								datacontext = "[Character.GetRite]"
								layoutpolicy_horizontal = expanding
								spacing = 5

								button_rite_icon = {
									size = { 35 35 }
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "[Rite.GetName]"
									align = nobaseline
								}
							}

							expand = {}

							text_single = {
								visible = "[ObjectsEqual( Challenger.GetChallengerTitle, Challenger.GetSponsorTitle )]"
								layoutpolicy_horizontal = expanding
								autoresize = no
								margin_right = 5

								text = "CHALLENGER_SELF_SPONSORED"
								default_format = "#weak"
								align = nobaseline|right
							}

							hbox = {
								visible = "[Not( ObjectsEqual( Challenger.GetChallengerTitle, Challenger.GetSponsorTitle ) )]"
								layoutpolicy_horizontal = expanding
								spacing = 10

								text_single = {
									datacontext = "[Challenger.GetChallengerTitle]"
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "CHALLENGER_TITLE_SPONSORSHIP"
									align = nobaseline|right
								}

								coa_realm_tiny = {
									datacontext = "[Challenger.GetSponsorTitle]"
								}
							}

							button_interactions_religion = {}
						}
					}
				}
			}
		}
	}

	type widget_challenger_item_big = widget {
		size = { 290 340 }

		background = {
			using = Background_Area
		}

		vbox = {
			datacontext = "[CharacterListItem.GetCharacter]"
			datacontext = "[ChallengersWindow.GetChallengerItemForCharacter( Character.Self )]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 12 8 }
				spacing = 14

				background = {
					using = Background_Area_Dark
				}

				widget = {
					size = { 30 30 }

					coa_realm_tiny = {
						parentanchor = center
						position = { 0 3 }
						datacontext = "[Challenger.GetChallengerTitle]"
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					ignoreinvisible = no

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[Character.GetTitledFirstNameNoTooltip]"
						align = nobaseline
						default_format = "#high"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[Character.GetPrimaryTitle.GetNameNoTooltip]"
						align = nobaseline
					}
				}

				expand = {}

				vbox = {
					using = character_age_or_death_text
					blockoverride "list_layout" {}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				datacontext = "[GetIllustration( 'character_view_bg' )]"
				margin_top = 16

				spacing = -4

				portrait_torso = {
					layoutpolicy_horizontal = expanding

					background = {
						texture = "[Illustration.GetTexture( Character.MakeScope )]"
						fittype = centercrop
						using = Mask_Rough_Edges
						alpha = 0.4

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					allow_outside = yes

					blockoverride "portrait_mask"
					{
						mask = "gfx/portraits/portrait_mask_council.dds"
					}

					blockoverride "portrait_texture"
					{
						portrait_texture = "[Character.GetAnimatedPortraitEvenIfDead('environment_torso', 'camera_torso', 'idle', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
					}

					blockoverride "coa" {}
					blockoverride "dead_icon" {}
					blockoverride "grayscale" {}

					blockoverride "opinion_box"
					{
						portrait_opinion = {
							parentanchor = bottom|hcenter
							position = { 0 -8 }
						}
					}

					widget = {
						parentanchor = right
						size = { 60 100% }
						alwaystransparent = no

						button_interactions_religion = {
							parentanchor = right
							position = { -15 0 }

							glow = {
								color = { 0 0 0 0.3 }
								glow_radius = 4
							}
						}
					}
				}

				widget = {
					layoutpolicy_horizontal = expanding
					size = { 0 64 }

					hbox = {
						datacontext = "[Character.GetRite]"
						layoutpolicy_horizontal = expanding
						margin = { 12 8 }
						spacing = 8

						background = {
							using = Background_Area_Dark
						}

						button_rite_icon = {
							size = { 40 40 }
						}

						text_single = {
							visible = "[ObjectsEqual( Challenger.GetChallengerTitle, Challenger.GetSponsorTitle )]"
							layoutpolicy_horizontal = expanding
							autoresize = no

							text = "[Rite.GetName]"
							align = nobaseline
						}

						text_single = {
							visible = "[ObjectsEqual( Challenger.GetChallengerTitle, Challenger.GetSponsorTitle )]"
							max_width = 100

							text = "CHALLENGER_SELF_SPONSORED"
							align = nobaseline|right
							default_format = "#weak"
						}

						hbox = {
							visible = "[Not( ObjectsEqual( Challenger.GetChallengerTitle, Challenger.GetSponsorTitle ) )]"
							layoutpolicy_horizontal = expanding
							spacing = 14
							datacontext = "[Challenger.GetSponsorTitle]"

							widget = {
								size = { 30 30 }

								coa_realm_tiny = {
									datacontext = "[Title.GetHolder]"
									parentanchor = center
									position = { 0 3 }
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "CHALLENGER_TITLE_SPONSORSHIP"
									align = nobaseline
									default_format = "#high"
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no
									text = "[Title.GetNameNoTooltip]"
									align = nobaseline
								}
							}
						}
					}
				}
			}
		}
	}

	type window_challengers_sub_window = window {
		name = "challengers_subwindow"
		size = { 640 80% }
		position = { 620 75 }

		layer = middle
		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			position_x = 620
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			position_x = 580
		}

		vbox = {
			margin = { 4 4 }

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "challengers_window_title"
				}

				blockoverride "button_close"
				{
					onclick = "[ChallengersWindow.Close]"
				}
			}

			vbox_character_list = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				datacontext = "[ChallengersWindow.GetChallengersList]"

				blockoverride "filters_visible"
				{
					visible = no
				}
				blockoverride "sort_buttons" {}
				blockoverride "skill_sort_buttons" {}

				blockoverride "container_implementation"
				{
					vbox = {
						layoutpolicy_horizontal = expanding
						visible = "[Not(CharacterSelectionList.IsBuildingList)]"

						fixedgridbox = {
							visible = "[GreaterThan_int32( GetDataModelSize( CharacterSelectionList.GetList ), '(int32)4' )]"
							addcolumn = 580
							addrow = 118
							datamodel_reuse_widgets = yes

							datamodel = "[CharacterSelectionList.GetList]"
							item = {
								widget_challenger_item = {}
							}
						}

						fixedgridbox = {
							layoutpolicy_horizontal = expanding
							visible = "[LessThan_int32( GetDataModelSize( CharacterSelectionList.GetList ), '(int32)5' )]"
							addcolumn = 300
							addrow = 350
							flipdirection = yes
							datamodel_wrap = 2
							datamodel_reuse_widgets = yes

							datamodel = "[CharacterSelectionList.GetList]"
							item = {
								widget_challenger_item_big = {}
							}
						}
					}
				}
			}
		}
	}

	type window_rite_sub_window = window {
		name = "rite_window"
		datacontext = "[RiteWindow.GetReligion]"
		size = { 590 80% }
		position = { 620 75 }

		layer = middle
		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "FAITH_VIEW_OTHER_RITES_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[RiteWindow.Close]"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 15 0 }
				margin_bottom = 5
				spacing = 5

				hbox = {
					spacing = 5

					text_single = {
						text = "SORT_BY"
						align = nobaseline
					}

					dropdown_sort_characterlist = {
						datamodel = "[RiteWindow.GetOrderByOptions]"
						onselectionchanged = "[RiteWindow.OnOrderBySelectionChanged]"
						selectedindex = "[RiteWindow.GetOrderBySelectedIndex]"

						blockoverride "text_button_drop" {
							text = "[OrderRiteOption.GetName]"
						}
					}

					button_standard = {
						name = "sort_order"
						size = { 25 25 }
						onclick = "[RiteWindow.RevertSortOrder]"

						tooltip = "RITE_SORT_ORDER"
						using = tooltip_nw

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 25 25 }
							texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
							framesize = { 66 66 }

							frame = "[BoolTo1And2(RiteWindow.GetSortOrder)]"

							blockoverride "button_frames"
							{
								effectname = "NoHighlight"
							}
						}
					}
				}

				expand = {}

				### Only Selected faith rites
				hbox = {
					layoutpolicy_horizontal = expanding
					max_width = 550
					spacing = 5

					expand = {}

					button_checkbox_label = {
						onclick = "[RiteWindow.OnShowOnlyReligionFaiths]"

						blockoverride "text"
						{
							text = "FAITH_VIEW_RITE_SHOW_ONLY_SAME_RELIGION"
							max_width = 180
						}
						blockoverride "checkbox"
						{
							checked = "[RiteWindow.ShowOnlyReligionFaiths]"
						}
					}

					tooltip = "[RiteWindow.GetShowOnlyReligionFaithsTooltip]"
					using = tooltip_ne
				}
			}

			scrollbox = {
				name = "rites_scroll_area"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						layoutpolicy_horizontal = expanding

						datamodel = "[RiteWindow.GetFaiths]"

						item = {
							vbox = {
								layoutpolicy_horizontal = expanding
								datacontext = "[FaithItem.GetFaith]"
								visible = "[Faith.IsVisibleInGui]"

								oncreate = "[BindFoldOutContext]"

								button_expandable_toggle_field_content = {
									size = { 550 80 }
									blockoverride "foldout_button"
									{
										hbox = {
											margin = { 20 0 }
											layoutpolicy_horizontal = expanding
											spacing = 5

											icon = {
												size = { 60 60 }
												texture = "[Faith.GetIcon]"
											}

											vbox = {
												layoutpolicy_horizontal = expanding

												text_single = {
													layoutpolicy_horizontal = expanding
													text = "[Faith.GetNameNoTooltip]"
													default_format = "#T"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													text = "FAITH_WINDOW_FERVOR"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													text = "FAITH_WINDOW_COUNTIES"
												}
											}
										}
									}
								}

								### Doctrine Groups with their selected Doctrine
								vbox = {
									visible = "[PdxGuiFoldOut.IsUnfolded]"
									layoutpolicy_horizontal = expanding

									datamodel = "[FaithItem.GetRites]"

									item = {
										button_standard_hover = {
											name = "show_rite_info"
											datacontext = "[RiteItem.GetRite]"
											datacontext = "[Rite.GetFaith]"
											layoutpolicy_horizontal = expanding
											size = { 0 80 }

											# Deliberately ungated. IsVisibleInGui is false both for a disabled rite and for every rite of a faith with no followers yet, so gating this row hides far more than the vestigial rites it would aim at. A disabled rite stays listed and inspectable; conversion is blocked by the scripted rules instead.

											background = {
												visible = "[ObjectsEqual( FaithWindow.GetSelectedRite.Self, Rite.Self )]"
												using = Background_Area
											}

											onclick = "[FaithWindow.SetSelectedRite( Rite.Self )]"
											onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"

											divider_light = {
												alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"
												size = { 100% 3 }
												parentanchor = bottom
												position = { 0 1 }
											}

											hbox = {
												margin = { 10 5 }
												alpha = "[Select_float(GreaterThan_int32(Rite.GetNumberOfCountiesOfRite,'(int32)0'), '(float)1.0','(float)0.5')]"

												icon = {
													name = "rite_icon"
													texture = "[Rite.GetIcon]"
													size = { 60 60 }
												}

												vbox = {
													margin_left = 10
													layoutpolicy_horizontal = expanding

													hbox = {
														layoutpolicy_horizontal = expanding

														### Rite Name
														text_single = {
															name = "faith_name"

															text = "FAITH_VIEW_RITE_COOLTIP_GETNAME"
															align = left|nobaseline
															using = Font_Size_Medium
															default_format = "#high"
															max_width = 240
														}

														expand = {}

														### Parent Faith Name and Status (main)
														text_single = {
															datacontext = "[Rite.GetFaith]"
															visible = "[Rite.IsMain]"
															margin_right = 5

															text = "FAITH_VIEW_RITE_FAITH_STATUS_MAIN"
															min_width = 160
															align = right|nobaseline
														}

														### Parent Faith Name and Status (branch)
														text_single = {
															datacontext = "[Rite.GetFaith]"
															visible = "[Not( Rite.IsMain )]"
															margin_right = 5

															text = "FAITH_VIEW_RITE_FAITH_STATUS_BRANCH"
															min_width = 160
															align = right|nobaseline
														}
													}

													### Rite Divergence
													hbox = {
														layoutpolicy_horizontal = expanding

														text_single = {
															layoutpolicy_horizontal = expanding
															text = "faith_rite_item_fulfillment_delta"
															align = left|nobaseline
														}

														expand = {}

														icon = {
															visible = "[Not( Rite.IsMain )]"
															texture = "gfx/interface/icons/icon_rite_divergence.dds"
															size = { 22 22 }
														}

														text_single = {
															visible = "[Not( Rite.IsMain )]"
															text = "FAITH_VIEW_OTHER_RITE_DIVERGENCE"
															using = Font_Size_Small
															align = left|nobaseline
															using = tooltip_se

															tooltipwidget = {
																widget_rite_divergence_tooltip = {
																	datacontext = "[FaithWindow.GetDivergenceBreakdown( Rite.Self )]"
																}
															}
														}
													}

													### Rite Followers
													text_single = {
														layoutpolicy_horizontal = expanding

														text = "FAITH_WINDOW_RITE_COUNTIES"
														align = left|nobaseline
														autoresize = no
													}

												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type widget_saint_item = widget {
		size = { 290 310 }

		background = {
			using = Background_Area
		}

		vbox = {
			datacontext = "[SaintItem.GetSaint]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding

				margin = { 12 8 }

				background = {
					using = Background_Area_Dark
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[Character.GetName]"
						align = nobaseline
					}

					text_single = {
						datacontext = "[SaintItem.GetLocation]"
						visible = "[And(Province.IsValid, Not(Province.MakeScope.Var('hide_location_for_saint').IsSet))]"
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "belief_saint_location"
						default_format = "#weak"
						align = nobaseline
					}
				}

				expand = {}

				button_round = {
					datacontext = "[PdxGuiWidget.MakeDecisionTypeWithParam( 'pam_extract_relic_decision', 'selected_item', Character.MakeScope )]"
					visible = "[And( DecisionTypeWithParams.GetDecisionType.IsShownForPlayer, Not( SaintItem.GetSaint.IsAlive ) )]"

					enabled = "[And( SaintItem.IsSaintActive( GetPlayer.Self ), GreaterThan_int32( SaintItem.GetAvailableRelics, '(int32)0' ) )]"
					size = { 45 45 }

					onclick = "[OpenGameViewData( 'decision_detail', DecisionTypeWithParams.Self )]"
					onclick = "[TenetWindow.Close]"

					tooltip = "extract_relic_button_tt"
					using = tooltip_ne

					button_icon = {
						parentanchor = center
						size = { 35 35 }
						texture = "gfx/interface/icons/flat_icons/artifact.dds"
						alwaystransparent = yes
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				margin_top = 15
				spacing = -5

				portrait_torso = {
					datacontext = "[GetIllustration( 'character_view_bg' )]"
					layoutpolicy_horizontal = expanding
					allow_outside = yes

					background = {
						texture = "[Illustration.GetTexture( Character.MakeScope )]"
						fittype = centercrop
						using = Mask_Rough_Edges
						alpha = 0.3

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "portrait_mask"
					{
						mask = "gfx/portraits/portrait_mask_council.dds"
					}

					blockoverride "portrait_texture"
					{
						portrait_texture = "[Character.GetPortrait('environment_torso', 'camera_torso', Select_CString( Character.IsAlive, 'idle', 'dead' ), PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
					}

					blockoverride "portrait_button" {}

					blockoverride "coa" {}

					blockoverride "dead_icon" {}

					blockoverride "opinion_box"	{}

					blockoverride "status_icons" {}

					blockoverride "grayscale" {}
				}

				expand = {}

				hbox = {
					layoutpolicy_horizontal = expanding

					background = {
						using = Background_Area_Dark
					}
					margin = { 12 8 }

					text_single = {
						layoutpolicy_horizontal = expanding
						autoresize = no

						text = "belief_saint_remaining_relics"
						align = nobaseline
						default_format = "#low"
					}
				}
			}
		}
	}

	type window_tenet_sub_window = window {
		name = "mainline_rite_tenets_window"
		size = { 640 80% }
		position = { 580 75 }

		layer = middle
		movable = yes

		using = Window_Background_Subwindow

		oncreate = "[BindTabsContext]"
		oncreate = "[PdxGuiTabs.SetResetOnShown( '(bool)no' )]"
		oncreate = "[PdxGuiTabs.AddTab( 'rites' )]"
		oncreate = "[PdxGuiTabs.AddTab( 'tenets' )]"
		oncreate = "[PdxGuiTabs.AddTab( 'doctrines' )]"
		oncreate = "[PdxGuiTabs.AddTab( 'saints' )]"
		datacontext = "[FaithWindow.GetFaith]"

		state = {
			name = _show
			on_start = "[ChallengersWindow.Close]"

			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			position_x = 620
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
			position_x = 580
		}

		vbox = {
			margin = { 4 4 }
			margin_bottom = 8

			header_pattern = {
				layoutpolicy_horizontal = expanding
				blockoverride "header_text" {
					text = "FAITH_VIEW_FAITH_DETAILS"
				}
				blockoverride "button_close" {
					onclick = "[TenetWindow.Close]"
				}
			}

			### Tabs
			hbox_tab_buttons = {
				name = "tab_buttons"

				state = {
					name = "quick_access_tenets"
					trigger_when = "[GetVariableSystem.Exists( 'quick_access_tenets' )]"
					on_start = "[PdxGuiTabs.SetTabByKey( 'tenets' )]"
					on_finish = "[GetVariableSystem.Clear( 'quick_access_tenets' )]"
				}

				state = {
					name = "quick_access_doctrines"
					trigger_when = "[GetVariableSystem.Exists( 'quick_access_doctrines' )]"
					on_start = "[PdxGuiTabs.SetTabByKey( 'doctrines' )]"
					on_finish = "[GetVariableSystem.Clear( 'quick_access_doctrines' )]"
				}

				blockoverride "icon_visible"
				{
					visible = no
				}

				blockoverride "tab_name" {}

				blockoverride "tab_label"
				{
					text = "[PdxGuiTabItem.LocalizeTab( 'belief_tab' )]"
				}

				blockoverride "on_click"
				{
					using = SubTabShortcut
				}

				blockoverride "extra_info" {
					text_single = {
						visible = "[EqualTo_string( PdxGuiTabItem.GetKey, 'saints' )]"
						margin_top = 3

						text = "[FaithWindow.GetSaintCount]"
						default_format = "#low"
						align = nobaseline
					}
				}
			}


			### Rites
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				visible = "[PdxGuiTabs.IsTabSet( 'rites' )]"

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 5 }
					spacing = 5

					hbox = {
						spacing = 5

						text_single = {
							text = "SORT_BY"
							align = nobaseline
						}

						dropdown_sort_characterlist = {
							datamodel = "[RiteWindow.GetOrderByOptions]"
							onselectionchanged = "[RiteWindow.OnOrderBySelectionChanged]"
							selectedindex = "[RiteWindow.GetOrderBySelectedIndex]"

							blockoverride "text_button_drop" {
								text = "[OrderRiteOption.GetName]"
							}
						}

						button_standard = {
							name = "sort_order"
							size = { 25 25 }
							onclick = "[RiteWindow.RevertSortOrder]"

							tooltip = "RITE_SORT_ORDER"
							using = tooltip_nw

							button_icon = {
								alwaystransparent = yes
								parentanchor = center
								size = { 25 25 }
								texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
								framesize = { 66 66 }

								frame = "[BoolTo1And2(RiteWindow.GetSortOrder)]"

								blockoverride "button_frames"
								{
									effectname = "NoHighlight"
								}
							}
						}
					}

					expand = {}

					### Only Selected faith rites
					hbox = {
						datacontext = "[FaithWindow.GetFaith.GetReligion]"
						layoutpolicy_horizontal = expanding
						max_width = 550
						spacing = 5

						expand = {}

						button_checkbox_label = {
							onclick = "[RiteWindow.OnShowOnlyReligionFaiths]"

							blockoverride "text"
							{
								text = "FAITH_VIEW_RITE_SHOW_ONLY_SAME_RELIGION"
								max_width = 180
							}
							blockoverride "checkbox"
							{
								checked = "[RiteWindow.ShowOnlyReligionFaiths]"
							}

							tooltip = "[RiteWindow.GetShowOnlyReligionFaithsTooltip]"
							using = tooltip_ne
						}

					}
				}

				scrollbox = {
					name = "rites_scroll_area"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							datamodel = "[RiteWindow.GetFaiths]"

							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									datacontext = "[FaithItem.GetFaith]"
									visible = "[Faith.IsVisibleInGui]"

									oncreate = "[BindFoldOutContext]"

									state = {
										name = "auto-expand"
										trigger_when = "[ObjectsEqual( Faith.Self, FaithWindow.GetFaith.Self )]"
										on_finish = "[PdxGuiFoldOut.Unfold]"
									}

									button_expandable_toggle_field_content = {
										size = { 550 80 }

										blockoverride "foldout_button"
										{
											hbox = {
												margin = { 20 0 }
												margin_left = 28
												layoutpolicy_horizontal = expanding
												spacing = 5

												alpha = "[Select_float( EqualTo_int32( Faith.GetNumberOfCountiesOfFaith, '(int32)0' ), '(float)0.5', '(float)1' )]"

												background = {
													visible = "[ObjectsEqual( Faith.Self, FaithWindow.GetFaith.Self )]"
													using = Background_Frame_Gold
													alpha = 0.6
												}

												icon = {
													size = { 60 60 }
													texture = "[Faith.GetIcon]"

													tooltipwidget = {
														faith_tooltip = {}
													}
												}

												vbox = {
													layoutpolicy_horizontal = expanding
													margin_bottom = 2
													spacing = 3

													hbox = {
														layoutpolicy_horizontal = expanding

														text_single = {
															layoutpolicy_horizontal = expanding
															autoresize = no
															text = "[Faith.GetNameNoTooltip]"
															default_format = "#T"
															alwaystransparent = yes
														}

														expand = {}

														text_single = {
															layoutpolicy_horizontal = expanding
															text = "FAITH_VIEW_RITE_LIST_NUMBER_OF_RITES"
															align = right
															default_format = "#low"
															alwaystransparent = yes
														}
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 30

														hbox = {
															hbox = {
																spacing = 5
																tooltip = "FERVOR_TT"

																icon = {
																	texture = "gfx/interface/icons/icon_fervor.dds"
																	size = { 22 22 }
																}

																text_single = {
																	text = "FAITH_WINDOW_FERVOR"
																	alwaystransparent = yes
																	max_width = 180
																}

																container = {
																	icon = {
																		position = { -2 5 }
																		size = { 22 22 }

																		icon = {
																			visible = "[GreaterThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)0' )]"
																			size = { 100% 100% }

																			texture = "gfx/interface/icons/aptitude_icons.dds"
																			framesize = { 26 26 }
																			frame = "[Select_int32( GreaterThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)1'), '(int32)5', '(int32)4' )]"
																			using = Color_Green
																		}

																		icon = {
																			visible = "[LessThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)0' )]"
																			size = { 100% 100% }

																			texture = "gfx/interface/icons/aptitude_icons.dds"
																			framesize = { 26 26 }
																			frame = "[Select_int32( LessThan_CFixedPoint( Faith.GetYearlyFervorChange, '(CFixedPoint)-1'), '(int32)1', '(int32)2' )]"
																			using = Color_Red
																		}
																	}
																}
															}

															expand = {}
														}

														text_single = {
															layoutpolicy_horizontal = expanding
															autoresize = no
															text = "FAITH_WINDOW_COUNTIES"
															align = right
															alwaystransparent = yes
														}

														text_single = {
															layoutpolicy_horizontal = expanding
															autoresize = no
															text = "FAITH_WINDOW_FOLLOWERS"
															align = right
															alwaystransparent = yes
														}
													}
												}
											}
										}
									}

									### Doctrine Groups with their selected Doctrine
									vbox = {
										visible = "[PdxGuiFoldOut.IsUnfolded]"
										layoutpolicy_horizontal = expanding

										margin_left = 20

										datamodel = "[FaithItem.GetRites]"
										item = {
											button_standard_hover = {
												name = "show_rite_info"
												datacontext = "[RiteItem.GetRite]"
												datacontext = "[Rite.GetFaith]"
												layoutpolicy_horizontal = expanding
												size = { 0 80 }

												# Deliberately ungated. IsVisibleInGui is false both for a disabled rite and for every rite of a faith with no followers yet, so gating this row hides far more than the vestigial rites it would aim at. A disabled rite stays listed and inspectable; conversion is blocked by the scripted rules instead.

												background = {
													visible = "[ObjectsEqual( FaithWindow.GetSelectedRite.Self, Rite.Self )]"
													using = Background_Area
												}

												background = {
													using = Visible_RiteItem_Heresy
													using = Status_Bad
													alpha = 0.2
												}

												onclick = "[FaithWindow.SetSelectedRite( Rite.Self )]"
												onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"

												divider_light = {
													alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"
													size = { 100% 3 }
													parentanchor = bottom
													position = { 0 1 }
												}

												hbox = {
													margin = { 10 5 }
													alpha = "[Select_float(GreaterThan_int32(Rite.GetNumberOfCountiesOfRite,'(int32)0'), '(float)1.0','(float)0.5')]"

													icon = {
														name = "rite_icon"
														texture = "[Rite.GetIcon]"
														size = { 60 60 }

														tooltipwidget = {
															rite_tooltip = {}
														}
													}

													vbox = {
														layoutpolicy_horizontal = expanding
														margin = { 10 0 }
														spacing = 5

														hbox = {
															layoutpolicy_horizontal = expanding

															### Rite Name
															text_single = {
																name = "faith_name"

																text = "FAITH_VIEW_RITE_COOLTIP_GETNAME"
																using = Font_Size_Medium
																default_format = "#high"
																max_width = 240
															}

															expand = {}

															text_single = {
																layoutpolicy_horizontal = expanding
																autoresize = no

																text = "FAITH_VIEW_RITE_FAITH"
																default_format = "#low"
																align = right
															}
														}

														hbox = {
															layoutpolicy_horizontal = expanding
															spacing = 40

															widget = {
																layoutpolicy_horizontal = expanding
																size = { 0 22 }

																# Main rite
																text_single = {
																	visible = "[Rite.IsMain]"
																	datacontext = "[Rite.GetFaith]"

																	size = { 100% 100% }
																	autoresize = no

																	text = "FAITH_VIEW_RITE_STATUS"
																	align = nobaseline
																}

																### Rite Divergence
																hbox = {
																	visible = "[Not( Rite.IsMain )]"
																	layoutpolicy_horizontal = expanding
																	spacing = 5

																	icon = {
																		size = { 22 22 }
																		texture = "gfx/interface/icons/icon_rite_divergence.dds"
																	}

																	text_single = {
																		max_width = 180
																		text = "FAITH_VIEW_DIVERGENCE_LABEL"
																		align = nobaseline
																	}

																	hbox = {
																		tooltipwidget = {
																			widget_rite_divergence_tooltip = {
																				datacontext = "[FaithWindow.GetDivergenceBreakdown( Rite.Self )]"
																			}
																		}
																		using = tooltip_se

																		text_single = {
																			using = Visible_RiteItem_Not_Heresy
																			text = "FAITH_VIEW_RITE_ITEM_DIVERGENCE_VALUE"
																			align = nobaseline
																		}

																		text_single = {
																			using = Visible_RiteItem_Heresy
																			text = "FAITH_VIEW_RITE_ITEM_DIVERGENCE_VALUE"
																			default_format = "#n"
																			align = nobaseline
																		}
																	}

																	expand = {}
																}
															}

															### Rite Counties
															text_single = {
																layoutpolicy_horizontal = expanding
																autoresize = no
																text = "FAITH_WINDOW_RITE_COUNTIES"
																align = nobaseline|right
															}

															### Rite Followers
															text_single = {
																layoutpolicy_horizontal = expanding
																autoresize = no
																text = "FAITH_WINDOW_RITE_ADHERENTS"
																align = nobaseline|right
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}

			### Tenets
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				visible = "[PdxGuiTabs.IsTabSet( 'tenets' )]"

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 5 10 }
					margin_left = 18
					spacing = 10

					background = {
						using = Background_Area
					}

					button_rite_icon = {
						size = { 40 40 }
					}

					text_single = {
						max_width = 590

						text = "FAITH_VIEW_SUB_WINDOW_TENETS_HEADER"
					}

					expand = {}

					button_menu = {
						onclick = "[GetVariableSystem.Toggle( 'compact_tenets_faith' )]"
						shortcut = "compact_faith_window"
						tooltip = "FAITH_VIEW_COMPACT_TENETS_TT"
					}
				}

				hbox_sort_tenets = {
					datacontext = "[TenetWindow.GetTenetSortController]"
				}

				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_content"
					{
						vbox = {
							layoutpolicy_horizontal = expanding

							datamodel = "[FaithWindow.GetTenetGroupItems]"
							item = {
								vbox_tenet_group_foldout = {}
							}
						}
					}
				}
			}

			### Doctrines
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				visible = "[PdxGuiTabs.IsTabSet( 'doctrines' )]"

				# used both here and in personal beliefs
				vbox_expanded_doctrine_status = {
					datacontext = "[FaithWindow.GetSelectedRite]"
					blockoverride "doctrine_tooltip_placement" {
						using = tooltip_ws
					}
					blockoverride "doctrine_status_knowledge" {}
					blockoverride "main_doctrine_known" {
						text_doctrine_knowledge = {
							size = { 140 24 }
						}
					}
					blockoverride "known_tenets" {
						hbox = {
							layoutpolicy_horizontal = expanding

							datamodel = "[FaithWindow.GetCoreTenetItems]"

							item = {
								widget_tenet_item_compact = {
									datacontext = "[TenetItem.GetTenet]"
									datacontext = "[TenetItem.GetFaith]"
									datacontext = "[TenetItem.GetRite]"

									blockoverride "tenet_name" {
										text = "[SelectLocalization( GetPlayer.KnowsTenet( TenetType.Self ), 'doctrine_status_known', 'doctrine_status_unknown' )]"
										alpha = "[Select_float( GetPlayer.KnowsTenet( TenetType.Self ), '(float)1.0', '(float)0.5' )]"
									}
								}
							}
						}
					}
				}
			}

			### Saints
			vbox = {
				visible = "[PdxGuiTabs.IsTabSet( 'saints' )]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 5 10 }
						margin_left = 18
						spacing = 10

						background = {
							using = Background_Area
						}

						button = {
							size = { 40 40 }

							onclick = "[FaithWindow.SetSelectedRite( Faith.GetMainRite.Self )]"
							onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"

							texture = "[Faith.GetIcon]"

							glow = {
								color = { 0 0 0 0.2 }
								glow_radius = 3
							}

							tooltipwidget = {
								faith_tooltip = {}
							}
						}

						text_single = {
							max_width = 590

							text = "FAITH_VIEW_SUB_WINDOW_SAINTS_HEADER"
						}

						expand = {}
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							spacing = 15

							vbox = {
								visible = "[DataModelHasItems( FaithWindow.GetSaintsInRealm )]"
								layoutpolicy_horizontal = expanding

								oncreate = "[BindFoldOutContext]"
								oncreate = "[PdxGuiFoldOut.SetShownBehavior( 'unfolded' )]"

								spacing = 5

								button_expandable_toggle_field = {
									blockoverride "text" {
										text = "FAITH_VIEW_SAINTS_IN_YOUR_REALM"
									}
								}

								flowcontainer = {
									visible = "[PdxGuiFoldOut.IsUnfolded]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									datamodel = "[FaithWindow.GetSaintsInRealm]"
									spacing = 10

									ignoreinvisible = yes
									wrap_count = 2

									item = {
										widget_saint_item = {}
									}
								}
							}

							vbox = {
								visible = "[DataModelHasItems( FaithWindow.GetSaintsOutsideRealm )]"
								layoutpolicy_horizontal = expanding

								oncreate = "[BindFoldOutContext]"
								oncreate = "[PdxGuiFoldOut.SetShownBehavior( 'unfolded' )]"

								spacing = 5

								button_expandable_toggle_field = {
									blockoverride "text" {
										text = "FAITH_VIEW_SAINTS_OUTSIDE_YOUR_REALM"
									}
								}

								flowcontainer = {
									visible = "[PdxGuiFoldOut.IsUnfolded]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									datamodel = "[FaithWindow.GetSaintsOutsideRealm]"
									spacing = 10

									ignoreinvisible = yes
									wrap_count = 2

									item = {
										widget_saint_item = {}
									}
								}
							}

							text_single = {
								layoutpolicy_vertical = expanding
								visible = "[EqualTo_int32( FaithWindow.GetSaintCount, '(int32)0' )]"
								text = "SITUATION_PARTICIPANT_WINDOW_PARTICIPANT_EMPTY"
								default_format = "#weak"
							}
						}
					}
				}

				hbox = {
					datacontext = "[GetDecisionWithKey( 'pam_canonize_saint_decision' )]"
					visible = "[Decision.IsShownForPlayer]"
					layoutpolicy_horizontal = expanding
					margin = { 16 12 }

					button_decision_entry = {
						layoutpolicy_horizontal = expanding
						size = { 280 45 }

						onclick = "[OpenGameViewData( 'decision_detail', Decision.Self)]"
						using = tooltip_ne
					}
				}
			}
		}
	}

	type button_holy_order_interactions_button = button_round {
		visible = "[And( Character.IsValid, Not( IsObserver ) )]"

		onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'holy_order')]"
		tooltip_visible = "[Not( IsInteractionMenuOpenForCharacterWithFilter( Character.Self, 'holy_order' ) )]"
