                                                                text = "TREANT_FORM_BUTTON"
                                                                size = { 100 50 }
                                                                enabled = "[GetScriptedGui( 'change_druid_form_sgui' ).IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'form', MakeScopeFlag('treant')).End)]"
                                                                tooltip = "[GetScriptedGui('change_druid_form_sgui').ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'form', MakeScopeFlag('treant')).End)]"
                                                                onclick = "[GetScriptedGui('change_druid_form_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'form', MakeScopeFlag('treant')).End)]"
                                                            }
                                                            button_standard = {
                                                                text = "BEAR_FORM_BUTTON"
                                                                size = { 100 50 }
                                                                enabled = "[GetScriptedGui( 'change_druid_form_sgui' ).IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'form', MakeScopeFlag('bear')).End)]"
                                                                tooltip = "[GetScriptedGui('change_druid_form_sgui').ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'form', MakeScopeFlag('bear')).End)]"
                                                                onclick = "[GetScriptedGui('change_druid_form_sgui').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'form', MakeScopeFlag('bear')).End)]"
                                                            }
                                                            button_standard = {
