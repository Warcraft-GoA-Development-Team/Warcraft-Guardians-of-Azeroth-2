	type vbox_tenet_group_foldout = vbox {
		layoutpolicy_horizontal = expanding
		spacing = 4

		oncreate = "[BindFoldOutContext]"
		oncreate = "[PdxGuiFoldOut.Unfold]"

		button_expandable_toggle_field = {
			blockoverride "text"
			{
				text = "[TenetGroupItem.GetGroupTitle]"
				default_format = "#clickable"
			}
		}

		vbox = {
			visible = "[PdxGuiFoldOut.IsUnfolded]"

			layoutpolicy_horizontal = expanding

			fixedgridbox = {
				name = "tenets_in_group"
				visible = "[Not( GetVariableSystem.Exists( 'compact_tenets_faith' ) )]"

				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				addcolumn = 150
				addrow = 220

				datamodel_wrap = 4
				flipdirection = yes

				datamodel = "[TenetGroupItem.GetTenets]"
				item = {
					widget_tenet_item = {
						datacontext = "[TenetItem.GetTenet]"
						datacontext = "[TenetItem.GetFaith]"
						datacontext = "[TenetItem.GetRite]"
						blockoverride "divergence_text" {}
						blockoverride "divergence_visibility" {
							visible = no
						}
						blockoverride "tenet_badges_layout" {
							size = { 70 50 }
							position = { 0 10 }
						}
					}
				}
			}

			fixedgridbox = {
				name = "tenets_in_group_compact"
				visible = "[GetVariableSystem.Exists( 'compact_tenets_faith' )]"

				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				addcolumn = 205
				addrow = 82

				datamodel_wrap = 3
				flipdirection = yes

				datamodel = "[TenetGroupItem.GetTenets]"
				item = {
					widget_tenet_item_compact = {
						datacontext = "[TenetItem.GetTenet]"
						datacontext = "[TenetItem.GetFaith]"
						datacontext = "[TenetItem.GetRite]"
						blockoverride "divergence_visibility" {
							visible = no
						}
						blockoverride "tenet_glow" {}
					}
				}
			}

			spacer = {
				size = { 0 8 }
				block "bottom_margin_compact" {
					visible = "[GetVariableSystem.Exists( 'compact_tenets_faith' )]"
				}
			}
		}
	}

