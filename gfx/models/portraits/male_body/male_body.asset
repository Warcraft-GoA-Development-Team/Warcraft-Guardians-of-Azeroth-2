	attribute = { name = "bs_body_shrink_hands"											blend_shape = "male_bs_body_shrink_hands" }
	attribute = { name = "bs_body_long_skirt"											blend_shape = "male_bs_body_long_skirt" default = 0 }

	#### Blendshapes for offset cloak and armor
	attribute = { name = "bs_cloak_offset"													blend_shape = "male_bs_body_neutral" }

	default_state = "none"
	state = {	name = "none"															animation = "body_idle_1" }
