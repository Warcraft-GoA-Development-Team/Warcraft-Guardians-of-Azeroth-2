faith_name = {
	faith_details = {
		religion = key					# Required field
		color = { r g b }
		icon = faith_name 				# If you want to use another faith's icon
		reformed_icon = ""
		religious_head = title_key		# What title should be this faith's religious head. If not set, will not have a religious head (unless created elsewhere in script)
		head_of_rite = title_key		# Head of rite override - if set, holder of this title will be head of their rite ahead of
										# clerical region rulers and secular rulers. Head of faith still is the absolute priority
		graphical_faith = catholic_gfx	# This faith (and custom faiths based on this faith) use this 3D model (currently used for temple assets). Order of precedence is the lowest level scripted in: faith > religion > family.
		theocracy_government_type = government_type_key # Which government type should theocratic rulers of this faith have? (falls back to basic 'theocracy_government' if not defined)
	}

	# origin: faith key this faith derives from. Allows to ignore faith mismatch issues when processing religious heads in history
	# due to characters of different (more ancient) faiths being set as holders.
	origin = other_faith_key

	# The faith's Holy Sites that are not Eminent. They apply no global bonuses, only local ruler/county modifiers
	holy_sites = {
		key
		key
	}

	# The faith's Eminent Holy Sites, which also apply global bonuses. Exclusive with holy_sites - never list one twice
	eminent_holy_sites = {
		key
	}

	# If the faith has no scripted main Rite, tenets and tenet_selection_pair seed its dynamically created main Rite.
	# If the faith has a scripted main Rite, define its core tenets on that Rite instead; the Rite's tenets override these.
	tenets = {
		key
		key
	}

	# Faith doctrines are additive to a scripted main Rite. The faith doctrine is added when the Rite and parent religion
	# have not already filled its doctrine group; a doctrine on the Rite in the same group takes precedence.
	# Keep doctrines intrinsic to every Rite of the faith here. Put Rite-specific doctrine choices on the individual Rite.
	# For a faith with no scripted main Rite, these doctrines seed the dynamically created main Rite.
	doctrines = {
		key
		key
	}

	tenet_selection_pair = {				# Adds a tenet if the flag is present
		requires_dlc_flag = <dlc_flag>		# Flag that will be evaluated
		tenet = name						# Name of the tenet that will be added if the dlc flag is present
		fallback_tenet = name				# Optional. If the flag isn't present and the fallback_tenet is defined, this tenet will be added instead
	}

	reserved_male_names = { Hormazd Isaac }	# Names listed here will not be chosen as random names for characters of other faiths, unless these faiths also allow the name.
	reserved_female_names = { Maria }		# ... Note that these names refer to the "base names" of the names mentioned in the culture definitions (see _cultures.info).

	# keys of cultures associated with this faith. refers to the cultures found in culture/cultures
	cultures = { culture_1 culture_2 ... }

	# if set to yes, this faith will be considered to be dead if no characters or counties follow it (as opposed to just not been founded yet). default is no.
	historical = no

	# If the faith is supposed to have a specific Rite as its main Rite, specify its key here.
	# If it changes between start dates, use faith history to set the dated main Rites and document those mappings
	# in a comment in the faith definition. The scripted main Rite owns core tenets and Rite-specific doctrines, while
	# faith-intrinsic doctrines may remain additive in the faith definition.
	main_rite = rite_key

	localization = {						# Key-value pairs for religion- or faith-dependent localizations. Can be accessed via "[Faith.key]" and "[Faith.random_key]", or even "[Faith.Custom('key')]" and "[Faith.RandomCustom('key')]"
		key = TAG							# Keys missing in the faith will be inherited from the religion.
		another_key = { TAGS MORE_TAGS }	# When there is more than one value, Faith.Custom returns the first value.
	}

	# Names and CoAs that can be used by Military Orders of this faith.
	# If there are none (or none left), it will choose those in the religion instead.
	holy_order_names = {
		{ name = "mercenary_company_name1" coat_of_arms = "mercenary_company_coa1" }
		{ name = "mercenary_company_name2" coat_of_arms = "mercenary_company_coa2" }
		...
	}
}
