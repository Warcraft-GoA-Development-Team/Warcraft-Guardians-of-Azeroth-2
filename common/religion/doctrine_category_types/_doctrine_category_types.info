### Brief: key ( database key )
# Name of 'doctrine_category'
# Localization is selected by: "doctrine_category_" + <key>
#
key = {
	### brief: visible ( bool )
	# Will this category show up in gui views?
	# Default: yes
	#
	visible = yes/no

	### Brief: sort_order ( integer )
	# The order it will show up in gui lists. Higher value appears earlier.
	# Default = -1
	#
	sort_order = integer

	### Brief: gui_tags ( string, optional )
	# List of gui tags, used to set size etc in gui views.
	#
	gui_tags = { tag_1 tag_2 ... }
}
