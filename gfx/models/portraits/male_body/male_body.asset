	state = {	name = "idle"															animation = "body_idle_2" chance = 2 looping = no next_state = "idle" }
	state = {	name = "idle"															animation = "body_idle_3" chance = 2 looping = no next_state = "idle" }
	# idleFat uses infant animations because infant animations are exactly the same with what idleFat would look like
	state = {	name = "idleFat_entry"													animation = "body_idleInfant_1" chance = 10 looping = no  next_state = "idleFat" }
	state = {	name = "idleFat"														animation = "body_idleInfant_1" chance = 10 looping = no next_state = "idleFat" }
	state = {	name = "idleFat"														animation = "body_idleInfant_2" chance = 2 looping = no next_state = "idleFat" }
