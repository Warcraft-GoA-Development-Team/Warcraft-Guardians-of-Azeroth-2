# Each top-level key in a file is the faith key that should get the history (a file can contain several faiths),
# with the dated entries below nested inside it: faith_key = { date = { ... } }
# TODO religions should work as well for ease of definition

# When the entry is executed
date = {

	# non-historical faiths with no characters or counties count as non-created
	# and cannot be converted to until they are flagged in history or set on characters/counties
	# you cannot "un-create" a faith. Even if you don't mark it as created here, using it
	# in character history or province history sets it as created anyway
	created = yes

	# Main Rite at this date. Its core tenets and Rite-specific doctrines become the faith's effective properties;
	# faith doctrines in otherwise unfilled doctrine groups are additive to it.
	# When the main Rite changes between start dates, define each dated Rite's properties on its Rite type or
	# in the corresponding rites history block, and document every dated mapping in the faith type comment.
	main_rite = rite_key

	# head of faith title at this date
	religious_head = religious_head_title_key

	# list of known tenets at this date. dlc-locked (if the dlc is disabled) tenets and core tenets for the main rite will be ignored
	# Note - Core tenets for the main rite are automatically permitted for the other rites
	known = { tenet_1 tenet_2 ... }

	# list of permitted tenets at this date. dlc-locked (if the dlc is disabled) tenets and core tenets for the main rite will be ignored
	# Note - Core tenets for the main rite are automatically permitted for the other rites
	permitted = { tenet_1 tenet_2 ... }
	    
	# list of prohibited tenets at this date. dlc-locked (if the dlc is disabled) tenets and core tenets for the main rite will be ignored
	# Note - Core tenets for the main rite are automatically permitted for the other rites
	prohibited = { tenet_1 tenet_2 ... }

	# starting tenet popularity values. newer dates will overwrite older ones. dlc-locked (if the dlc is disabled) tenets will be ignored
	popularity = {
		tenet_key = value
		tenet_key = value
	}

	# description of a rite within the faith - which tenets and doctrine the rite practices.
	# rites are chronologically additive and can only be removed from a faith by adding them to another one.
	# if an earlier history entry specifies rites A, B, C and a later one specifies rite D, the resulting rites under the faith will be A, B, C, D
	# rites are listed inside a rites block, one entry per rite: rites = { rite_key = { ... } other_rite_key = { ... } }
	# The rite will be added to the faith if needed. The contents of each rite entry are:
	rite_key = {

		# optional. overrides the rite key of this entry. If set to empty it will act on the current main rite of the faith
		rite = rite_key
		
		# use this flag to mark this rite as being enabled/disabled for conversion.
		# all rites are enabled unless explicitly disabled either in their rite type or via effect in history onactions.
		# if left unspecified there will be no change (refer to rite type or effects)
		enabled = yes/no
		
		# set up core tenets for the rite. Will overwrite the existing set, so you need to specify them all
		# evaluated in order of definition, first entry with all dlc unlocked will be applied.
		# if any dlc in the list is not unlocked, the core tenets for the rite will be either those set by previous history entries
		#	or the ones set up in the rite type.
		# it is suggested to leave base game dlc setups in the rite type and set up dlc-locked variants and history in history files.
		# If tenet setup must change through history leave one entry without dlcs as fallback
		tenet_setup = {
			dlc_feature = { feature_1 feature_2 }
			tenets = { tenet_1 tenet_2 tenet_3 }
		}
		
		tenet_setup = {
			tenets = { tenet_1 tenet_2 tenet_3 }
		}
		
		# set up doctrines for the rite. will only overwrite the specified doctrine groups, the others will keep
		# the previous doctrine (usually defined either in rite type or parent faith)
		doctrines = { doctrine_1 doctrine_2 ... }
	}
}

##################################
#   ORDER OF EXECUTION
##################################
#
# When history is executed, all entries at a given date do a first pass where:
#   - main rite is set
#   - rites are set to the relevant faith
#
# Then we do a second pass on the faith itself:
#   - flag as created
#   - handle the enabled flag of specified rites
#   - set religious head
#   - set up tenet status
#       Known first, then permitted, then prohibited. the latter lists may overwrite previous entry but you'll get warning messages for duplicated tenets anyway
#   - rite setup
#       - core tenets
#       - doctrines
#   - tenet popularity
#
