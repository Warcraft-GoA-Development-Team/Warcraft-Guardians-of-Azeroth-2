You can define

== Structure ==

name_of_the_building = {
	# Triggered name (first valid). Root scope is the Province in which the building is built or will be built.
	# If no province is available (e.g. encyclopedia), or no triggered name is valid, the base name is used.
	triggered_name = {
		trigger = { terrain = hills }
		reference = "cool_hilly_name"
	}

	# How many levies does the building give ( int or named value )
	# default = 0
	#
	levy = 200

	# How much garrison does the building give ( int or named value )
	# default = 0
	#
	max_garrison = 100

	# Garrison monthly refill rate ( fixed point or named value ) in the inverval of [0..1]
	# Every month garrison increased by this fraction of max garrison
	# default = 0
	#
	garrison_reinforcement_factor = 0.01

	# Number of days it takes to construct this building ( int or named value )
	# default = 0
	#
	construction_time = 720

	# What minimum level does the parent district need to be to construct this building? ( script value )
	# Default is no level requiement
	# Scopes:
	#	root ( province ) 			province where building is located
	#	scope:holder ( character )	holder of the barony title
	#	scope:county ( title )		is the county title the province belongs to
	#
	district_level_requirement = 1

	# Array of assets used (optional)
	# Note: This array is optional and reading assets without it works just as well
	#		It exists to add indention to easily collapse or minimize a bunch of assets at the same time
	#
	assets = {
		# Which asset does the building use
		#
		asset = {

			# specifies wheter to use a mesh or an entity. Meshes are more performant and should be preferred.
			#
			type = pdxmesh/entity

			# The name of the mesh or the entity ( string )
			# Can have multiple entries, combined with 'names'
			# Note that they must all be entities, or all be meshes
			#
			name = "western_castle_01_level_03_mesh"
			name = "western_castle_01_level_04_mesh"

			# Names of meshes or entities ( array of strings )
			# To randomize between multiple meshes/entities
			# Note that they must all be entities, or all be meshes
			# Combined with 'name'
			#
			names = { "western_castle_01_level_03a_mesh" "western_castle_01_level_03b_mesh" "western_castle_01_level_03c_mesh" }

			# Path to illustration shown in the county view ( string )
			# Texture can be accessed in GUI: "[Holding.GetIllustration]"
			#
			illustration = "path/to/image.dds"

			# Associated sound effect and an optional parameter
			# Can also be just soundeffect = "event:..." if no parameter is needed
			# Can have multiple sound effects
			#
			soundeffect = { soundeffect = "event:/SFX/Ambience/3DMapEmitters/Holdings/Generic/sfx_amb_3d_holdings_generic_castle_01" soundparameter = { "Tier" = 2.0 } }

			# Governments that prefer this asset to be shown
			governments = { tribal_government }

			# Province IDs in which this asset is preferred ( array of int )
			# Has a higher priority than graphical region
			# If set, the asset is only used in the listed provinces
			#
			provinces = { 496 1000 }

			# Graphical regions in which this asset is preferred ( array of strings )
			# This is the most important criterion when selecting the asset, with the exception of government and province
			# Should match entries in geographical regions database
			#
			graphical_regions = { graphical_mena graphical_mediterranean }

			# Graphical cultures that prefer this asset to be shown ( array of flags )
			# Should match 'building_gfx' in cultures database
			#
			graphical_cultures = { western_building_gfx mediterranean_building_gfx }

			# Graphical faiths that prefer this asset to be shown ( array of strings )
			# Priority is faith > religion > family, so Catholic graphical_faith overrides Abrahamic graphical_faith
			# Should match 'graphical_faith' in religion database
			#
			graphical_faiths = { catholic_gfx orthodox_gfx }

			# Domicile building required for this asset to be used ( domicile building key )
			# Checked against the domicile of the province (or county) owner
			#
			domicile_building = some_domicile_building

			# Required DLC flag ( dlc flag )
			# Assets marked with a DLC flag require matching DLC to be enabled
			#
			requires_dlc_flag = the_northern_lords
		}
	}

	# Trigger: is the building enabled?
	# Else won't give any effects to holder, and not be constructible ( see can_construct* below ).
	# If is_graphical_background = yes, this controls whether the building can be shown in the province.
	# Scopes:
	#	root ( province ) 			province where building is located
	#	scope:holder ( character )	holder of the barony title
	#	scope:county ( title )		is the county title the province belongs to
	#
	is_enabled = {}

	# Triggers can the building be constructed?
	# Use this instead of is_enabled if you want to allow rulers to "use" the building
	# after getting the holding, but to disallow that they construct it.
	# Note that is_enabled (see above) is always called together with can_construct_potential.
	# To be able to construct a building all 3 triggers must evaluate to true
	# Not used if is_graphical_background = yes
	# scopes: root is the province; scope:holder is the holder of the province; county is the county title the province belongs to
	#
	can_construct_potential = {}				# Whether the building even appears in the build menu
												# For upgrades it is identical to can_construct_showing_failures_only.
	can_construct_showing_failures_only = {}	# Trigger will show only failuers. Use for temporary effects player can overcome
	can_construct = {}							# Trigger will show both filled and missing requirements

	# Shall disabled building still show in the build menu. Will still use can_construct_potential ( bool )
	# default: no
	#
	show_disabled = yes/no

	# How much cost does the building cost ( fixed cost: gold/prestige/piety/renown/influence/herd/treasury/treasury_or_gold/merit/barter_goods, number or named value )
	# Not a script value. Not supported for great buildings (erased with an error)
	#
	cost = { gold = 500 ... }

	# The next upgrade for this building chain
	#
	next_building = castle_02

	# Custom description for effects indirectly provided by building ( dynamic description )
	# Scopes:
	#	root ( province ) 			province where building is located
	#	scope:holder ( character )	holder of the barony title
	#	scope:county ( title )		is the county title the province belongs to
	# No scopes are set where the description is shown without a province, such as the building concept
	# tooltip and the encyclopedia entry - scoped triggers evaluate false there.
	#
	effect_desc = dynamic_description


	### CHARACTER MODIFIERS ###
	# A modifier applied to the owner of the building
	#
	character_modifier = {
		modifier_name = modifier_value
	}

	# Applied if the character's culture has the parameter (or lacks it, for not_parameter)
	character_culture_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = culture param
		not_parameter = culture param
	}

	# Applied if the character's faith has the parameter (or lacks it, for not_parameter)
	character_rite_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = rite_param
		not_parameter = rite_param
	}

	# A modifier applied to the owner of the province if the dynasty of the county holder has a specific perk
	character_dynasty_modifier = {
		county_holder_dynasty_perk = fp2_urbanism_legacy_1 # The name of the perk
		modifier_name = modifier_value
	}

	# A modifier applied to the owner of the holding if any situation the county is involved in has the specified parameter in its current phase (or lacks it, for not_parameter)
    character_situation_modifier = {
		modifier_name = modifier_value
        # Either of:
        parameter = situation_parameter
        not_parameter = situation_parameter
    }

	# A modifier applied to the county holder if their government has the specified parameter (or lacks it, for not_parameter) (government flag)
	character_government_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = government_param
		not_parameter = government_param
	}

	# A modifier applied to the county holder if the province's potential trade goods includes the specified trade good
	character_potential_trade_good_modifier = {
		trade_good = trade_good_key
		modifier_name = modifier_value
	}

	### PROVINCE MODIFIERS ###
	# A modifier applied to the province
	province_modifier = {
		modifier_name = modifier_value
	}

	# A modifier applied to the province only if province's county culture has this parameter (or lacks it, for not_parameter)
	province_culture_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = culture_param
		not_parameter = culture_param
	}

	# A modifier applied to the province only if province's county rite has this parameter (or lacks it, for not_parameter)
	province_rite_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = rite_param
		not_parameter = rite_param
	}

	# A modifier applied to the province only if it matches all listed criteria
	# culture parameter (optional), terrain type, coastal or riverside
	province_terrain_modifier = {
		terrain = terrain_type				# From terrain database (optional, if empty - any terrait)

		is_coastal = yes/no					# Apply modifier on coastal, non-coastal, or any province
											# (optional, default is both coastal and non-coastal)

		is_riverside = yes/no				# Apply modifier on provinces only next to a big river or not next to a riger province
											# (optional, default is both riverside and not)

		# Either of:
		parameter = culture_param			# (optional)
		not_parameter = culture_param 		# (optional)
	}

	# A modifier applied to the province if the dynasty of the county holder has a specific perk
	province_dynasty_modifier = {
		county_holder_dynasty_perk = fp2_urbanism_legacy_1
		modifier_name = modifier_value
	}

	# A modifier applied to the province if any situation the county is involved in has the specified parameter in its current phase (or lacks it, for not_parameter)
    province_situation_modifier = {
		modifier_name = modifier_value
        # Either of:
        parameter = situation_parameter
        not_parameter = situation_parameter
    }

	# A modifier applied to the province if the county holder's government has the specified parameter (or lacks it, for not_parameter) (government flag)
	province_government_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = government_param
		not_parameter = government_param
	}

	# A modifier applied to the province if the province's potential trade goods includes the specified trade good
	province_potential_trade_good_modifier = {
		trade_good = trade_good_key
		modifier_name = modifier_value
	}

	### COUNTY MODIFIERS ###
	# A modifier applied to the entire county
	# All provinces in the county can stack the same county modifier together
	county_modifier = {
		modifier_name = modifier_value
	}

	# A modifier applied to the county only if county culture has this parameter (or lacks it, for not_parameter)
	county_culture_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = culture_param
		not_parameter = culture_param
	}

	# A modifier applied to the county only if province's county rite has this parameter (or lacks it, for not_parameter)
	county_rite_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = rite_param
		not_parameter = rite_param
	}

	# A modifier applied to the county if the dynasty of the county holder has a specific perk
	county_dynasty_modifier = {
		county_holder_dynasty_perk = fp2_urbanism_legacy_1 # The name of the perk
		modifier_name = modifier_value
	}

	# A modifier applied to the entire county if any situation the county is involved in has the specified parameter in its current phase (or lacks it, for not_parameter)
	# All provinces in the county can stack the same county modifier together
    county_situation_modifier = {
		modifier_name = modifier_value
        # Either of:
        parameter = situation_parameter
        not_parameter = situation_parameter
    }

	# A modifier applied to the county if the province's potential trade goods includes the specified trade good
	county_potential_trade_good_modifier = {
		trade_good = trade_good_key
		modifier_name = modifier_value
	}

	### DUCHY CAPITAL MODIFIERS ###
	# A modifier applied to every de jure county in the duchy. Can only be used (and only works) for duchy capital buildings
	duchy_capital_county_modifier = {
		modifier_name = modifier_value
	}

	# A modifier applied to every de jure county in the duchy if county culture has specified parameter (or lacks it, for not_parameter)
	# Can only be used (and only works) for duchy capital buildings
	duchy_capital_county_culture_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = culture_param
		not_parameter = culture_param
	}

	# A modifier applied to every de jure county in the duchy if county rite has specified parameter (or lacks it, for not_parameter)
	# Can only be used (and only works) for duchy capital buildings
	#
	duchy_capital_county_rite_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = rite_param
		not_parameter = rite_param
	}

	# A modifier applied to every de jure county in the duchy if the dynasty of the county holder has a specific perk
	# Can only be used (and only works) for duchy capital buildings
	#
	duchy_capital_county_dynasty_modifier = {
		county_holder_dynasty_perk = fp2_urbanism_legacy_1 # The name of the perk
		modifier_name = modifier_value
	}

	# A modifier applied to every de jure county in the duchy if any situation the county is involved in has the specified parameter in its current phase (or lacks it, for not_parameter).
	# Can only be used (and only works) for duchy capital buildings.
    duchy_capital_county_situation_modifier = {
		modifier_name = modifier_value
        # Either of:
        parameter = situation_parameter
        not_parameter = situation_parameter
    }  

    ### MARKET MODIFIERS ###
	# A modifier applied to the market this building is a part of
	market_modifier = {
		modifier_name = modifier_value
	}

	# A modifier applied to the market only if building's county culture has this parameter (or lacks it, for not_parameter)
	market_culture_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = culture_param
		not_parameter = culture_param
	}

	# A modifier applied to the market only if building's county faith has this parameter (or lacks it, for not_parameter)
	market_faith_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = faith_param
		not_parameter = faith_param
	}

	# A modifier applied to the market only if the building location matches all listed criteria
	# culture parameter (optional), terrain type, coastal or riverside
	market_terrain_modifier = {
		terrain = terrain_type				# From terrain database (optional, if empty - any terrait)

		is_coastal = yes/no					# Apply modifier on coastal, non-coastal, or any province
											# (optional, default is both coastal and non-coastal)

		is_riverside = yes/no				# Apply modifier on provinces only next to a big river or not next to a riger province
											# (optional, default is both riverside and not)

		# Either of:
		parameter = culture_param			# (optional)
		not_parameter = culture_param 		# (optional)
	}

	# A modifier applied to the market only if the building's province is at exactly this size level
	# Same gate as `province_size` on trade_good_need below. Use one block per level to scale a modifier with size.
	market_size_modifier = {
		province_size = <number>
		modifier_name = modifier_value
	}

	# A modifier applied to the market if the dynasty of the building's county holder has a specific perk
	market_dynasty_modifier = {
		county_holder_dynasty_perk = fp2_urbanism_legacy_1
		modifier_name = modifier_value
	}

	# A modifier applied to the market if any situation the building county is involved in has the specified parameter in its current phase (or lacks it, for not_parameter)
    market_situation_modifier = {
		modifier_name = modifier_value
        # Either of:
        parameter = situation_parameter
        not_parameter = situation_parameter
    }

	# A modifier applied to the market if the building county holder's government has the specified parameter (or lacks it, for not_parameter)
	market_government_modifier = {
		modifier_name = modifier_value
		# Either of:
		parameter = government_param
		not_parameter = government_param
	}

    ### MISC MODIFIERS ###
	# A special modifier applied to every holding of specified type in the county
	county_holding_modifier = {
		holding = castle_holding
		income_mult = 1
	}

	# A modifier applied to the county holder
	county_holder_character_modifier = {
		modifier_name = modifier_value
	}


	## fallback: modifier collection
	# Use this field to define an alternative set of modifiers that will be applied if the building is disabled or ruined.
	# Requires a 'is_enabled' trigger to be configured as well.
	#
	# supported modifiers:
	#	- character_modifier
	#	- character_culture_modifier
	#	- character_faith_modifier
	#	- character_dynasty_modifier
    #	- character_situation_modifier
