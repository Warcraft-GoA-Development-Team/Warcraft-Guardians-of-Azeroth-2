	type character_casting_spells_bar_box = vbox {
		visible = "[GetScriptedGui('is_casting_spells_sgui').IsValid( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End)]"
		layoutpolicy_horizontal = expanding
		margin = { 15 0 }
		margin_top = 10
		spacing = 10
		text_single = {
			text = "CURRENT_CASTING_SPELLS_TEXT"
			default_format = "#T"
		}
		dynamicgridbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[CharacterWindow.GetCharacter.MakeScope.GetList('current_spells_casting')]"
            datamodel_wrap = 1
			flipdirection = yes
			
			item = {
				container = {
					size = { 200 45 }
					progressbar_royal_court = {
						progresstexture = "gfx/interface/progressbars/progress_air_spirit.dds"
						noprogresstexture = "gfx/interface/progressbars/progress_fire_decay.dds"
						size = { 550 30 }
						value = "[Multiply_float(FixedPointToFloat(CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_progress_percent')).GetValue), '(float)0.01')]"
						min = 0
						max = 1
						text_single = {
							text = "CASTING_TEXT_NO_TITLE"
							position = { 5 -2 }
							default_format = "#T"
						}
						tooltipwidget = {
							widget_current_spell_casting_tooltip = {
								datacontext = "[Scope]"
								blockoverride "cooldown_text" {
									text = "REMAINING_CT_TEXT_CHARACTERWINDOW"
								}
								blockoverride "spell_targets_breakdown" {
									spell_targets_breakdown = {
										blockoverride "single_target_character_visible" {
											visible = "[ObjectsEqual('character', CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_target_type')).GetFlagName)]"
										}
										blockoverride "single_target_character_portrait" {
											datacontext = "[CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_recipient')).Char]"
										}
										blockoverride "single_target_title_visible" {
											visible = "[ObjectsEqual('title', CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_target_type')).GetFlagName)]"
										}
										blockoverride "single_target_title" {
											datacontext = "[CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_recipient')).Title]"
										}
										blockoverride "single_target_army_visible" {
											visible = "[ObjectsEqual('army', CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_target_type')).GetFlagName)]"
										}
										blockoverride "single_target_army" {
											datacontext = "[CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_recipient')).Army]"
										}
										blockoverride "multi_target_title_visible" {
											visible = "[ObjectsEqual('title_list', CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_target_type')).GetFlagName)]"
										}
										blockoverride "multi_target_title" {
											datamodel = "[CharacterWindow.GetCharacter.MakeScope.GetList(Concatenate(Scope.GetFlagName, '_targets_list'))]"
										}
										blockoverride "multi_target_character_visible" {
											visible = "[ObjectsEqual('character_list', CharacterWindow.GetCharacter.MakeScope.Var(Concatenate(Scope.GetFlagName, '_target_type')).GetFlagName)]"
										}
										blockoverride "multi_target_character" {
											datamodel = "[CharacterWindow.GetCharacter.MakeScope.GetList(Concatenate(Scope.GetFlagName, '_targets_list'))]"
										}
									}
								}
								blockoverride "cancel_cast_button" { }
							}
						}
					}
				}
			}
		}
		background = {
			using = Background_Area_Dark
			margin_left = 3
		}
	}
	type cast_on_behalf_gui = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		background = {
			using = Background_Area
		}
		hbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			margin = { 25 25 }
			portrait_body = {
				blockoverride "opinion_box" { }
			}
			vbox = {
				spacing = 25
				layoutpolicy_horizontal = expanding
				text_single = {
					autoresize = no
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					fontsize = 35
					align = center
					text = "[Character.GetNameNoTooltip|U]"
				}
				hbox = {
					spacing = 50
					visible = "[GetScriptedGui( 'wc_has_mp_gui' ).IsValid(GuiScope.SetRoot(Character.MakeScope).End)]"
					hbox = {
						text_single = {
							fontsize = 18
							text = "MP_VALUE_TEXT"
							default_format = "#underline"
						}
						tooltipwidget = {
							widget_mp_breakdown_tooltip = {
								datacontext = "[Character.MakeScope]"
							}
						}
					}
					hbox = {
						text_single = {
							fontsize = 18
							text = "MANA_VAL_TEXT"
							default_format = "#underline"
						}
						tooltipwidget = {
							widget_mana_breakdown_tooltip = {
								datacontext = "[Character.MakeScope]"
							}
						}
					}
				}
				hbox = {
					layoutpolicy_horizontal = expanding
					name = "known_spells"
					text_single = {
						text = "KNOWN_SPELLS_TEXT"
						fontsize = 16
					}
					text_single = {
						fontsize = 16
						visible = "[ScopeHasVar('known_spells_count')]"
						text = "[ScopeGetVar('known_spells_count').GetValue]"
						default_format = "#underline"
						tooltipwidget = {
							known_spells_tooltip = { datacontext = "[Character.MakeScope]" }
						}
					}
					text_single = {
						text = "NONE_TEXT"
						visible = "[Not(ScopeHasVar('known_spells_count'))]"
					}
				}
				button_standard_clean = {
					size = { 250 40 }
					text = "OPEN_SPELLBOOK_AS_TEXT"
					onclick = "[GetScriptedGui('cast_on_behalf_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'target', Character.MakeScope).End)]"
					down = "[GetVariableSystem.HasValue( 'spellbook_window', 'yes' )]"
					onclick = "[GetVariableSystem.Set( 'spellbook_window', 'yes' )]"
				}
			}
		}
		vbox = {
			name = "current_spells_thrall"
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin_bottom = 15
			text_label_center = {
				text = "CURRENT_CASTING_SPELLS_TEXT"
			}

			text_single = {
				text = "NO_CAST_SPELLS_TEXT"
				default_format = "#italic"
				visible = "[IsDataModelEmpty( Character.MakeScope.GetList( 'current_spells_casting' ))]"
			}

			dynamicgridbox = {
				visible = "[Not(IsDataModelEmpty( Character.MakeScope.GetList( 'current_spells_casting' )))]"
				datamodel = "[Character.MakeScope.GetList( 'current_spells_casting' )]"
				allow_outside = yes
				item = {
					widget = {
						size = { 525 175 }
						allow_outside = yes
						background = {
							using = Background_Area
						}
						hbox = {
							margin_right = 15
							margin_left = 15
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding
							spacing = 30

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 30
									vbox = {
										spacing = 5
										text_single = {
											fontsize = 20
											align = nobaseline
											default_format = "#bold"
											text = "[Localize(Concatenate('game_concept_wc_spell_', Scope.GetFlagName))]"

											tooltipwidget = {
												widget_spell_breakdown_tooltip = {}
											}
										}

										text_single = {
											text = "DAYS_UNTIL_FINISH"
										}
									}

									button_standard = {
										text = "CANCEL_CAST_BUTTON"
										tooltip = "[GetScriptedGui('cancel_cast_sgui').ExecuteTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'spell', MakeScopeFlag(Scope.GetFlagName)).End)]"
										onclick = "[GetScriptedGui( 'cancel_cast_sgui' ).Execute(GuiScope.SetRoot(Character.MakeScope).AddScope( 'spell', MakeScopeFlag(Scope.GetFlagName)).End)]"
									}
								}
							}
						}
					}
				}
			}
		}
		vbox = {
			name = "current_spells_cd_thrall"
			layoutpolicy_horizontal = expanding
			spacing = 10
			margin_bottom = 15
			text_label_center = {
				text = "CURRENT_CD_SPELLS_TEXT"
			}

			text_single = {
				text = "NO_CD_SPELLS_TEXT"
				default_format = "#italic"
				visible = "[Not(ScopeGuiValid('wc_has_cd_spells_sgui'))]"
			}

			dynamicgridbox = {
				visible = "[ScopeGuiValid('wc_has_cd_spells_sgui')]"
				datamodel = "[Character.MakeScope.GetList( 'spells_cd' )]"
				item = {
					widget = {
						size = { 525 75 }
						background = {
							using = Background_Area
						}
						layoutpolicy_horizontal = expanding
						hbox = {
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding
							spacing = 30
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								vbox = {
									layoutpolicy_horizontal = expanding
									text_single = {
										fontsize = 20
										align = nobaseline
										default_format = "#bold"
										text = "[Localize(Concatenate('game_concept_wc_spell_', Scope.GetFlagName))]"

										tooltipwidget = {
											widget_spell_breakdown_tooltip = {}
										}
									}

									text_single = {
										text = "DAYS_UNTIL_OFF_CD"
									}
								}
							}
						}
						divider_light = {
							layoutpolicy_horizontal = expanding
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_circle.dds"
								blend_mode = alphamultiply
							}
						}
					}
				}
			}
		}
	}
}