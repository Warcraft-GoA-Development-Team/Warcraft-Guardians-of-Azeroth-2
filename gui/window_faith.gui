	type container_faith_positions = container {
		visible = "[Character.IsValid]"
		parentanchor = bottom
		text_single = {
			visible = "[GreaterThan_int32( PdxGuiWidget.AccessParent.FindChild( 'positions' ).CountVisibleChildren, '(int32)1' )]"
			margin_bottom = 2

			text = "FAITH_VIEW_NUM_FAITH_POSITIONS"
			align = nobaseline
			default_format = "#low"
			using = tooltip_sw

			tooltipwidget = {
				container = {
					using = DefaultTooltipBackground
					alwaystransparent = no

					flowcontainer = {
						ignoreinvisible = yes
						direction = vertical
						margin = { 20 10 }
						spacing = 5
						margin_bottom = 20

						text_single = {
							visible = "[ObjectsEqual( Character.GetChallenger, Character.Self )]"
							text = "FAITH_VIEW_CHALLENGER_TITLE"
						}

						text_single = {
							visible = "[IsHoF( Character )]"
							text = "[head_of_faith|E]"
						}

						text_single = {
							visible = "[IsHoR( Character )]"
							text = "[head_of_rite|E]"
						}

						text_single = {
							visible = "[And3( ObjectsEqual( Character.Self, GetPlayer.GetCapitalLocation.GetClericalRegionHolder ), Not( Character.IsLocalPlayer ), Not( IsObserver ) )]"
							text = "FAITH_VIEW_YOUR_ARCHBISHOP"
						}
					}
				}
			}
		}

		container = {
			name = "positions"

			container = {
				visible = "[ObjectsEqual( Character.GetChallenger, Character.Self )]"
			}
			container = {
				visible = "[IsHoF( Character )]"
			}
			container = {
				visible = "[IsHoR( Character )]"
			}
			container = {
				visible = "[And3( ObjectsEqual( Character.Self, GetPlayer.GetCapitalLocation.GetClericalRegionHolder ), Not( Character.IsLocalPlayer ), Not( IsObserver ) )]"
			}
		}
	}

	type button_interactions_religion = button_interactions {
		name = "religion"
		tooltip = "RELIGIOUS_INTERACTIONS_BUTTON_TOOLTIP"
	}

	# requires a name of the category and a Character
	type button_interactions = button_round {
		visible = "[And( Character.IsValid, Not( IsObserver ) )]"

		onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, ConcatIfNeitherEmpty( 'interaction_category_', PdxGuiWidget.GetName ) )]"
		tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, ConcatIfNeitherEmpty( 'interaction_category_', PdxGuiWidget.GetName ) ) )]"

		button_icon = {
			alwaystransparent = yes
			parentanchor = center
			size = { 30 30 }
			texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
		}

		text_single = {
			position = { 0 3 }
			parentanchor = bottom|hcenter

			background = {
				margin = { 5 0 }
				margin_top = -5
				using = Background_Area_Dark
			}

			text = "[GetNumberOfValidInteractionsWithFilter( Character.Self, ConcatIfNeitherEmpty( 'interaction_category_', PdxGuiWidget.AccessParent.GetName ) )]"
			default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
		}
	}

