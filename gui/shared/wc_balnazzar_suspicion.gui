types WcBalnazzarHud {
	type wc_balnazzar_suspicion_meter = widget {
		size = { 180 108 }
		parentanchor = center
		position = { 0 -48 }
		alwaystransparent = yes
		visible = "[GetScriptedGui('wc_balnazzar_suspicion_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		# Match the native stress frame and its fill offsets, without stress states.
		widget = {
			parentanchor = center
			widgetanchor = left|vcenter
			position = { -13 0 }
			size = { 60 20 }
			alwaystransparent = no
			tooltip = "WC_BALNAZZAR_SUSPICION_HUD_TOOLTIP"
			using = tooltip_ne
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.1 0.1 0.1 0.8 }
			}
			hbox = {
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					layoutstretchfactor_horizontal = "[GetProgressBarValueMaxScaled( FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('wc_balnazzar_suspicion_fraction')), '(float)1', '(int32)60' )]"
					icon = {
						size = { 100% 100% }
						alwaystransparent = yes
						texture = "gfx/interface/colors/white.dds"
						color = { 0.42 0.16 0.58 0.9 }
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							alpha = 0.25
						}
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
							blend_mode = alphamultiply
							alpha = 0.3
						}
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_rough_edges.dds"
							spriteType = Corneredtiled
							spriteborder = { 20 20 }
							blend_mode = alphamultiply
							texture_density = 5
						}
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_scratches.dds"
							blend_mode = alphamultiply
							spriteType = Corneredtiled
							alpha = 0.3
							texture_density = 3
						}
					}
					icon = {
						size = { 100% 100% }
						alwaystransparent = yes
						visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('wc_balnazzar_suspicion_value'), '(CFixedPoint)80')]"
						texture = "gfx/interface/colors/white.dds"
						color = { 0.65 0.35 0.8 1 }
						state = {
							name = suspicion_pulse_dim
							next = suspicion_pulse_bright
							trigger_on_create = yes
							duration = 1
							alpha = 0
						}
						state = {
							name = suspicion_pulse_bright
							next = suspicion_pulse_dim
							duration = 1
							alpha = 0.35
						}
					}
				}
				widget = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					layoutstretchfactor_horizontal = "[GetProgressBarValueMaxOtherScaled( FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('wc_balnazzar_suspicion_fraction')), '(float)1', '(int32)60' )]"
				}
			}
		}
		# The frame includes the dark medallion; draw the glyph above it.
		icon = {
			size = { 100% 100% }
			alwaystransparent = yes
			texture = "gfx/interface/skinned/hud_stress_bg.dds"
		}
		icon = {
			parentanchor = vcenter
			position = { 41 0 }
			size = { 35 35 }
			texture = "gfx/interface/icons/character_interactions/wc_balnazzar_suspicion.dds"
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_circle.dds"
				blend_mode = alphamultiply
			}
			alwaystransparent = no
			tooltip = "WC_BALNAZZAR_SUSPICION_HUD_TOOLTIP"
			using = tooltip_ne
		}
	}
}
