	type widget_faith_character = widget {
		size = { 175 185 }

		widget = {
			size = { 100% 100% }
			allow_outside = yes

			widget = {
				size = { 150 100% }

				widget = {
					parentanchor = center
					position = { 22 -5 }
					size = { 100 100 }

					block "head_of_faith" {}
				}

				portrait_torso = {
					visible = "[Character.IsValid]"
					size = { 100% 100% }

					blockoverride "portrait_button_size" {
						size = { 260 180 } # to not cut off their props
						position = { 15 -5 }
					}

					blockoverride "portrait_mask" {
						mask = "gfx/portraits/portrait_mask_solid.dds"
					}

					blockoverride "portrait_status_icons" {
						portrait_status_icons = {
							parentanchor = bottom|left
							position = { 40 -40 }
							scale = 0.85

							background = {
								using = Background_Area_Dark
								margin = { 2 3 }
								alpha = 0.8
							}
						}
					}

					blockoverride "coa" {}

					blockoverride "schism_stance" {
						widget_schism_stance = {}
					}

					blockoverride "opinion_box"
					{
						portrait_opinion = {
							parentanchor = bottom|hcenter
							position = { 15 -38 }
						}
					}
				}
			}

			flowcontainer = {
				parentanchor = bottom
				position = { 48 -8 }
				spacing = 5
				ignoreinvisible = yes

				text_label_center = {
					max_width = 140

					block "text" {
						text = "LOREM_IPSUM_TITLE"
					}
				}

				container_faith_positions = {}
			}

			widget = {
				size = { 100% 40 }
				alwaystransparent = no # to block character tooltips
				allow_outside = yes

				flowcontainer = {
					parentanchor = right
					position = { 0 5 }
					spacing = 12

					direction = vertical

					button_interactions_religion = {
						glow = {
							color = { 0 0 0 0.5 }
							glow_radius = 8
						}
					}

					block "interactions_extra" {}
				}
			}

			coa_title_tiny_crown = {
				visible = "[And( Character.HasLandedTitles, IsHoF( Character ) )]"
				datacontext = "[Faith.GetReligiousHeadTitle]"
				parentanchor = bottom
				position = { 2 -8 }
			}

			coa_realm_tiny_crown = {
				visible = "[And( Character.HasLandedTitles, Not( IsHoF( Character ) ) )]"
				parentanchor = bottom
				position = { 2 -8 }
			}
		}
	}

