### Brief: key ( database key )
# Name of 'tenet_type'
# Faith tenets are what defines how a faith works. All unique faith mechanics are tied to tenets, rather than involving hardcoding or special parameters on the religion itself.
#
key = {
	### Brief: icon ( optional triggered string )
	# Triggered list of icons, overriding which icon is used, set its filename here (without file ending).
	# Required path = TENET_TYPE_ICON_PATH
	# Default: Will look for icon in the path with the same name as key
	#
	# Supported scopes:
	# 	root = faith
	#
	icon = {
		trigger = { ... }			# trigger that enables specific icon

		reference = "filename"
	}

	### brief: name ( optional dynamic description )
	# Dynamic description selecting name of tenet.
	# Defaults to: <tenet_key> + "_name"
	#
	# Supported scope:
	#	root ( Faith )
	#
	name = { ... }

	### brief: desc ( optional dynamic description )
	# Dynamic description selecting description of tenet.
	# Defaults to: <tenet_key> + "_desc"
	#
	# Supported scopes:
	#	root ( Faith )
	#
	desc = { ... }

	### brief: visible ( bool )
	# Will this tenet show up in gui views?
	# Defaults to: yes
	#
	visible = yes/no

	### brief: requires_dlc_flag ( bool )
	# What dlc feature is required for this tenet to be available?
	# doesn't automatically fail is_shown checks, this only applies to code-driven tenet lists
	# Empty (not locked) by default
	#
	requires_dlc_flag = some_dlc

	### Brief: parameters ( parameter list )
	# Arbitrary parameters where bool types can be checked with the trigger: 'has_doctrine_parameter'
	# 
	parameters = {
		param_name
	}

	### Brief: piety_cost ( optional scripted cost )
	# How much does this tenet cost?
	#
	# Supported scopes:
	#	root ( Rite )
	#
	piety_cost = {
		<scripted_cost>
	}

	### Brief: is_shown ( trigger )
	# When should this tenet be shown when choosing tenets?
	#
	# Supported scopes:
	#	root ( Faith )
	#
	is_shown = {
		<triggers>
	}

	### Brief: can_pick ( trigger )
	# When can this tenet be picked when choosing tenets?
	# When tenets should refer to other selected tenets when creating a new faith (e.g. for mutually exclusive tenets), use:
	#	 flag:required_tenet = { is_in_list = selected_tenets }
	# The "selected_tenets" list is the list of tenets currently selected in the UI. (It might be different from the tenets in
	# the faith, since the player can change multiple tenets when creating a faith.)
	#
	# Supported scopes:
	#	root ( Faith )
	#	actor: the character picking doctrines (usually Head of Faith / Head of Rite). Can be null
	#
	can_pick = {
		<triggers>
	}

	### Brief: can_pick_as_personal_tenet ( trigger )
	# Can this tenet be picked as personal tenet by the character in scope?
	#
	# Supported scopes:
	#	root ( character )
	#
	can_pick_as_personal_tenet = {
		<triggers>
	}

	# Brief: divergence_multiplier: float
	# Multiplicative modifier to the divergence this item generates (Divergence * divergence_multiplier)
	# Only applied to positive divergence values
	# default is 1 (doesn't change default divergence).
	#
	divergence_multiplier = 1

	### Brief: character_modifier ( modifiers )
	# All characters of this faith get this modifier.
	# Ex: { monthly_piety_gain_mult = -0.25, same_faith_opinion = -5 }
	#
	character_modifier = {
		<modifier>
	}

	### Brief: traits ( database keys )
	# Adds additional sins/virtues. See traits in _religions.info. If a trait is already a sin or virtue in the religion, the tenet takes precedence.
	#
	traits = { ... }

	### Brief: special_parameters
	# special structure for value overrides. See _doctrine_types.info for in-depth description.
	#
	special_parameters = {
		...
	}

	### Brief: personal_tenet_modifier ( modifiers )
	# Playable characters that choose this tenet as personal get this modifier.
	#
	personal_tenet_modifier = {
		<modifier>
	}
	
	### Brief: personal_tenet_parameters ( flags )
	# Playable characters that choose this tenet as personal have these flags. 
	# Check them with the has_personal_tenet_flag trigger, localize with doctrine_parameter_ prefix.
	#
	personal_tenet_parameters = {
		flag_1
		flag_2
	}
}

# Most of the structure for tenets follows the same patter as doctrines.
# See _doctrine_types.info for an in-depth presentation on special parameters and other
#
