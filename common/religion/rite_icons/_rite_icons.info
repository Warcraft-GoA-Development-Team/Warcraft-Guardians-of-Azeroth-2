########################
# Rite Creation Icon
########################
# When making a new dynamic (non-scripted) rite, its icon will be picked from here.
# The first entry that satisfies the trigger and has available (not already picked) icons will be used 
# and a random unused icon will be picked from the list.
# If all icons have been used, the pack with the largest list will be used to extract an already-used icon.
#
key = {

	# List of keys. Will be combined with DYNAMIC_RITE_ICON_PATH (00_graphics.txt) to get the complete icon path
	custom_faith_icons = {
		icon_key_1
		icon_key_2
	}

	# Checks if this icon pack can be used with this Rite.
	# * root: 				the Rite being created
	# * scope:founder		Founder of the Rite
	# * scope:faith			the parent Faith
	#
	trigger = {
		...
	}
}
