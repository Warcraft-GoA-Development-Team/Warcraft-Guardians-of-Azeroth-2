### Brief: key ( database key )
# Name of 'doctrine_type'
# Faith doctrines are what defines how a faith works. All unique faith mechanics are tied to doctrines, rather than involving hardcoding or special parameters on the religion itself.
#
key = {
	### Brief: icon ( optional string )
	# To override which icon is used, set its filename here (without file ending).
	# Required path = DOCTRINE_TYPE_ICON_PATH
	# Default: Will look for icon in the path with the same name as key
	#
	icon = "filename"

	### brief: name ( optional dynamic description )
	# Dynamic description selecting name of doctrine.
	# Defaults to: <doctrine_key> + "_name"
	#
	# Supported scope:
	#	root ( Faith )
	#
	name = { ... }

	### brief: desc ( optional dynamic description )
	# Dynamic description selecting description of doctrine.
	# Defaults to: <doctrine_key> + "_desc"
	#
	# Supported scopes:
	#	root ( Faith )
	#
	desc = { ... }

	### brief: visible ( bool )
	# Will this doctrine show up in gui views?
	# Defaults to: yes
	#
	visible = yes/no

	### brief: divergence ( fixed point )
	# Divergence value for this particular doctrine. Impact of specific doctrine depends on how doctrine group interprets it
	# Defaults to: 0
	#
	divergence = 20

	### Brief: parameters ( parameter list )
	# Arbitrary parameters, check their existence with the trigger: 'has_doctrine_parameter'
	#
	parameters = {
		param_name_1
		param_name_2
	}

	### brief: doctrine_group_type (key)
	# what doctrine group does this doctrine belong to. Mandatory.
	#
	doctrine_group_type = some_group

	### brief: index (integer)
	# in what order should this doctrine appear in the group. This is used among other things to calculate divergence.
	# All indexes must be unique, if two are equal order of definition wins. default is 0. Can be negative
	#
	index = 0

	### Brief: piety_cost ( optional scripted cost )
	# How much does this doctrine cost?
	#
	# Supported scopes:
	#	root ( Rite )
	#
	piety_cost = {
		<scripted_cost>
	}

	### Brief: is_shown ( trigger )
	# When should this doctrine be shown when choosing doctrines?
	#
	# Supported scopes:
	#	root ( Faith )
	#
	is_shown = {
		<triggers>
	}

	### Brief: can_pick ( trigger )
	# When can this doctrine be picked when choosing doctrines?
	# When doctrines should refer to other selected doctrines when creating a new faith (e.g. for mutually exclusive doctrines), use:
	#	 flag:required_doctrine = { is_in_list = selected_doctrines }
	# The "selected_doctrines" list is the list of doctrines currently selected in the UI. (It might be different from the doctrines in
	# the faith, since the player can change multiple doctrines when creating a faith.)
	#
	# Supported scopes:
	#	root ( Faith )
	#	actor: the character picking doctrines (usually Head of Faith / Head of Rite). Can be null
	#
	can_pick = {
		<triggers>
	}

	### Brief: character_modifier ( modifiers )
	# All characters of this faith get this modifier.
	# Ex: { monthly_piety_gain_mult = -0.25, same_faith_opinion = -5 }
	#
	character_modifier = {
		<modifier>
	}

	### Brief: traits ( database keys )
	# Adds additional sins/virtues. See traits in _religion_types.info.
	# If a trait is already a sin or virtue in the religion, the trait with the biggest weight takes precedence.
	#
	traits = { ... }

	### Brief: special_parameters
	# special structure for value overrides.
	#
	special_parameters = {

		# number_of_spouses: int
		# How many spouses can people have (script restricts non-rulers to one)
		# if culture traits define an override, they will take precedence. if multiple doctrines define this the highest value is taken
		# default is -1 and will be ignored
		number_of_spouses = -1

		# number_of_consorts: int
		# How many consorts can rulers have (script restricts non-rulers to zero)
		# if culture traits define an override, they will take precedence. if multiple doctrines define this the highest value is taken
		# default is -1 and will be ignored
		number_of_consorts = -1

		# divine_marriage_opinion: int
		# If married to someone in your extended family, you get this opinion bonus with direct vassals
		# default is 0
		#
		divine_marriage_opinion = 0

		# minimum_fervor: int
		# Fervor cannot go below this value. if multiple doctrines define this the highest value is taken
		# default is -1 and will be ignored
		#
		minimum_fervor = 0

		# fervor_per_holy_site: float
		# yearly fervor gain per holy site held. if multiple doctrines define this the highest value is taken
		# default is 0
		#
		fervor_per_holy_site = 0

		# bonus_fervor_gain: float
		# flat additional yearly fervor gain. if multiple doctrines define this the highest value is taken
		# default is 0
		#
		bonus_fervor_gain = 0
		
		# bonus_heresy_protection: int
		# additional negated heresies. if multiple doctrines define this the highest value is taken
		# default is 0
		#
		bonus_heresy_protection = 0

		# divergence_protection: float
		# Negates fervor loss due to divergent rites. if multiple doctrines define this the highest value is taken
		# default is 0
		#
		divergence_protection = 0

		# heresy_threshold: float
		# changes the default threshold value for heretic rites. This value is additive between doctrines
		# default is 0
		#
		heresy_threshold = 0

		# hostility override map depending on the relation between the other faith and this one.
		# See the "hostility" section for more info
		#
		hostility_levels = {

			# same_religion: How hostile is this faith towards other faiths of the same religion?
			same_religion = astray

			# How hostile is this faith towards other faiths of the same religion family, but not same religion?
			same_family = hostile

			# How hostile is this faith towards faiths from different religion families?
			unrelated = evil
		}

		# hostility override map depending on whether the target faith has the given doctrine
		#
		hostility_level_override = {
			doctrine_key = astray
		}

		# How hostile is this faith towards faith who they share Head of Faith with? Takes precedence over other hostility overrides.
		# has no default
		#
		same_hof_hostility_override = righteous

		# hostility override map depending on whether the target faith has the given parameter
		#
		parameter_opinion_override = {
			# Has this opinion apply to people with faiths with the given doctrine parameter.
			# Loc for the opinion tooltip is doctrine_parameter_<parameter_key>_opinion_active
			parameter_key = 10
		}

		# hostility_towards_us_mult: float
		# Multiplies the hostility opinion defined in HOSTILITY_OPINION_EFFECTS (defines.txt).
		# Does not work as an additive multiplier - writing '1' means the opinion is unchanged, not doubled.
		# default = 1
		#
		hostility_towards_us_mult = 1

		# piety_from_long_peace: float
		# How much piety will the character get when they've been at peace for longer than NReligion::TIME_AT_PEACE_FOR_PIETY.
		# Can be negative
		#
		piety_from_long_peace = 0.5

		# allowed_holding_types: list of holding types
		# This holding type can be held by rulers of this faith even if their government would not allow it.
		#
		allowed_holding_types = { church_holding }

		# unreformed: boolean
		# This is an unreformed faith. This means that "[Faith.IsUnreformed]" in the data system will return true.
		# It also means that when creating a "new" faith (reforming), you keep the same icon and name, while your current faith gets renamed to its
		# 	loc key + "_old", and its icon changed to its icon + "_old". Ensuring reformation can only happen once is your responsibility;
		#	it is not handled in code. The AI will also reform if they meet all the requirements, though do not actively attempt to fulfill them.
		# When reforming, they'll use the same doctrines as they had before, minus the "unreformed" doctrine (assuming of course that you've set it up to not be selectable)
		# default = no
		#
		unreformed = no

		# vassals and counties of the same faith will get at peace opinion penalty instead of offensive war opinion penalty
		# default = no
		#
		warmonger = no

		# increased_dynasty_prestige_birth_mult: float
		# A multiplier for the prestige that characters of this faiths are born.
		# default = 0
		#
		increased_dynasty_prestige_birth_mult = 0

		# increased_dynasty_prestige_marriage_mult: float
		# A multiplier for the prestige that characters get from marriages, if both have this parameter (a minimum of their values will be used)
		# default = 0
		#
		increased_dynasty_prestige_marriage_mult = 0

		# increased_dynasty_prestige_long_reign_mult: float
		# A multiplier for the maximum of years for the long reign opinion.
		# default = 0
		#
		increased_dynasty_prestige_long_reign_mult = 0
	}
}

#########################
# == Hostility ==
#########################
# All rites have a hostility level towards one another. What each level means is entirely scriptable.
# The levels are, in increasing order of hostility:
#	* righteous (0)
#	* astray	(1)
#	* hostile	(2)
#	* evil		(3)
#
# A rite always has a 'righteous' hostility level towards itself.
# If no override is defined the target rite will be considered to be righteous
#
# The opinion effect of hostility is defined by the define HOSTILITY_OPINION_EFFECTS.
# The multiplier applied to tolerance_advantage_mod is defined by the define HOSTILITY_COMBAT_MOD_MULT.
# The name of each hostility level is defined by the define HOSTILITY_LEVEL_NAMES
#
# Hostility level can be accessed in script. E.G., faith_hostility_level = { target = scope:some_faith value >= 1 } or rite_hostility_level = { target = scope:some_rite value >= 1 }.
# You can also compare to see which faith you're most hostile to. E.G., faith_hostility_level_comparison = { scope:some_faith > scope:some_other_faith }
#
#
#########################
# == Precedence ==
#########################
# Order of definition; later definition, higher precedence.
#
# The following values will take the highest:
# 	* number_of_spouses
# 	* number_of_consorts
# 	* divine_marriage_opinion
# 	* minimum_fervor
# 	* fervor_per_holy_site
#	* hostility_towards_us_mult
#
#	Allowed Holding Types and all maps are merged (but if multiple values are defined for the same entry the latest wins)
#
#	unreformed and warmonger: will be 'yes' if any one doctrine or core_tenet defines them as 'yes'
#
#
#########################
# == Localisation ==
#########################
# Effects are localized based on the parameter name. "doctrine_parameter_" plus the name.
# Special parameter values have their own localization keys.
#
#
#########################
# == Triggers ==
#########################
# Used in rite scope:
# 	rite_has_doctrine = doctrine_name
# Used in faith scope:
# 	has_doctrine_parameter = parameter_name
#
#########################
# == Further requirements ==
#########################
# Further restrictions on faith creation can be added using the faith_creation scripted rule.
