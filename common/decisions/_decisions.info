=== Notes ===

Decisions are sorted by the order in the script files (and thus the order of the script files themselves).

Major decisions are highlighted in the list, and will be considered important by default.
Important decisions will spawn an Action when they can be taken. The player can change whether or not a decision type is important to them.

=== Structure ===

<decision key> = {

	### Override title
	#
	# Can either be a key or a dynamic description.
	# If left undefined then the decision key is used to get a loc string.
	#
	title = <localization key> | <dynamic description>

	### Picture
	# A picture to use for the decision.
	# In case that there are multiple the first one that fits the trigger will be the one selected.
	picture = {
		### Picture requirements
		# Receives the character scope to check if it's valid.
		# Empty triggers always pass on default so do not type a trigger if you want it to always succeed.
		trigger = <triggers>

		### Illustration to show
		#
		# Path to the texture
		#
		reference = <file path>

		### Sound effect
		#
		# Name of the sound effect played when showing the decision details
		#
		# Default: "event:/SFX/UI/Generic/Windows/sfx_ui_generic_window_standard_show"
		#
		soundeffect = <sfx key>
	}

	### Additional illustration
	#
	# Associate a second image to the decision.
	# Usage example: Struggle decision buttons.
	#
	extra_picture = <file path>

	### Confirm click sound
	#
	# Sound effect played when clicking the button that confirms the decision.
	#
	confirm_click_sound = <sfx key>

	### Decision group
	#
	# Foldable decision group type to put this decision in. Default or not specified will select 'decisions'
	#
	decision_group_type = <key>

	### Visibility in decisions panel
	#
	# Can be used to hide decisions from the decisions view.
	# Mainly intended for decisions that show up somewhere else
	# (like struggle and house unity decisions).
	#
	is_invisible = <yes/no>

	### progress
	#
	# A value in range 0-100 representing how close to taking this decision a ruler is.
	# This us used for the progress bar in the Ruler Objective view.
	# root: Ruler (character)
	#
	progress = <scripted value>

	### advice
	# Collection of advice, with their shared configuration.
	#
	advice = {

		### Region
		#
		# The region to source potential target titles from when
		# producing Ruler Objective advice.
		# Every piece of advice (aka. every hint) will be evaluated with
		# every title in this region, and the best title for the advice
		# will be selected for that advice.
		#
		region = <geographical region>

		## Advice applied per title
		#
		# A piece of advice to evaluate for all titles in the geographical region.
		#
		# Shared scopes:
		#  - root (Character)  Decision taker (player character).
		#  - title (Title) The title to evaluate.
		#  - doing (yes/no) Is the player already doing this? (added after the corresponding trigger)
		#
		# TODO_TGP: Deprecated. Migrate to ruler objective type database so what we can remove this.
		#
		per_title_hint = {

			### Relevant advice?
			#
			# Is this at all relevant advice for the provided title?
			# (Note: Renamed to is_valid_for_title in the advice database)
			#
			is_valid = <triggers>

			### Already doing it?
			#
			# Is the player currently doing what this advice recommends with the provided title?
			#
			# The result of this trigger is added to the scope as 'doing',
			# and is available to all evaluations below this one.
			# Advice that the player is already following is always preferred
			# over new recommendations.
			#
			is_doing = <triggers>

			### Relevance
			#
			# How valuable this this advice with the given title.
			#
			# Higher value is better advice, and top ones are presented to the player.
			# Advice where the best variants relevance is lower than the define
			# ADVICE_RELEVANCE_LIMIT (default 0) is ignored entirely.
			#
			relevance = <script value>

			### Advice summary
			#
			# Short 'call to action' displayed on the advice button in the UI.
			#
			summary = <dynamic desc>

			### Advice description
			#
			# Detailed explanation on what the player is advised to do,
			# how to do it, and why it is may be a good idea.
			#
			description = <dynamic desc>
		}
	}

	### AI goal
	#
	# If set, the AI will consider the decision a "goal" and consider it alongside major costs like title creation and holding construction.
	# It will ignore ai_check_interval. Should only be used for things with such major costs that budgeting for it is important,
	# as it is less performant than using a high ai_check_interval.
	#
	ai_goal = <yes/no>


	### AI reevaluation interval
	#
	# How many months to go between each check of this decision.
	# Has to be set (or 'ai_check_interval_by_tier'), except if ai_goal = yes is set.
	# An interval of 0 means the AI will never check this decision.
	#
	ai_check_interval = <integer>


	### AI reevaluation by tier
	#
	# How often should the ai check this decision by tier of top title (in months).
	# '0' means it is never considered.
	# Used instead of 'ai_check_interval'.
	# All tiers are required to be defined.
	#
	ai_check_interval_by_tier = {
		barony = <integer>
		county = <integer>
		duchy = <integer>
		kingdom = <integer>
		empire = <integer>
		hegemony = <integer>
	}

	### Sort order
	#
	# The order that the decision should show up in the decision view relative to other decisions,
	# higher number is sorted first, tie breaking is on definition order if same sort order
	#
	sort_order = <integer>

	### Selection tooltip
	#
	# Override tooltip when selecting the decision from the decision list.,
	# 
	# Default: "<description key>_tooltip"
	#
	selection_tooltip = <localization key> | <dynamic description>

	### Override description
	#
	# Default: "<description key>_desc"
	#
	desc = <localization key> | <dynamic description>

	### Override confirm "verb"
	#
	# Override text on the button that confirms the decision.
	#
	# Default: "<description key>_confirm"
	#
	confirm_text = <localization key> | <dynamic description>

	### Who *might* take this decision?
	#
	# Check if this decision should even be presented as an option for a character.
	#
	# Scopes:
	#  - root (Character) ruler to check this for
	#  - scope:puppeteer (Character) ruler that might be initiating the decision through root as puppet.
	#
	# Default: Yes
	#
	is_shown = <triggers>

	### Who *could* actually take this decision?
	#
	# Check if this a character can actual take this decision; all requirements are listed.
	# Decision taken is also limited by 'is_valid_showing_failures_only', and 'cost'.
	#
	# Scopes:
	#  - root (Character) ruler to check this for
	#  - scope:puppeteer (Character) ruler that might be initiating the decision through root as puppet.
	#
	# Default: Yes
	#
	is_valid = <triggers>

	### Who *could* actually take this decision (with limited tooltip)?
	#
	# Check if this a character can actual take this decision,
	# but unlike 'is_valid' above we only show wailing requirements.
	#
	# Scopes:
	#  - root (Character) ruler to check this for
	#  - scope:puppeteer (Character) ruler that might be initiating the decision through root as puppet.
	#
	# Default: yes
	#
	is_valid_showing_failures_only = <triggers>

	### Decision cost
	#
	# What amount of resources are consumed when a character takes this decision.
	#
	# Scopes:
	#  - root (Character) ruler to check this for
	#  - scope:puppeteer (Character) ruler that might be initiating the decision through root as puppet.
	#
	cost = {
		gold = <scripted value>
		piety = <scripted value>
		prestige = <scripted value>
		# Also supported: renown, influence, herd, treasury, treasury_or_gold, merit, barter_goods
		round = <yes/no>			# Round the calculated costs. Default: yes
		clamp_to_zero = <yes/no>	# Clamp negative calculated costs to 0. Default: yes
	}

	### Cooldown
	#
	# Duration ({ days/months/years = <script value> }) after taking the decision before it can be taken again.
	# The cooldown is added before 'effect' is executed.
	#
	cooldown = { years = 5 }


	minimum_cost = {}				# Like 'cost', except this doesn't get applied. It'll block taking the decision if not affordable. For use in places that apply the cost after the fact based on player input and the like

	should_create_alert = {			# Should this decision have an alert made for it, applied on top of the usual requirements that the decision will be alerted for
		...
	}

	effect = { ... }				# effect to execute when decision is taken; scope: character

	ai_potential = { ... }			# trigger whether the AI should look at it or not
	ai_will_do = { ... }			# Returns the % chance of executing the decision. 0 will never execute it, 100 will always execute it. Will also determine the default option (if the decision has those) for players .

	# Specify up to one custom widget to embed in the decision. See section about Custom Widgets below.
	widget = {
		# Name of the widget to use. Must be at the path <decision_view_widgets>/<widget_name>.gui
		gui = "<widget_name>"
		# Some widgets require a custom controller (see below). Default: default
		controller = "<controller_type>"

		show_from_start = yes # Shows the option list from the very beginning of the decision window flow

		# Container selection for decision_option_list_controller (see GetCustomWidgetName in code):
		#  - show_from_start = yes: custom_widgets_container (option list from the first screen).
		#  - else if decision_to_second_step_button is unset/empty: additional_widgets_desc_container
		#    (description first, then confirm to reach the widget).
		#  - else: custom_widgets_container after the confirmation step.
		# When show_from_start = yes, decision_to_second_step_button must still be set (validated at load).

		# Loc key for the button that moves from the description to the second step (the widget)
		decision_to_second_step_button = <localization key>

		### 'create_holy_order', 'revoke_holy_order_lease' and 'select_[tier]_title[_in_realm]' controller option
		# Trigger for which titles can be selected.
		#
		# root = title being evaluated (a barony for the holy order controllers)
		# scope:ruler = character taking the decision
		title_valid = {}

		# One or more options (add an item = {} entry for each option)
		# Available if you have `controller = decision_option_list_controller`
		item = {
			value = entry_name			# is used in effect section
			is_shown = trigger 			# is entry shown
			is_valid = trigger 			# is entry selectable
			current_description = desc 	# tooltip info
			localization = loc_key 		# what should be shown in the list
			is_default = bool	 		# is the default entry to pick
			icon = "icon/file/path.dds"	# path to the icon
			flat = no					# is icon flat black and needs a special widtet, or is it full color

			# Which item should the AI use (+ which is the default for the player)
			# NOTE! The highest scoring item is selected - there is no randomization.
			# This is also used to select the default option for players. To get a proper "decision available"
			# notification for each item, make sure that the item has the highest score if it is available!
			ai_chance = score
		}

		### 'select_scope_object' controller option
		# Setup effect for the list of items that are available for the current actor (player interface only)
		#
		# root = none
		# scope:actor = current actor
		#
		# Add items to list by using `add_to_list = item_list` in the effect
		setup_items = {}

		### 'select_scope_object' controller option
		# Select effect for the item that is the default selected item of all generated items (player interface only). Defaults to first item.
		#
		# root = none
		# scope:actor = current actor
		#
		# Select item by using `save_scope_as = selected_item`
		default_item = {}

		### 'select_scope_object' controller option
		# Select effect for the item that is selected item for an AI doing this decision.
		# (Quick AI logic that does not use `setup_items` or `ai_item_will_do`)
		#
		# root = none
		# scope:actor = current actor
		#
		# Select item by using `save_scope_as = selected_item`
		ai_select_item = {}

		### 'select_scope_object' controller option
		# Calculate an AI weight for each option from 'setup_items'. Will not be used if `ai_select_item` is defined.
		# Items with weights of 0 or lower are automatically discarded.
		#
		# root = item scope
		# scope:actor = current actor
		ai_item_will_do = {}

		### 'select_scope_object' controller option (optional)
		# Trigger to determine if an item from 'setup_items' is valid.
		# Invalid items are shown but disabled (greyed out, not clickable), with a tooltip explaining why.
		# If not defined, all items are valid.
		#
		# root = item scope
		# scope:actor = current actor
		is_item_valid = {}
	}
	widget = "<controller_type>"	# alternative short syntax, gui will be "decision_view_widget_<controller_type>"
	# If gui is not set, it defaults to "decision_view_widget_<controller_type>", except select_[tier]_title[_in_realm] -> "decision_view_widget_select_title" and revoke_holy_order_lease -> "decision_view_widget_create_holy_order"
}

# === Custom Widgets ===
# 
# A custom widget can be embedded into a decision.
# GUI files must be placed at the decision_view_widgets path (see paths.settings). The name of the file must match the widget name.
# 
# Usually these widgets require a custom controller. This should be documented in the widget's GUI file.
# The data context type available in the GUI depends on the controller type.
# 
# Available controllers:
# 
# Controller Type						| Data Context Name				  		| Notes
# ------------------------------------+---------------------------------------+-----------------------------------------------------------
# default								| EventWindowWidget				  		| Default controller, no special behavior
# create_holy_order 					| DecisionViewWidgetSelectBarony	  	| Show GUI to customize the new holy order.
# revoke_holy_order_lease				| DecisionViewWidgetSelectBarony	  	| Same GUI as create_holy_order (gui defaults to "decision_view_widget_create_holy_order"); selection available as scope:barony
# decision_option_list_controller 	 	| DecisionViewWidgetOptionList 			| Shows a GUI to pick an option that sets a flag for the effect, see the `item = { ... }` description above
# select_scope_object					| DecisionViewWidgetSelectScopeObject	| List of scope objects items; selection available as scope:selected_item in effects
# select_[tier]_title 					| DecisionViewWidgetSelectTitleOfTier  	| List of landed titles of the specified tier in the world. selection available as scope:title
# select_[tier]_title_in_realm			| DecisionViewWidgetSelectTitleOfTier  	| List of landed titles of the specified tier in the character's realm (more performant if you want to only filter realm titles). selection available as scope:title
#	select_barony_title
#	select_county_title
#	select_duchy_title
#	select_kingdom_title
#	select_empire_title
#	select_hegemony_title
#
