                        blend_mode = colordodge
                        spriteType = corneredTiled
                    }

                    state = {
                        trigger_on_create = yes
                        name = a
                        next = b
                        duration = 0

                        modify_texture = {
                            name = "shimmer"
                            translate_uv = { -0.1 0 }
                            alpha = 0.1
                            rotate_uv = 0
                        }

                        modify_texture = {
                            name = "shimmer_2"
                            translate_uv = { 0.1 0 }
                            alpha = 0.3
                            rotate_uv = 0
                        }

                        modify_texture = {
                            name = "shimmer_3"
                            translate_uv = { 1 0 }
                            alpha = 0.1
                        }

                        modify_texture = {
                            name = "shimmer_4"
                            translate_uv = { -1 0 }
                            alpha = 0.5
                        }
                    }

                    state = {
                        name = b
                        next = c
                        duration = 10

                        modify_texture = {
                            name = "shimmer"
                            translate_uv = { 0.1 0 }
                            alpha = 0.3
                            rotate_uv = 180
                        }

                        modify_texture = {
                            name = "shimmer_2"
                            translate_uv = { -0.1 0 }
