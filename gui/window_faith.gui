	type widget_doctrine_divergence_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground

		vbox = {
			set_parent_size_to_minimum = yes
			margin = { 18 18 }
			spacing = 5

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "RITE_CREATION_DOCTRINE_DIVERGENCE_TT"
			}

			vbox = {
				ignoreinvisible = yes
				layoutpolicy_horizontal = expanding
				datacontext = "[DoctrineItem.GetFaith]"
				datamodel = "[Faith.GetDoctrines]"

				item = {
					text_single = {
						visible = "[ObjectsEqual( DoctrineType.GetGroup, DoctrineItem.GetDoctrine.GetGroup )]"
						layoutpolicy_horizontal = expanding
						text = "FAITH_VIEW_MAINLINE_DOCTRINE"
					}
				}
			}

			textbox = {
				visible = "[DoctrineItem.GetDoctrine.GetGroup.IsOnlyForMainRite]"
