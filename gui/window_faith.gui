	type text_doctrine_knowledge = text_single {
		autoresize = no

		text = "[SelectLocalization( GetPlayer.KnowsDoctrine( DoctrineType.Self ), 'doctrine_status_known', 'doctrine_status_unknown' )]"
		alpha = "[Select_float( GetPlayer.KnowsDoctrine( DoctrineType.Self ), '(float)1.0', '(float)0.5' )]"
		align = nobaseline|right
	}

	type hbox_doctrine_status_item = hbox {
		layoutpolicy_horizontal = expanding
		margin = { 5 0 }
		margin_right = 10

		background = {
			using = Background_Area
			alpha = 0.6
		}

		background = {
			visible = "[Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self )]"
			margin_bottom = 0
			margin_top = -2

			using = Status_Good
			using = Color_Blue
			alpha = 0.25
		}

		background = {
			visible = "[And( Rite.HasDoctrine( DoctrineType.Self ), Not( Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ) ) )]"
			margin_bottom = 0
			margin_top = -2

			using = Status_Good
			using = Color_Bright_Yellow
			alpha = 0.25
		}

		tooltipwidget = {
			using = doctrine_type_tooltip
		}
		block "doctrine_tooltip_placement" {}

		block "doctrine_name" {
			text_single = {
				visible = "[Rite.HasDoctrine( DoctrineType.Self )]"
				layoutpolicy_horizontal = expanding
				autoresize = no
				min_height = 24

				text = "[DoctrineType.GetNameNoTooltip( Faith.Self )|V]"
				align = nobaseline
			}

			text_single = {
				visible = "[And( Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ), Not( Rite.HasDoctrine( DoctrineType.Self ) ) )]"
				layoutpolicy_horizontal = expanding
				autoresize = no
				min_height = 24

				text = "[DoctrineType.GetNameNoTooltip( Faith.Self )]"
				align = nobaseline
			}

			text_single = {
				visible = "[Not( Or( Rite.HasDoctrine( DoctrineType.Self ), Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ) ) )]"
				layoutpolicy_horizontal = expanding
				autoresize = no
				min_height = 24

				text = "[DoctrineType.GetNameNoTooltip( Faith.Self )]"
				alpha = "[Select_float( GetPlayer.KnowsDoctrine( DoctrineType.Self ), '(float)1.0', '(float)0.5' )]"
				align = nobaseline
			}
		}


		widget = {
			size = { 140 24 }

			block "doctrine_status_text"
			{
				text_single = {
					visible = "[And( Rite.HasDoctrine( DoctrineType.Self ), Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ) )]"
					size = { 100% 100% }
					autoresize = no

					text = "doctrine_status_rite_mainline"
					default_format = "#high"
					align = nobaseline|right
				}

				text_single = {
					visible = "[And( Rite.HasDoctrine( DoctrineType.Self ), Not( Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ) ) )]"
					size = { 100% 100% }
					autoresize = no

					text = "doctrine_status_rite"
					default_format = "#high"
					align = nobaseline|right
				}

				text_single = {
					visible = "[And( Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ), Not( Rite.HasDoctrine( DoctrineType.Self ) ) )]"
					size = { 100% 100% }
					autoresize = no

					text = "doctrine_status_mainline"
					align = nobaseline|right
				}
			}

			block "doctrine_status_knowledge" {
				text_doctrine_knowledge = {
					visible = "[Not( Or( Rite.HasDoctrine( DoctrineType.Self ), Rite.GetFaith.GetMainRite.HasDoctrine( DoctrineType.Self ) ) )]"
					size = { 100% 100% }
				}
			}
		}

		block "main_doctrine_known" {}
	}

	type vbox_expanded_doctrine_group = vbox {
		layoutpolicy_horizontal = expanding
		margin = { 0 5 }
		spacing = 2

		hbox = {
			layoutpolicy_horizontal = expanding
			min_height = 35

			background = {
				using = Background_Area_Solid
