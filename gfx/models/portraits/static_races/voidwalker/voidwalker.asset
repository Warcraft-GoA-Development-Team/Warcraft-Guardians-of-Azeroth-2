###Transformation I applied in Blender to WoW model

###Rotation
#Z -90

###Size
#60

###voidwalker
pdxmesh = {
	name = "voidwalker_mesh"
	file = "voidwalker.mesh"

	meshsettings = {
		name = "voidwalkerShape"
		index = 0
		texture_diffuse = "voidwalker.dds"
		texture_normal = "default_yellow_normal.dds"
		texture_specular = "male_elven_eyebrows_0_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}
entity = {
	name = "voidwalker_entity"
	pdxmesh = "voidwalker_mesh"
}

# Baby Voidwalker

###babyvoidwalker_blue
pdxmesh = {
	name = "babyvoidwalker_mesh"
	file = "babyvoidwalker.mesh"

	meshsettings = {
		name = "babyvoidwalkerShape"
		index = 0
		texture_diffuse = "babyvoidwalker_blue.dds"
		texture_normal = "default_yellow_normal.dds"
		texture_specular = "male_elven_eyebrows_0_properties.dds"
		shader = "portrait_attachment_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}
entity = {
	name = "babyvoidwalker_blue_entity"
	pdxmesh = "babyvoidwalker_mesh"
}