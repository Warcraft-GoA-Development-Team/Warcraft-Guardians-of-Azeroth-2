types CourtPositionTooltips {
	type court_position_effect = vbox {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		margin_bottom = 10

		background = {
			layoutpolicy_horizontal = expanding
			using = Background_Area
			margin = { 15 0 }
			margin_top = 5
		}

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding

			text_single = {
				layoutpolicy_horizontal = expanding

				block "position_title" {}

				fonttintcolor = "[TooltipInfo.GetTintColor]"
				default_format = "#S"
			}

			vbox = {
				margin = { 10 0 }
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				textbox = {
					layoutpolicy_horizontal = expanding

					using = DefaultTooltipText

					block "position_desc" {}

					fonttintcolor = "[TooltipInfo.GetTintColor]"
					alwaystransparent = no
					multiline = yes
				}
			}
		}
	}

	# Tooltip when examining the court position type.
	type court_position_type_tooltip = object_tooltip_pop_out {

		blockoverride "title_text" {
			block "title_text_inner" {
				datacontext = "[GetPlayer]"
				text = "[CourtPositionType.CalcTriggeredNameNoTooltip( Character.Self )]"
			}
		}

		blockoverride "concept_link" {
			text = "[SelectLocalization(IsLandlessAdventurer( GetPlayer ) , 'OFFICER', 'COURT_POISTION' )]"
		}

		blockoverride "header_additions"
		{
			header_icon = {
				blockoverride "header_texture"
				{
					texture = "[CourtPositionType.GetIcon]"
				}
			}
		}

		blockoverride "main_description" {
			vbox = {
				spacing = 4
				layoutpolicy_horizontal = expanding

				vbox = {
					name = "liege_info"
					layoutpolicy_horizontal = expanding

					spacing = 8

					cooltip_paragraph = {
						visible = "[CourtPositionType.HasLiegeModifiers]"

						text = "COURT_POSITION_TOOLTIP_EFFECT_ON_LIEGE_WITH_HEADING"

						layoutpolicy_horizontal = expanding
					}

					cooltip_paragraph = {

						visible = "[CourtPositionType.HasLiegeCourtModifiers]"

						text = "COURT_POSITION_TYPE_EMPLOYER_COURT_EFFECTS"

						layoutpolicy_horizontal = expanding
					}

					vbox = {
						name = "tasks"
						layoutpolicy_horizontal = expanding
						spacing = 4

						visible = "[Not( IsDataModelEmpty( CourtPositionType.GetTasks ) )]"

						cooltip_paragraph = {
							text = "COURT_POSITION_TASK_HINT"
							default_format = "#S"
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							block "tasks" {
								fixedgridbox = {
									name = "task_items"

									addcolumn = 38
									addrow = 38
									setitemsizefromcell = yes
									datamodel_wrap = 4
									flipdirection = yes

									datamodel = "[CourtPositionType.GetTasks]"
									item = {
										widget_court_position_task_view = {
											blockoverride "click_to_activate" {}
										}
									}
								}
							}	

							expand = {}
						}							
					}


					cooltip_paragraph = {
						text = "COURT_POSITION_TOOLTIP_LIEGE_REQUIREMENT_NESTED"
						visible = "[CourtPositionType.HasLiegeRequirements]"
					}				
				}

				vbox = {
					name = "cost_and_payments"
					layoutpolicy_horizontal = expanding

					margin = { 0 8 }

					background = {
						using = Background_Area
						margin = { 16 0 }
					}

					cooltip_paragraph = {
						text = "COURT_POSITION_TYPE_TOOLTIP_EMPLOYER_SALARY"
						align = nobaseline
					}

					cooltip_paragraph = {
						text = COURT_POSITION_TYPE_TOOLTIP_REVOKE_COST
						align = nobaseline
					}

					cooltip_paragraph = {	
						name = "powerful_agent"

						visible = "[CourtPositionType.IsPowerfulAgent]"

						text = "COURT_POSITION_POWERFUL_AGENT"
						align = nobaseline
					}	

				}

				vbox = {
					name = "employee_info"
					layoutpolicy_horizontal = expanding

					spacing = 8

					cooltip_paragraph = {
						visible = "[CourtPositionType.HasEmployeeModifiers]"

						text = "COURT_POSITION_TYPE_TOOLTIP_EFFECT_ON_EMPLOYEE_WITH_HEADING"

						layoutpolicy_horizontal = expanding
					}
					
					cooltip_paragraph = {
						text = COURT_POSITION_TOOLTIP_EMPLOYEE_REQUIREMENT_NESTED
						visible = "[CourtPositionType.HasEmployeeRequirements]"
					}

					# overridden with empty block
					block "time_of_service" {
						cooltip_paragraph = {
							visible = "[CourtPosition.IsValid]"
							text = "[CourtPosition.GetTimeOfService]"
							default_format = "#weak"
						}
					}

				}

				vbox = {
					name = "flavor"

					margin = { 0 8 }

					background = {
						using = Background_Area
						margin = { 16 0 }
						margin_bottom = 18
					}

					cooltip_paragraph = {
						name = "flavor_text"

						datacontext = "[GetPlayer]"

						text = "[CourtPositionType.CalcTriggeredDescription( Character.Self )]"
						default_format = "#F"
					}
				}
			}
		}
	}
}

