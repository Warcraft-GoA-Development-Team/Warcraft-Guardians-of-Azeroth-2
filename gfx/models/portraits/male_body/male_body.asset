entity = {
	name = "male_body_entity"
	pdxmesh = "male_body_mesh"
	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
			portrait_decal = {
				body_part = torso
			}
		}
	}

	attribute = { name = "body_height" 													additive_animation = "body_height" default = 0.5 }
	attribute = { name = "body_infant_proportions" 										additive_animation = "body_infant_proportions" default = 0.5 }
	attribute = { name = "body_no_left_arm" 											additive_animation = "body_no_left_arm" default = 0.5 }
	attribute = { name = "body_no_left_leg" 											additive_animation = "body_no_left_leg" default = 0 }
	attribute = { name = "body_hunchbacked" 											additive_animation = "body_hunchbacked" default = 0.5 }
	attribute = { name = "body_clubfooted" 												additive_animation = "body_clubfooted" default = 0.5 }
	# attribute = { name = "body_no_body" 												additive_animation = "body_no_body" default = 0 }

	attribute = { name = "body_body_shape_apple" 										additive_animation = "body_body_shape_apple" default = 0.5 }
	attribute = { name = "body_body_shape_hourglass" 									additive_animation = "body_body_shape_hourglass" default = 0.5 }
	attribute = { name = "body_body_shape_pear" 										additive_animation = "body_body_shape_pear" default = 0.5 }
	attribute = { name = "body_body_shape_rectangle" 									additive_animation = "body_body_shape_rectangle" default = 0.5 }
	attribute = { name = "body_body_shape_triangle" 									additive_animation = "body_body_shape_triangle" default = 0.5 }

	attribute = { name = "body_dwarf" 													additive_animation = "body_dwarf" default = 0 }
	attribute = { name = "body_fat" 													additive_animation = "body_fat" default = 0 }
	attribute = { name = "body_cloak" 													additive_animation = "body_cloak" default = 0 }

	# Warcraft
	attribute = { name = "body_digitigrade"												additive_animation = "body_digitigrade" }
	attribute = { name = "bs_body_hooves"												blend_shape = "male_bs_body_hooves" }
	attribute = { name = "bs_body_harpy"												blend_shape = "male_bs_body_harpy" }
	attribute = { name = "bs_tauren_hooves"												blend_shape = "male_bs_tauren_hooves" }

	attribute = { name = "bs_body_fat_1"												blend_shape = "male_bs_body_fat_1" }
	attribute = { name = "bs_body_gaunt_1"												blend_shape = "male_bs_body_gaunt_1" }
	attribute = { name = "bs_body_muscular_1"											blend_shape = "male_bs_body_muscular_1" }
	attribute = { name = "wc_muscle_surface" blend_shape = "wc_extended_male_bs_body_muscular_1" }
	attribute = { name = "bs_body_old_1"												blend_shape = "male_bs_body_old_1" }

	attribute = { name = "bs_body_dwarf_1"												blend_shape = "male_bs_body_dwarf_1" }
	attribute = { name = "bs_body_infant_1"												blend_shape = "male_bs_body_infant_1" }
	attribute = { name = "bs_body_clothed"												blend_shape = "male_bs_body_clothed" }

	attribute = { name = "bs_body_no_portrait"											blend_shape = "male_bs_body_no_portrait" }
	attribute = { name = "bs_body_no_left_leg"											blend_shape = "male_bs_body_no_left_leg" }

	attribute = { name = "bs_body_seated"												blend_shape = "male_bs_body_neutral" }

	# Warcraft
	attribute = { name = "bs_fingers_troll"												blend_shape = "male_bs_troll_fingers" }

	attribute = { name = "bs_body_shrink_chest"											blend_shape = "male_bs_body_shrink_chest" }
