				margin = { 0 5 }
				text = "[Situation.GetNameNoTooltip]"
				default_format = "#T"
			}

			blockoverride "main_description" {
				vbox = {
					name = "current_phase_information"
					datacontext = "[Situation.GetTopSubRegion.GetCurrentPhase]"
