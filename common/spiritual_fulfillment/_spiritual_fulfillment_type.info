####
# Spiritual fulfillment types
#
#	These objects are defined similarly to Legitimacy types, but they relate to the Current Spiritual Fulfillment of any character.
#	the Fulfillment Type will determine the thresholds, parameters and modifiers for characters of the correct faiths
#

# name for this type of fulfillment type. Level names (and modifier names) will be built with a "<key>_level_<index>" loc key,
# falling back to "default_fulfillment_level_<index>". The index is the level's position after sorting by threshold, starting at 0.
key = {

	# which religions are valid for this type.
	# Make sure no two types overlap as this is the only element that maps character to fulfillment types.
	# Leave one type with an empty religion list as a fallback.
	religions = {
		christianity_religion
	}

	# one of the levels for this type. They don't need to be sorted, but they need to have unique thresholds between min and max.
	level = {

		# the threshold above (or below) which this level is active. Must be between min and max spiritual fulfillment (defined in defines.txt).
		# for negative thresholds, the fulfillment must be equal or below to activate the level.
		# for positive thresholds the fulfillment must be equal or above.
		# a level with threshold 0 is the neutral level, used when no other level matches.
		# default is MIN_SPIRITUAL_FULFILLMENT
		threshold = 0

		# the modifier that will be applied to the character when this level is active.
		modifier = {
			monthly_piety_gain_mult = 0.1
		}

		# the icon to be used for this level in GUI. full path. Required.
		icon = "path/to/icon.dds"

		# flags that can be checked with the has_fulfillment_parameter trigger.
		# localize their effects using the suffix 'fulfillment_level_parameter_' (e.g. 'fulfillment_level_parameter_flag_a')
		flags = {
			flag_a
			flag_b
		}
	}
}
