### Brief: key ( database key )
# Name of 'rite_type'
#
key = {

	### brief: name ( optional dynamic description )
	# Dynamic description selecting name of rite.
	# Defaults to: <rite_key>. Adjective and adherent locs are derived by this following the same patters as Faiths do.
	#
	# Supported scope:
	#	root ( Rite )
	#
	name = { ... }

	### brief: desc ( optional dynamic description )
	# Dynamic description selecting description of rite.
	# Defaults to: <key> + "_desc"
	#
	# Supported scope:
	#	root ( Rite )
	#
	desc = { ... }

	# If you want to use a specific icon. The icon will be taken from the DYNAMIC_RITE_ICON_PATH path
	icon = faith_name

	# the color that this rite will take on the map
	color = some_color

	### brief: faounder ( title key )
	# Rite founder will be first holder of provided title (unless set elsewhere in script)
	#
	founder = title_key

	### brief: faith ( database key )
	# What is the parent faith of this Rite? If a faith has no scripted Rites a dynamic one with the same name will be created instead
	# if no parent faith is defined, the Rite will not be generated from history and will only be available via the create_rite_from_type effect.
	# you can still specify parent faith overrides in specific bookmarks (see below), starting the game in those dates will generate the rite from history
	#
	faith = key

	# brief: cultures (database keys)
	# keys of cultures associated with this rite. refers to the cultures found in culture/cultures
	#
	cultures = { culture_1 culture_2 ... }

	### brief: convert (bool)
	# if set to no, characters cannot convert to this rite. default value is yes
	#
	convert = yes

	### brief: create (bool)
	# if set to no, this rite will not be created until specified in history. default value is yes
	# warning! not created rites will error when accessed with rite:key. Always check if the object is valid in script
	#
	create = yes

	### brief: tenets ( database keys )
	# List of tenets associated with this Rite. If this is a faith's scripted main Rite, these are the faith's
	# effective core tenets; do not duplicate them in the faith type.
	#
	tenets = {
		key
		key
	}

	### brief: doctrines ( database keys )
	# List of doctrines associated with this Rite. Rite doctrines override parent-religion and faith doctrines from the
	# same doctrine group. Faith doctrines from otherwise unfilled groups are added to the instantiated main Rite.
	# Put doctrine choices intrinsic to the whole faith on the faith type and Rite-specific choices here.
	#
	doctrines = {
		key
		key
	}

	tenet_selection_pair = {				# Adds a tenet if the flag is present
		requires_dlc_flag = <dlc_flag>		# Flag that will be evaluated
		tenet = name						# Name of the tenet that will be added if the dlc flag is present
		fallback_tenet = name				# Optional. If the flag isn't present and the fallback_tenet is defined, this tenet will be added instead
	}
}
