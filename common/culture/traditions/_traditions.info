###########
# Traditions
###########
#
# Traditions have the same structure as general cultural traits (see _cultural_traits.info ), except for a few added fields:
#	* category
#	* layers
#
tradition_key = {

	# usual cultural traits
	parameters = { ... }

	# category: string
	# used for grouping in the Add Tradition view, and in the Divergence view.
	# Doesn't have a default, will error if left undefined.
	#
	category = string
	
	# Layers for UI view.
	# They match the CULTURE_TRADITION_LAYER_PATHS define. Index starts from 0
	#
	layers = {
		# Use a random icon from the specific subfolder
		0 = martial
		
		# By leaving out an index (e.g. 1 = blah), it'll use a random icon from the folder
		
		# By specifying a file name, that specific file will get used
		3 = letter1.dds
	}	
}
