######################
# CULTURAL TRAITS
######################
#
# This documents the cultural trait systems, meaning:
# Cultural Pillars
# Cultural Traditions
#
# Anything that's unique to one of these will be documented inside their folder instead.

object_key = {
	name = dynamic desc			# If omitted, will use object_key + "_name"
	desc = dynamic desc			# If omitted, will use object_key + "_desc"
	icon = key 					# If omitted, will use object_key

	# cost: scripted cost for the adoption of this pillar or tradition.
	# Scopes:
	#	* root: the Culture being altered
	#	* traits: list of pillars and traditions of the culture
	#	* character: the Character evaluating these costs (usually Culture Head)
	#	* replacing: boolean, whether you are replacing this pillar or tradition with another one
	#
	cost = {
		gold = script value
		prestige = script value
		piety = script value
	}

	character_modifier = {}		# Applied to characters of any culture that has the trait
	province_modifier = {}		# Applied to provinces of any culture that has the trait
	county_modifier = {}		# Applied to counties of any culture that has the trait
	culture_modifier = {}		# Applied to any culture that has the trait
	faith_character_modifier = { # Applied to characters of cultures with the perk if they have the given doctrine
		doctrine = doctrine_theocracy_lay_clergy
		same_faith_opinion = 3
	}

	# can_pick: trigger. Can this trait be picked when altering the culture?
	# Scopes:
	#	* root: the Culture being altered
	#	* traits: list of pillars and traditions of the culture
	#	* character: the Character evaluating whether to pick the trait
	#	* replacing: the pillar or tradition being replaced, if any
	#
	# The list "traits" is provided with all currently picked traits so that mutually exclusive traits can be scripted
	# If a trait is being replaced scope:replacing will be the flag of a culture with the replacing culture's key, e.g: "scope:replacing = culture_tradition:tradition_monogamous". It will NEVER exist when evaluating pillars. 
	# Hybridization ignores this and is_shown entirely
	#
	can_pick = {
		...
	}
	
	# is_shown: trigger. Should this trait be shown at all when picking traits?
	# Hybridization ignores this and can_pick entirely
	is_shown = { ... }
	
	# can_pick_for_hybridization: trigger. Can this trait be picked when hybridizing?
	# Like can_pick, except used specifically for hybridization and *only* for hybridization. Will never have "scope:replacing".
	can_pick_for_hybridization = { ... } 

	# parameters: list of flags
	# you can check if the culture has any trait containing a flag with has_culture_parameter = flag
	#
	parameters = {
		param_name
	}

	# partners: special container for number of partners
	partners = {
		
		# number_of_spouses: int
		# Max number of spouses for characters with this trait.
		# This will override faith spouses and consorts
		# default is -1 and will be ignored
		# 
		number_of_spouses = -1

		# number_of_consorts_by_tier: tier-to-int
		# Max number of concubines for characters with this trait at a given landed title tier.
		# This will override faith spouses and consorts, as well as the generic number_of_consorts number
		# you can leave some tiers empty and they will not be considered as defined.
		#
		number_of_consorts_by_tier = {
			hegemony = 5
		}
		
		# number_of_consorts: int
		# Max number of concubines for characters with this trait.
		# Can be used together with number_of_consorts_by_tier to cover the tiers not defined by number_of_consorts_by_tier
		# This will override faith spouses and consorts
		# default is -1 and will be ignored
		# 
		number_of_consorts = 1
	}

	# ai_will_do: value used to prioritize traits when AI diverges or changes cultural traditions.
	#
	# Scopes:
	#	* root: the Culture being altered
	#	* traits: list of pillars and traditions of the culture
	#	* character: the Character evaluating whether to pick the trait
	#
	ai_will_do = {
		...
	}
}

# == Triggers ==
# Unless otherwise specified, these are all in culture scope.
# 
# has_cultural_pillar = key
# has_cultural_tradition = key
# has_cultural_parameter = key	# Checks if any ethos, pillar, or tradition has this parameter
# 
# == can_pick caveat ==
# When the AI picks its configuration for divergence, it does so one pillar/tradition at a time. It will not re-examine previous choices.
# This means that if any trait can prevent another trait, this *must* go in both directions.
# 	E.G., if "warlike" prevents "peaceful", "peaceful" must prevent "warlike".
# 	Otherwise the AI could pick "warlike" first, then "peaceful", and invalidate its earlier pick and be stuck unable to diverge.
#
# Allowed Modifiers
###################
# 
# Modifiers referenced by a culture trait can be only generic (hardcoded) modifiers, or modifiers generated from the following databases:
# - schemes
# - holdings
# - lifestyles
# - regions
# - terrains
# - men_at_arms_types
# - governments
# 
# Other generated modifiers are _not_ allowed, such as those from culture templates
