###
# Holy order type
#
#	A weighted collection of data that will be used to dynamically create a Holy Order
#
key = {

	# brief: type
	# specifies which type of holy order this type describes. Required; if missing an error is logged and it falls back to 'military'.
	# only types matching the type requested by create_holy_order will be considered
	#
	# values:
	#	monastic
	#	military
	#
	type = military

	# brief: government type
	# Specifies government type this holy order should use. It is locked to this government type
	#
	government = holy_order_government

	# brief: trigger (trigger on empty scope)
	# Is this type valid given the creation context?
	# Make sure to leave some types with empty triggers as fallback.
	# supported scopes:
	#	* leader (character who will lead the Holy Order)
	#	* founder (character who is founding the Holy Order)
	#	* province (the province that will be leased out)
	#
	trigger = {}

	# brief: weight (scripted value on empty scope)
	# This Holy Order type will be chosen among available ones with this weight.
	# Zero or negative weights will not be considered.
	# supported scopes:
	#	* leader (character who will lead the Holy Order)
	#	* founder (character who is founding the Holy Order)
	#	* province (the province that will be leased out)
	#
	weight = {}

	# brief: title (title key, optional)
	# if defined, the Holy Order will be assigned this title. The name of the Holy Order will be derived from the title.
	# this Holy Order Type will be ignored if the title is already held by someone when the Holy Order is created.
	#
	title = d_knights_templar

	# brief: name
	# loc key for the holy order name. Defaults to the key of the holy order if left empty and without scripted title.
	# will be localized with
	#	* FOUNDER (character who is founding the Holy Order)
	#	* LEADER (character who is going to lead the Holy Order)
	#	* PROVINCE (the leased out barony province)
	#	* TITLE (the leased out barony title)
	#	* FAITH (the faith of the founder)
	#
	name = "holy_order_knights_templar"

	# brief: coat_of_arms (scripted coat of arms, optional)
	#
	coat_of_arms = "ho_knights_templar"

	# brief: men_at_arms (men_at_arms key, optional)
	# specify which men at arms will be preferred when hiring troops. Only valid for military Holy Orders.
	# See the section below for details on men-at-arms pick priorities.
	#
	men_at_arms = { tawashi onager }

	# brief: tenet (tenet key, optional)
	# specify which tenet will be set up when creating a holy order of this type.
	# If it may change depending on external factors set it up with set_order_tenet in the effect
	#
	tenet = tenet_communion

	# brief: effect (effect, optional)
	# optionally run effects on the Holy Order.
	# Take care to avoid succession as this could be triggered when the game state is broken.
	# supported scopes:
	#	* root: the title assigned to the holy order
	#	* leader (character who will lead the Holy Order)
	#	* founder (character who is founding the Holy Order)
	#	* province (the barony province that will be leased out)
	#	* title (the title assigned to the holy order)
	# 	* new_holy_order (the just-created holy order)
	#	* rite (the rite of the holy order)
	#
	effect = {}
}

########################################################
#	Men at Arms hiring priority
########################################################
#
# Holy Orders will hire Men at Arms with the following order of priority:
#	1. Holy Order Type 'men_at_arms' (if specified, last-is-best)
#	2. Religion-based 'holy_order_maa' (if specified, last-is-best)
#	3. Men-at-Arms unlocked by Culture (random)
#	4. 'fallback' Men-at-Arms (random)
#
#	'last-is-best' priorities assume that the array is sorted so that the last MaAs are implied to be
#		better picks than the previous ones. The game will hire the latest MaA type that is unlocked by
#		the owner's culture.
#
#	Priority 3 (Men-at-Arms unlocked by Culture) needs the 'allowed_in_hired_troops = yes' flag set
#		in order for the MaA to be picked.
#
#	Holy Orders can hire MaAs flagged with the 'special_recruit_only = yes' flag
