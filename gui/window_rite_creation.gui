#####################################################
################## RITE CREATION ####################
#####################################################

window = {
	name = "rite_creation_window"
	widgetid = "rite_creation_window"
	datacontext = "[RiteCreationWindow.GetVassalConversionWindow]"
	datacontext = "[GetVariableSystem]"
	parentanchor = center
	size = { 1300 950 }
	layer = middle

	using = Window_Background
	using = Window_Decoration

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		on_start = "[GetVariableSystem.Set( 'faith_creation_doctrine_page', 'main_group' )]"
		on_start = "[GetVariableSystem.Set( 'faith_creation_icon_selection', 'false' )]"
		on_start = "[GetVariableSystem.Clear('faith_creation_right_view')]"
		on_start = "[GetVariableSystem.Clear('conversion_view_vassals')]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	vbox = {
		using = Window_Margins

		header_pattern = {
			layoutpolicy_horizontal = expanding
			visible = "[Not( GetPlayer.GetFaith.IsUnreformed )]"

			blockoverride "header_text"
			{
				text = "RITE_CREATION_VIEW_TITLE"
			}

			blockoverride "button_close"
			{
				onclick = "[RiteCreationWindow.Close]"
			}

			blockoverride "button_back"
			{
				visible = "[HasViewHistory]"
				onclick = "[OpenFromViewHistory]"
				tooltip = "[GetViewHistoryTooltip]"
			}
		}

		header_pattern = {
			layoutpolicy_horizontal = expanding
			visible = "[GetPlayer.GetFaith.IsUnreformed]"

			blockoverride "header_text"
			{
				text = "RITE_CREATION_VIEW_TITLE_REFORM_RITE"
			}

			blockoverride "button_close"
			{
				onclick = "[RiteCreationWindow.Close]"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			widget = {
				name = "left_side"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vbox = {
					visible = "[Not(VariableSystem.Exists( 'conversion_view_vassals' ))]"
					spacing = 10

					hbox = {
						name = "name_and_icon"
						margin_top = 15
						spacing = 10

						button_standard = {
							size = { 60 60 }
							visible = "[Not( GetPlayer.GetFaith.IsUnreformed )]"
							onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'icon_selection' )]"
							tooltip = "RITE_CREATION_VIEW_ICON_CHANGE_TT"

							highlight_icon = {
								name = "faith_icon"
								parentanchor = center
								size = { 52 52 }
								texture = "[RiteCreationWindow.GetFaithIcon]"
								onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'icon_selection' )]"
							}

							animation_attention_text = {
								visible = "[Not(GetVariableSystem.HasValue( 'faith_creation_icon_selection', 'true' ))]"
							}
						}

						hbox = {
							visible = "[GetPlayer.GetFaith.IsUnreformed]"
							layoutpolicy_horizontal = expanding

							icon = {
								visible = "[GetPlayer.GetFaith.IsUnreformed]"
								name = "faith_icon"
								size = { 45 45 }
								texture = "[RiteCreationWindow.GetFaithIcon]"
							}

							text_single = {
								name = "faith_name_static"
								visible = "[GetPlayer.GetFaith.IsUnreformed]"

								text = "RITE_CREATION_VIEW_NEW_NAME"
								default_format = "#high"
								using = Font_Size_Big
							}
						}

						button_standard = {
							name = "faith_name"
							size = { 550 60 }
							visible = "[Not( GetPlayer.GetFaith.IsUnreformed )]"
							onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'name_selection' )]"
							tooltip = "RITE_CREATION_VIEW_NEW_NAME_TT"

							text_multi = {
								name = "faith_name_label"
								size = { 100% 100% }
								margin = { 10 0 }

								text = "RITE_CREATION_VIEW_NEW_NAME"
								default_format = "#high"
								using = Font_Size_Big
								align = center|nobaseline
								fontsize_min = 16
							}

							icon = {
								size = { 40 40 }
								parentanchor = right|vcenter
								position = { -6 0 }

								texture = "gfx/interface/icons/flat_icons/replace.dds"
								using = Master_Button_Modify_Texture
							}
						}

						map_color_button = {
							tooltip = "RITE_CREATION_VIEW_COLOR_TT"

							blockoverride "mcb_click"
							{
								onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'color_selection' )]"
							}

							blockoverride "mcb_color"
							{
								tintcolor = "[RiteCreationWindow.GetColor]"
							}
						}
					}

					divider = {
						layoutpolicy_horizontal = expanding
					}

					vbox = {
						name = "tenets"
						layoutpolicy_horizontal = expanding
						spacing = 15

						text_label_center = {
							text = "[core_tenets|E]"
						}

						hbox = {
							name = "tenets_grid"
							spacing = 45

							datamodel = "[RiteCreationWindow.GetTenets]"
							item = {
								button_group = {
									datacontext = "[TenetItem.GetTenet]"
									datacontext = "[TenetItem.GetFaith]"
									allow_outside = yes

									onclick = "[RiteCreationWindow.GetDoctrineCategoryWindow.ShowWindowSortList( TenetItem.GetSlotIndex )]"
									onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'tenet_selection' )]"

									icon = {
										size = { 130 160 }
										scale = 1.5
										parentanchor = center
										visible = "[EqualTo_int32( TenetItem.GetSlotIndex, RiteCreationWindow.GetDoctrineCategoryWindow.GetSlotIndex ) ]"
										texture = "gfx/portraits/portrait_glow.dds"
										using = Color_Orange
									}

									widget_tenet_item = {
										datacontext = "[TenetItem.GetTenet]"
										datacontext = "[TenetItem.GetFaith]"
										datacontext = "[TenetItem.GetRite]"

										blockoverride "tenet_enabled" {
											enabled = yes
										}

										blockoverride "divergent_tenet" {
											visible = no
										}
										blockoverride "divergence_visibility" {
											visible = no
										}
										blockoverride "popularity_visibility"
										{
											visible = "[TenetType.IsValid]"
										}

										blockoverride "divergence_change" {
											hbox = {
												visible = "[TenetType.IsValid]"
												layoutpolicy_horizontal = expanding

												text_single = {
													text = "RITE_CREATION_TENET_DIVERGENCE_TT"
												}

												expand = {}
											}
										}

										blockoverride "input_info_text_bottom"
										{
											visible = "[TenetType.IsValid]"
											text = "RITE_CREATION_VIEW_TENET_CLICK_TO_CHANGE"
											tooltip = "[RiteCreationWindow.GetTenetCostTooltip( TenetType.Self )]"
										}

										blockoverride "divergence_text"
										{
											text_label_center = {
												parentanchor = bottom|hcenter
												layoutpolicy_horizontal = expanding
												position = { 0 7 }
												visible = "[TenetType.IsValid]"
												text = "RITE_CREATION_VIEW_TENET_DIVERGENCE_AND_COST_SHORT"
												tooltip = "RITE_CREATION_VIEW_TENET_DIVERGENCE_AND_COST_TT"
											}
										}
									}
								}
							}
						}
					}

					divider = {
						layoutpolicy_horizontal = expanding
					}

					### SINS & VIRTUES
					widget_sins_virtues = {
						blockoverride "datamodel_sins"
						{
							datamodel = "[RiteCreationWindow.GetSins]"
						}
						blockoverride "datamodel_virtues"
						{
							datamodel = "[RiteCreationWindow.GetVirtues]"
						}
					}

					### DOCTRINES
					vbox = {
						name = "doctrines"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						margin_bottom = 5

						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							blockoverride "scrollbox_content"
							{
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10

									text_label_left = {
										layoutpolicy_horizontal = expanding
										text = "FAITH_DOCTRINES_IMPORTANT"
										default_format = "#low"
									}

									fixedgridbox = {
										name = "doctrines_grid_main_group"

										flipdirection = yes
										addcolumn = 270
										addrow = 65
										datamodel_wrap = 2

										datamodel = "[RiteCreationWindow.GetCategoryHelper( 'main_group' ).GetCategory]"
										item = {
											widget_doctrine_selection_item = {
												blockoverride "doctrine_icon_texture"
												{
													texture = "[DoctrineType.GetIcon]"
												}
											}
										}
									}
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10

									text_label_left = {
										layoutpolicy_horizontal = expanding

										text = "FAITH_DOCTRINES_MARRIAGE"
										default_format = "#low"
									}

									fixedgridbox = {
										name = "doctrines_grid_marriage"

										flipdirection = yes
										addcolumn = 270
										addrow = 65
										datamodel_wrap = 2

										datamodel = "[RiteCreationWindow.GetCategoryHelper( 'marriage' ).GetCategory]"
										item = {
											widget_doctrine_selection_item = {}
										}
									}

								}

								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10

									text_label_left = {
										layoutpolicy_horizontal = expanding

										text = "FAITH_DOCTRINES_CRIMES"
										default_format = "#low"
									}

									fixedgridbox = {
										name = "doctrines_grid_crimes"

										flipdirection = yes
										addcolumn = 270
										addrow = 65
										datamodel_wrap = 2

										datamodel = "[RiteCreationWindow.GetCategoryHelper( 'crimes' ).GetCategory]"
										item = {
											widget_doctrine_selection_item = {}
										}
									}
								}

								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10

									text_label_left = {
										layoutpolicy_horizontal = expanding

										text = "FAITH_DOCTRINES_CLERGY"
										default_format = "#low"
									}

									fixedgridbox = {
										name = "doctrines_grid_clergy"

										flipdirection = yes
										addcolumn = 270
										addrow = 65
										datamodel_wrap = 2

										datamodel = "[RiteCreationWindow.GetCategoryHelper( 'clergy' ).GetCategory]"
										item = {
											widget_doctrine_selection_item = {}
										}
									}
								}
							}
						}
					}
				}

				# Vassal conversion list
				vassal_conversion_preview = {
					visible = "[VariableSystem.Exists( 'conversion_view_vassals')]"
					size = { 100% 100% }
				}
			}

			divider = {
				layoutpolicy_vertical = expanding
			}

			### RIGHT PANEL
			widget = {
				name = "right_side"
				minimumsize = { 500 0 }
				layoutpolicy_vertical = expanding

				## Main right side view
				vbox = {
					name = "primary_view"
					visible = "[Not( VariableSystem.Exists('faith_creation_right_view') )]"
					margin_bottom = 15

					state = {
						name = _show
						using = Animation_FadeIn_Quick
					}

					state = {
						name = _hide
						alpha = 0
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_background" {
							background = {
								using = Background_Area
								alpha = 0.3
							}
						}
						blockoverride "scrollbox_margins" {
							margin_top = 20
							margin_bottom = 20
						}

						blockoverride "scrollbox_content" {

							### EDIT RITE CONTENTS
							vbox_rite_creation_details = {
								blockoverride "details_visibility"
								{
									visible = "[RiteCreationWindow.IsEditing]"
								}

								blockoverride "confirm_blockers"
								{
									text = "[RiteCreationWindow.GetEditBlockers]"
								}
							}

							### CREATE RITE CONTENTS
							vbox_rite_creation_details = {
								blockoverride "details_visibility"
								{
									visible = "[RiteCreationWindow.IsCreating]"
								}
							}
						}
					}

					spacer = {
						size = { 0 15 }
					}

					vbox = {
						name = "divergence"

						text_single = {
							text = "RITE_CREATION_DIVERGENCE"

							tooltipwidget = {
								widget_rite_divergence_tooltip = {
									datacontext = "[RiteCreationWindow.GetRite.GetFaith]"
									datacontext = "[RiteCreationWindow.GetRiteDivergenceTooltip]"
									blockoverride "main_rite_header_visible"
									{
										visible = no
									}
								}
							}
						}

						text_multi = {
							datacontext = "[GetPlayer.GetFaith]"
							datacontext = "[GetPlayer.GetRite]"
							visible = "[And3( Or( Not( Rite.IsMain ), RiteCreationWindow.IsCreating ), Not( RiteCreationWindow.DivergenceResultsInFaithCreation ), LessThan_CFixedPoint( RiteCreationWindow.GetRiteDivergence, Faith.GetHeresyThreshold ) )]"
							autoresize = yes
							max_width = 420
							text = "RITE_CREATION_VIEW_HERETICAL_DIVERGENCE"
						}

						text_multi = {
							datacontext = "[GetPlayer.GetFaith]"
							datacontext = "[GetPlayer.GetRite]"
							visible = "[Nor3( And( Rite.IsMain , RiteCreationWindow.IsEditing ), RiteCreationWindow.DivergenceResultsInFaithCreation, LessThan_CFixedPoint( RiteCreationWindow.GetRiteDivergence, Faith.GetHeresyThreshold ) )]"
							autoresize = yes
							max_width = 420
							text = "RITE_CREATION_WARNING_HERETICAL_DIVERGENCE"
						}

						text_multi = {
							visible = "[RiteCreationWindow.DivergenceResultsInFaithCreation]"
							autoresize = yes
							max_width = 420
							text = "RITE_CREATION_VIEW_CONFIRM_NEW_FAITH"
							align = center
						}
					}

					spacer = {
						size = { 0 10 }
					}

					vbox = {
						name = "cost"
						tooltipwidget = {

							widget_value_breakdown_tooltip = {
								datacontext = "[RiteCreationWindow.GetCostTooltip]"

								blockoverride "header" {
									hbox = {
										layoutpolicy_horizontal = expanding
										visible = "[Not( StringIsEmpty( ValueBreakdown.GetName ) )]"

										text_label_left = {
											layoutpolicy_horizontal = expanding
											text = "[ValueBreakdown.GetName]"

											default_format = "#T"
										}

										text_single = {
											text = "[ValueBreakdown.GetValue|V0]"
											default_format = "#T"
											align = nobaseline
										}
									}
								}
							}
						}

						text_single = {
							layoutpolicy_horizontal = expanding

							text = "FAITH_CREATION_TOTAL_COST"
							using = Font_Size_Medium
							default_format = "#high"
							align = right

							background = {
								visible = "[GreaterThan_CFixedPoint( RiteCreationWindow.CalcPietyMissing, '(CFixedPoint)0.0' )]"
								margin = { 5 0 }

								using = Status_Bad
							}
						}
					}

					spacer = { size = { 0 10 } }

					text_multi = {
						name = "cooldown"
						layoutpolicy_horizontal = expanding
						align = center

						text = "RITE_CREATION_VIEW_BLOCKER_COOLDOWN"
						using = Font_Size_Medium
						default_format = "#low"
						autoresize = yes
						max_width = 400
					}

					spacer = { size = { 0 10 } }

					button_primary = {
						name = "edit_faith"
						visible = "[And( RiteCreationWindow.IsEditing, Not( GetPlayer.GetFaith.IsUnreformed ) )]"
						size = { 400 60 }

						enabled = "[And( RiteCreationWindow.CanEditRite, Not( IsObserver ) )]"
						onclick = "[RiteCreationWindow.EditRite]"
						tooltip = "RITE_CREATION_VIEW_EDIT_TT"

						text = "RITE_CREATION_VIEW_EDIT"
						using = Font_Size_Medium
					}

					button_primary = {
						name = "create_faith"
						visible = "[And( RiteCreationWindow.IsCreating, Not( GetPlayer.GetFaith.IsUnreformed ) )]"
						size = { 400 60 }

						enabled = "[And( RiteCreationWindow.CanCreateRite, Not( IsObserver ) )]"
						onclick = "[RiteCreationWindow.CreateRite]"
						tooltip = "RITE_CREATION_VIEW_CREATE_TT"

						text = "RITE_CREATION_VIEW_CREATE"
						using = Font_Size_Medium
					}

					button_primary = {
						name = "reform_faith"
						visible = "[GetPlayer.GetFaith.IsUnreformed]"
						size = { 400 60 }

						enabled = "[And( RiteCreationWindow.CanCreateRite, Not( IsObserver ) )]"
						onclick = "[RiteCreationWindow.CreateRite]"
						tooltip = "RITE_REFORM_BUTTON_TOOLTIP"

						text = "RITE_CREATION_REFORM"
						using = Font_Size_Big
					}
				}

				## Name selection
				vbox = {
					name = "name_selection"
					visible = "[VariableSystem.HasValue( 'faith_creation_right_view', 'name_selection' )]"
					margin = { 0 15 }
					spacing = 20

					state = {
						name = _show
						using = Animation_FadeIn_Quick
					}

					state = {
						name = _hide
						alpha = 0
					}

					hbox = {
						text_single = {
							name = "header_label"
							text = "RITE_CREATION_VIEW_NAMING_HEADER"
							default_format = "#I"
						}

						spacer = {
							size = { 10 0 }
						}

						button_randomize = {
							name = "reroll_names"
							size = { 30 30 }
							visible = "[RiteCreationWindow.CanAutoFill]"
							onclick = "[RiteCreationWindow.RerollNames]"
							tooltip = "RITE_CREATION_VIEW_NAMING_REROLL_TT"
							using = tooltip_ne
						}

						button_edit_text = {
							name = "generate_description"
							size = { 30 30 }
							visible = "[RiteCreationWindow.CanAutoFill]"
							onclick = "[RiteCreationWindow.GenerateDescription]"
							tooltip = "RITE_CREATION_VIEW_NAMING_GENERATE_DESC_TT"
							using = tooltip_ne
						}
					}

					vbox = {
						margin = { 50 0 }
						layoutpolicy_horizontal = expanding

						# These four names are referenced in code, so renaming them breaks the blanking after creation
						name_entry_big = {
							blockoverride "label"
							{
								text = "RITE_CREATION_VIEW_NAMING_NAME"
							}

							blockoverride "editbox_properties"
							{
								name = "faith_name_edit"
								focus_on_visible = yes
								ontextedited = "[RiteCreationWindow.OnEditName]"
								maxcharacters = 30
							}
						}

						widget = {
							size = { 10 10 }
						}

						name_entry_big = {
							blockoverride "label"
							{
								text = "RITE_CREATION_VIEW_NAMING_ADJECTIVE"
							}

							blockoverride "editbox_properties"
							{
								name = "faith_adjective_edit"
								ontextedited = "[RiteCreationWindow.OnEditAdjective]"
								maxcharacters = 30
							}
						}

						widget = {
							size = { 10 10 }
						}

						name_entry_big = {
							blockoverride "label"
							{
								text = "RITE_CREATION_VIEW_NAMING_FOLLOWER"
							}

							blockoverride "editbox_properties"
							{
								name = "faith_adherent_edit"
								ontextedited = "[RiteCreationWindow.OnEditAdherent]"
								maxcharacters = 30
							}
						}

						widget = {
							size = { 10 10 }
						}

						name_entry_big = {
							blockoverride "label"
							{
								text = "RITE_CREATION_VIEW_NAMING_FOLLOWERS"
							}

							blockoverride "editbox_properties"
							{
								name = "faith_adherent_plural_edit"
								ontextedited = "[RiteCreationWindow.OnEditAdherentPlural]"
								maxcharacters = 30
							}
						}

						widget = {
							size = { 10 10 }
						}

						editbox_standard_with_label = {
							layoutpolicy_horizontal = expanding

							minimumsize = {0 220}

							blockoverride "editbox_label"
							{
								text = "FAITH_CREATION_NAMING_DESC"
							}

							blockoverride "editbox_properties"
							{
								name = "faith_desc_edit"
								multiline = yes
								ontextedited = "[RiteCreationWindow.OnEditDescription]"
								maxcharacters = "[IntToUnsigned( GetDefine( 'NRite', 'RITE_CREATION_DESCRIPTION_MAX_LENGTH' ) )]"
							}
						}
					}

					expand = {}

					button_standard = {
						name = "done"
						onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"
						text = "DONE"
						default_format = "#high"
					}
				}

				vbox = {
					name = "color_selection"
					visible = "[VariableSystem.HasValue( 'faith_creation_right_view', 'color_selection' )]"
					margin = { 0 20 }
					margin_top = 15
					margin_left = 2

					spacing = 10

					text_label_center = {
						layoutpolicy_horizontal = expanding

						text = "RITE_CREATION_VIEW_COLOR_HEADER"
						max_width = 280
					}

					colorpicker_simple = {
						color = "[RiteCreationWindow.GetColor]"
						oncoloredited = "[RiteCreationWindow.SetColor]"
					}

					expand = {}

					button_standard = {
						name = "done"

						onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"

						text = "DONE"
						default_format = "#high"
					}
				}

				## Tenet / Doctrine selection
				vbox_tenet_selection = {
					visible = "[VariableSystem.HasValue( 'faith_creation_right_view', 'tenet_selection' )]"
				}

				vbox_doctrine_selection = {
					visible = "[VariableSystem.HasValue( 'faith_creation_right_view', 'doctrine_selection' )]"

					blockoverride "divergence_text"
					{
						text_label_center = {
							layoutpolicy_horizontal = expanding
							text = "RITE_CREATION_VIEW_TENET_DIVERGENCE_AND_COST_SHORT"
						}
					}
				}

				## Icon selection
				vbox = {
					name = "icon_selection"
					visible = "[VariableSystem.HasValue( 'faith_creation_right_view', 'icon_selection' )]"
					margin = { 0 15 }

					spacing = 20

					state = {
						name = _show
						using = Animation_FadeIn_Quick
					}

					state = {
						name = _hide
						alpha = 0
					}

					text_single = {
						name = "header_label"
						text = "RITE_CREATION_VIEW_ICON_SELECT"
						default_format = "#I"
					}

					scrollbox = {
						name = "contents"

						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_margins" {
							margin = { 10 15 }
							margin_bottom = 20
							margin_left = 5
						}

						blockoverride "scrollbox_content"
						{
							fixedgridbox = {
								layoutpolicy_horizontal = expanding
								name = "icons_grid"
								size = { 500 240 }

								addcolumn = 60
								addrow = 70
								datamodel_wrap = 8
								flipdirection = yes

								datamodel = "[RiteCreationWindow.GetFaithIcons]"
								item = {
									button_normal = {
										size = { 60 60 }

										onclick = "[RiteCreationWindow.SelectFaithIcon( FaithIcon.GetName )]"
										onclick = "[GetVariableSystem.Set( 'faith_creation_icon_selection', 'true' )]"
										onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"

										tooltipwidget = {
											using = rite_creation_icon_select_cooltip
										}

										texture = "[FaithIcon.GetTexture]"

										glow = {
											using = Color_Orange
											visible = "[FaithIcon.IsSelected]"

											glow_radius = 5
											using = Glow_Standard
										}
									}
								}
							}
						}
					}

					button_standard = {
						name = "cancel"

						onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"

						text = "CANCEL"
						default_format = "#high"
					}
				}
			}
		}
	}
}

template rite_creation_icon_select_cooltip
{
	object_tooltip_pop_out = {
		blockoverride "header_additions"
		{
			hbox = {
				margin_right = 5
				margin_top = 5

				icon = {
					size = { 52 52 }
					texture = "[FaithIcon.GetTexture]"
				}
			}
		}

		blockoverride "title_text"
		{
			text = "RITE_CREATION_VIEW_ICON_TITLE"
		}

		blockoverride "concept_link" {}
		blockoverride "description_text"
		{
			text = "RITE_CREATION_VIEW_ICON_SELECT_CLICK"
		}
	}
}

template faith_window_trait_tooltip
{
	object_tooltip_pop_out = {
		blockoverride "header_additions"
		{
			hbox = {
				margin_right = 5
				margin_top = 5

				icon = {
					size = { 52 52 }
					texture = "[Trait.GetIcon( GetPlayer )]"
					tintcolor = "[TooltipInfo.GetTintColor]"
				}
			}
		}
		blockoverride "title_text"
		{
			text = "[Trait.GetNameNoTooltip( GetPlayer )]"
		}
		blockoverride "concept_link" {
			text = [trait|E]
		}
		blockoverride "description_text"
		{
			block "virtue_or_sin_description_text"
			{
				text = "[Trait.GetVirtueOrSinFullDescription( Rite.Self )]"
			}
		}

		# Unused here; cleared so overrides from a parent tooltip don't cascade in when this is nested in one
		blockoverride "subtitle_text" {}
		blockoverride "extra_data" {}
		blockoverride "extra_data_after_description" {}
	}
}

types RiteCreationWindow
{
	type name_entry_big = editbox_standard_with_label {
		size = { 380 30 }

		layoutpolicy_horizontal = expanding

		blockoverride "editbox_label"
		{
			block "label"
			{
				text = "DEFAULT_TEXT"
			}
		}
	}

	type widget_doctrine_selection_item = button_standard_hover {
		datacontext = "[DoctrineItem.GetFaith]"
		datacontext = "[DoctrineItem.GetRite]"
		datacontext = "[DoctrineItem.GetDoctrine]"
		datacontext = "[DoctrineType.GetGroup]"
		size = { 240 53 }

		background = {
			using = Background_Area
			margin = { 5 5 }
		}

		onclick = "[RiteCreationWindow.GetDoctrineCategoryWindow.ShowWindow( DoctrineItem.GetSlotIndex )]"
		onclick = "[GetVariableSystem.Set( 'faith_creation_right_view', 'doctrine_selection' )]"
		onclick = "[GetVariableSystem.Set( 'doctrine_group_name', DoctrineGroupType.GetName( Faith.Self ) )]"
		down = "[And(GetVariableSystem.HasValue( 'doctrine_group_name', DoctrineGroupType.GetName( Faith.Self ) ), GetVariableSystem.HasValue( 'faith_creation_right_view', 'doctrine_selection' ))]"

		tooltipwidget = {
			using = doctrine_type_tooltip

			blockoverride "input_info_text"
			{
				text = "RITE_CREATION_VIEW_DOCTRINE_CLICK_TO_CHANGE"
				tooltip = "[RiteCreationWindow.GetDoctrineCostTooltip( DoctrineType.Self )]"
			}
		}
		using = tooltip_nw

		hbox = {
			name = "faith_list_item"

			spacing = 5

			icon_doctrine = {
				name = "doctrine_icon"
				size = { 50 50 }

				block "doctrine_icon_texture"
				{
					texture = "[DoctrineGroupType.GetIcon]"
				}

				alpha = "[Select_float( GetPlayer.GetFaith.HasDoctrine( DoctrineType.Self ), '(float)0.4', '(float)1.0' )]"
			}

			vbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					name = "doctrine_group_name"
					layoutpolicy_horizontal = expanding

					text = "[DoctrineGroupType.GetName( Faith.Self )]"
					align = left
					default_format = "#low"
					autoresize = no
					fontsize_min = 12
				}

				text_single = {
					name = "faith_name"
					datacontext = "[DoctrineItem.GetFaith]"
					layoutpolicy_horizontal = expanding

					text = "[DoctrineType.GetNameNoTooltip( Faith.Self )]"
					elide = right
					autoresize = no
					fontsize_min = 12
					align = left|nobaseline
				}
			}

			text_single = {
				visible = "[NotEqualTo_CFixedPoint( DoctrineItem.GetDivergence, '(CFixedPoint)0' )]"
				margin_right = 5

				text = "RITE_CREATION_DOCTRINE_DIVERGENCE"
			}
		}

		warning_icon = {
			visible = "[And( DoctrineItem.IsFaithLocked, RiteCreationWindow.IsCreatingFaith )]"
			parentanchor = top|right
			position = { -2 2 }
			size = { 25 25 }

			tooltip = "RITE_CREATION_DOCTRINE_FAITH_LOCKED_LOST_TT"
		}
	}

	type vassal_conversion_preview = widget {
		name = "vassal_conversion_preview_list"

		vbox = {
			margin = { 0 15 }
			spacing = 5

			text_label_center = {
				name = "header"
				text = "RITE_CREATION_VIEW_VASSALS_TITLE"
				using = Font_Size_Medium
			}

			hbox = {
				datacontext = "[VassalConversionWindow.GetVassalList]"
				margin = { 10 0 }

				layoutpolicy_horizontal = expanding

				widget = {
					name = "sort_area"
					size = { 0 33 }

					layoutpolicy_horizontal = expanding

					hbox = {
						margin_left = 8
						spacing = 5

						text_single = {
							text = "SORT_BY"
							align = nobaseline
						}

						dropdown_sort_characterlist = {}

						button_standard = {
							name = "sort_order"
							size = { 25 25 }

							onclick = "[CharacterSelectionList.RevertSortOrder]"
							tooltip = "CHARACTER_SORT_BY"

							button_icon = {
								size = { 25 25 }

								texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
								framesize = { 66 66 }
								frame = "[BoolTo1And2(CharacterSelectionList.GetSortOrder)]"
								alwaystransparent = yes
							}
						}

						expand = {}
					}
				}
			}

			scrollbox = {
				name = "list_area"

				layoutpolicy_horizontal = growing
				layoutpolicy_vertical = growing

				blockoverride "scrollbox_content"
				{
					visible = "[Or( GreaterThan_int32( VassalConversionWindow.GetNumberOfVassals, '(int32)0' ), GreaterThan_int32( VassalConversionWindow.GetNumberOfSubordinates, '(int32)0' ) )]"

					vbox = {
						name = "vassals_grid"
						datacontext = "[VassalConversionWindow.GetVassalList]"
						layoutpolicy_horizontal = expanding

						datamodel = "[CharacterSelectionList.GetList]"
						item = {
							vbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								divider = {
									layoutpolicy_horizontal = expanding
								}

								hbox = {
									datacontext = "[CharacterListItem.GetCharacter]"
									margin = { 10 0 }

									layoutpolicy_horizontal = expanding
									spacing = 10

									tooltip = "[CharacterListItem.GetText('tooltip')]"

									portrait_head = {
										using = tooltip_ws

										blockoverride "coa" {}
									}

									vbox = {
										coa_realm_small_crown = {
											visible = "[Character.IsRuler]"
										}

										spacer = {
											visible = "[Not( Character.IsRuler )]"
											size = { 52 32 }
										}
									}

									vbox = {
										layoutpolicy_horizontal = expanding

										text_single = {
											name = "name"
											layoutpolicy_horizontal = expanding
											autoresize = no

											text = "[Character.GetUINameNoTooltip]"
											using = Font_Size_Medium
										}

										text_single = {
											layoutpolicy_horizontal = expanding
											autoresize = no

											text = "RITE_CREATION_VASSAL_RELATION"
											using = Font_Size_Medium
										}

										text_single = {
											name = "acceptance"
											layoutpolicy_horizontal = expanding

											text = "[CharacterListItem.GetText( 'acceptance' )]"
											tooltip = "[CharacterListItem.GetText( 'acceptance_desc' )]"
										}
									}
								}
							}
						}
					}
				}

				vbox = {
					visible = "[And( EqualTo_int32( VassalConversionWindow.GetNumberOfVassals, '(int32)0' ), EqualTo_int32( VassalConversionWindow.GetNumberOfSubordinates, '(int32)0' ) )]"

					text_single = {
						text = "RITE_CREATION_VIEW_VASSALS_EMPTY"
					}
				}
			}

			vbox = {
				margin_top = 10

				block "footer" {}

				button_standard = {
					name = "close"

					onclick = "[VariableSystem.Toggle( 'conversion_view_vassals' )]"
					text = "CLOSE_LABEL"
				}
			}
		}
	}

	type vbox_doctrine_picker_item = vbox {
		layoutpolicy_horizontal = expanding

		button_standard_hover = {
			name = "faith_list_item"
			datacontext = "[DoctrineItem.GetDoctrine]"
			datacontext = "[DoctrineType.GetGroup.GetCategory]"
			datacontext = "[DoctrineItem.GetFaith]"
			datacontext = "[DoctrineItem.GetRite]"
			datacontext = "[GetVariableSystem]"
			visible = "[DoctrineItem.ShouldDisplay( TopScope.Self )]"
			size = { 430 80 }

			layoutpolicy_horizontal = expanding

			enabled = "[And( DoctrineItem.CanPick( TopScope.Self ), GetScriptedGui( 'pam_know_doctrine' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'doctrine', DoctrineType.MakeScope ).End ) )]"

			onclick = "[RiteCreationWindow.SelectDoctrine( DoctrineItem.Self )]"
			onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"
			down = "[RiteCreationWindow.HasDoctrineSelected( DoctrineType.Self )]"

			tooltipwidget = {
				using = doctrine_type_tooltip

				blockoverride "extra_data" {
					hbox = {
						layoutpolicy_horizontal = expanding
						margin ={ 5 10 }

						text_single = {
							text = "RITE_CREATION_DOCTRINE_DIVERGENCE_TT"
						}

						expand = {}
					}
				}

				blockoverride "doctrine_extra_data_after_description"
				{
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 10

						cooltip_paragraph = {
							text = "[GetScriptedGui( 'pam_know_doctrine' ).IsValidTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'doctrine', DoctrineType.MakeScope ).End )]"
						}
						cooltip_paragraph = {
							text = "[RiteCreationWindow.GetDoctrineBlockersAndCost( DoctrineType.Self )]"
						}
					}
				}

				blockoverride "input_info_text"
				{
					visible = "[And( DoctrineItem.CanPick( TopScope.Self ), GetScriptedGui( 'pam_know_doctrine' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'doctrine', DoctrineType.MakeScope ).End ) )]"

					text = "RITE_CREATION_VIEW_DOCTRINE_CLICK_TO_SELECT"
					tooltip = "[RiteCreationWindow.GetDoctrineCostTooltip( DoctrineType.Self )]"
				}
			}

			hbox = {
				margin_left = 10
				layoutpolicy_horizontal = expanding

				icon_doctrine = {
					name = "doctrine_icon_main"
					visible = "[DoctrineCategoryType.HasTag( 'main' )]"
					size = { 60 60 }

					texture = "[DoctrineType.GetIcon]"
				}

				icon_doctrine = {
					name = "doctrine_icon_other"
					visible = "[Not( DoctrineCategoryType.HasTag( 'main' ) )]"
					size = { 60 60 }

					texture = "[DoctrineType.GetGroup.GetIcon]"
				}

				### Text
				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 0 }
					margin_right = 15
					margin_bottom = 10
					spacing = 10

					text_single = {
						name = "doctrine_name"
						margin_top = 4

						text = "[DoctrineType.GetNameNoTooltip( Faith.Self )]"
						using = Font_Size_Medium
						default_format = "#high"
						max_width = 230
						min_width = 230
					}

					expand = {}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 6

						expand = {}

						text_single = {
							layoutpolicy_horizontal = expanding
							name = "piety_cost"
							autoresize = no

							text = "[RiteCreationWindow.GetDoctrineCost( DoctrineType.Self, '(bool)no' )]"
							using = Font_Size_Medium
							align = right
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							visible = "[NotEqualTo_CFixedPoint( DoctrineItem.GetDivergence, '(CFixedPoint)0' )]"

							text = "RITE_CREATION_DOCTRINE_DIVERGENCE"
							using = Font_Size_Medium
							align = right
						}

						expand = {}
					}
				}
			}
		}

		divider_light = {
			layoutpolicy_horizontal = expanding
		}
	}

	type vbox_doctrine_selection = vbox {
		name = "doctrine_selection"
		margin = { 0 15 }

		spacing = 20

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			alpha = 0
		}

		text_label_center = {
			layoutpolicy_horizontal = expanding

			text = "[VariableSystem.Get( 'doctrine_group_name' )]"
			max_width = 280
		}

		scrollbox = {
			name = "contents"

			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content"
			{
				vbox = {
					datacontext = "[RiteCreationWindow.GetDoctrineCategoryWindow]"
					datacontext = "[RiteCreationWindow.GetFaithScope]"

					layoutpolicy_horizontal = expanding

					datamodel = "[DoctrineCategoryWindow.GetDoctrineItems]"
					item = {
						vbox_doctrine_picker_item = {}
					}
				}
			}
		}

		button_standard = {
			name = "cancel"

			onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"

			text = "CANCEL"
			default_format = "#high"
		}
	}

	type vbox_creation_tenet_group_foldout = vbox {
		spacing = 4

		layoutpolicy_horizontal = expanding

		oncreate = "[BindFoldOutContext]"
		oncreate = "[PdxGuiFoldOut.Unfold]"

		button_expandable_toggle_field = {
			blockoverride "text"
			{
				text = "[TenetGroupItem.GetGroupTitle]"
				default_format = "#clickable"
			}
		}

		vbox = {
			visible = "[PdxGuiFoldOut.IsUnfolded]"
			datacontext = "[RiteCreationWindow.GetFaithScope]"

			layoutpolicy_horizontal = expanding

			fixedgridbox = {
				name = "tenets_in_group"

				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				addcolumn = 165
				addrow = 220

				datamodel_wrap = 3
				flipdirection = yes

				datamodel = "[TenetGroupItem.GetTenets]"
				item = {
					button_group = {
						datacontext = "[TenetItem.GetTenet]"
						datacontext = "[TenetItem.GetFaith]"
						datacontext = "[TenetItem.GetRite]"

						allow_outside = yes

						enabled = "[And( TenetItem.CanPick( RiteCreationWindow.GetFounder.Self, TopScope.Self ), TenetPickableForEditedRite )]"
						onclick = "[RiteCreationWindow.SelectTenet( TenetItem.Self )]"
						onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"
						down = "[RiteCreationWindow.HasTenetSelected( TenetType.Self )]"

						icon = {
							size = { 130 160 }
							scale = 1.5
							parentanchor = center
							visible = "[EqualTo_int32( TenetItem.GetSlotIndex, RiteCreationWindow.GetDoctrineCategoryWindow.GetSlotIndex ) ]"
							texture = "gfx/portraits/portrait_glow.dds"
							using = Color_Orange
						}

						widget_tenet_item = {
							datacontext = "[TenetItem.GetTenet]"
							datacontext = "[TenetItem.GetFaith]"
							datacontext = "[TenetItem.GetRite]"
							blockoverride "tenet_enabled" {}

							blockoverride "divergent_tenet" {
								visible = no
							}

							blockoverride "divergence_visibility" {
								visible = no
							}

							blockoverride "tenet_badges_layout" {
								size = { 70 50 }
								position = { 0 10 }
							}

							blockoverride "prohibited_warning"
							{
								icon = {
									visible = "[Not( TenetPickableForEditedRite )]"
									position = { 12 15 }
									size = { 25 25 }
									alwaystransparent = yes
									texture = "gfx/interface/icons/symbols/icon_alert.dds"
								}
							}

							blockoverride "divergence_change" {
								hbox = {
									layoutpolicy_horizontal = expanding

									text_single = {
										text = "RITE_CREATION_TENET_DIVERGENCE_TT"
									}

									expand = {}
								}
							}

							blockoverride "input_info_text_bottom"
							{
								text = "[SelectLocalization( TenetPickableForEditedRite, 'RITE_CREATION_VIEW_TENET_CLICK_TO_SELECT', 'RITE_CREATION_VIEW_TENET_BLOCKED_UNPOPULAR' )]"
								tooltip = "[RiteCreationWindow.GetTenetCostTooltip( TenetType.Self )]"
							}
							blockoverride "divergence_text"
							{
								text_label_center = {
									parentanchor = bottom|hcenter
									layoutpolicy_horizontal = expanding
									position = { 0 7 }
									text = "RITE_CREATION_VIEW_TENET_DIVERGENCE_AND_COST_SHORT"
									tooltip = "RITE_CREATION_VIEW_TENET_DIVERGENCE_AND_COST_TT"
								}
							}
						}
					}
				}
			}
		}
	}

	type vbox_tenet_selection = vbox {
		name = "tenet_selection"
		margin = { 0 15 }
		spacing = 5

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}

		state = {
			name = _hide
			alpha = 0
		}

		text_label_center = {
			layoutpolicy_horizontal = expanding

			text = "tenets_name"
			max_width = 280
		}

		hbox_sort_tenets = {
			datacontext = "[RiteCreationWindow.GetTenetSortController]"
		}

		scrollbox = {
			name = "contents"

			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content"
			{
				vbox = {
					datacontext = "[RiteCreationWindow.GetDoctrineCategoryWindow]"

					layoutpolicy_horizontal = expanding

					datamodel = "[RiteCreationWindow.GetTenetGroupItems]"
					item = {
						vbox_creation_tenet_group_foldout = {}
					}
				}
			}
		}

		spacer = {
			size = { 0 10 }
		}

		button_standard = {
			name = "cancel"

			onclick = "[VariableSystem.Clear( 'faith_creation_right_view' )]"

			text = "CANCEL"
			default_format = "#high"
		}
	}

	type vbox_rite_creation_details = vbox {
		name = "confirm_and_preview"
		layoutpolicy_horizontal = expanding
		block "details_visibility" {}

		margin = { 30 0 }
		spacing = 20

		vbox = {
			visible = "[RiteCreationWindow.HasBlockers]"
			layoutpolicy_horizontal = expanding
			spacing = 5

			text_label_left = {
				layoutpolicy_horizontal = expanding

				text = "RITE_CREATION_VIEW_CONFIRM_BLOCKERS"
				default_format = "#low"
			}

			hbox = {
				layoutpolicy_horizontal = expanding

				text_multi = {
					block "confirm_blockers"
					{
						text = "[RiteCreationWindow.GetCreationBlockers]"
					}
					autoresize = yes
					max_width = 440
				}

				expand = {}
			}
		}

		vbox = {
			name = "old_faith_tolerance"
			layoutpolicy_horizontal = expanding
			spacing = 5

			text_label_left = {
				name = "header"
				layoutpolicy_horizontal = expanding

				text = "RITE_CREATION_VIEW_CONFIRM_TOLERANCE"
				default_format = "#low"
			}

			hbox = {
				layoutpolicy_horizontal = expanding

				text_multi = {
					name = "desc"
					layoutpolicy_horizontal = expanding

					text = "RITE_CREATION_VIEW_CONFIRM_TOLERANCE_DESC"
					autoresize = yes
					max_width = 440
				}

				expand = {}
			}
		}

		vbox = {
			name = "realm_adoption"
			layoutpolicy_horizontal = expanding
			spacing = 5

			text_label_left = {
				name = "header"
				layoutpolicy_horizontal = expanding

				text = "RITE_CREATION_VIEW_CONFIRM_ADOPTION"
				default_format = "#low"
			}

			hbox = {
				layoutpolicy_horizontal = expanding

				text_multi = {
					name = "desc"
					layoutpolicy_horizontal = expanding

					text = "RITE_CREATION_VIEW_CONFIRM_ADOPTION_DESC"
					autoresize = yes
					max_width = 440
				}

				expand = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				button_standard = {
					name = "see_vassals"

					onclick = "[VariableSystem.Toggle( 'conversion_view_vassals' )]"
					down = "[VariableSystem.HasValue( 'conversion_view_vassals', 'true' )]"

					text = "RITE_CREATION_VIEW_VASSALS_BUTTON"
				}

				expand = {}
			}
		}

		vbox = {
			name = "pagan_reformation"
			visible = "[Or( GetPlayer.GetFaith.HasDoctrineByKey( 'unreformed_faith_doctrine' ) , GetPlayer.GetFaith.HasDoctrineByKey( 'west_african_unreformed_faith_doctrine' ) )]"
			layoutpolicy_horizontal = expanding

			spacing = 5

			text_label_left = {
				name = "header"
				layoutpolicy_horizontal = expanding

				text = "FAITH_CREATION_PAGAN_REFORM"
				default_format = "#low"
			}

			hbox = {
				layoutpolicy_horizontal = expanding

				text_multi = {
					name = "desc"
					minimumsize = { 0 70 }

					text = "FAITH_CREATION_PAGAN_REFORM_TEXT"
					autoresize = yes
					max_width = 440
				}

				expand = {}
			}
		}

		vbox = {
			name = "theocracy_info"
			visible = "[Not( ObjectsEqual( GetPlayer.GetFaith.HasParameterByKey( 'lay_clergy' ), RiteCreationWindow.HasParameter( 'lay_clergy' ) ) )]"

			layoutpolicy_horizontal = expanding
			spacing = 5

			text_label_left = {
				name = "header"
				layoutpolicy_horizontal = expanding

				text = "FAITH_CREATION_THEOCRACY_INFO"
				default_format = "#low"
			}

			hbox = {
				name = "church_property"
				visible = "[Not( RiteCreationWindow.HasParameter( 'lay_clergy' ) )]"

				layoutpolicy_horizontal = expanding
				spacing = 10

				icon_doctrine = {
					size = { 35 35 }
					texture = "[GetDoctrine( 'doctrine_theocracy_temporal' ).GetIcon]"
				}

				text_multi = {
					name = "desc"

					text = "FAITH_CREATION_ADDS_CHURCH_PROPERTY_TEXT"
					autoresize = yes
					max_width = 390
				}

				expand = {}
			}

			hbox = {
				name = "lay_clergy"
				visible = "[RiteCreationWindow.HasParameter( 'lay_clergy' )]"

				layoutpolicy_horizontal = expanding
				spacing = 10

				icon_doctrine = {
					size = { 35 35 }

					texture = "[GetDoctrine( 'doctrine_theocracy_lay_clergy' ).GetIcon]"
				}

				text_multi = {
					name = "desc"

					text = "FAITH_CREATION_ADDS_LAY_CLERGY_TEXT"
					autoresize = yes
					max_width = 390
				}

				expand = {}
			}
		}

		vbox = {
			name = "head_of_faith_info"
			visible = "[Not( RiteCreationWindow.HasParameter( 'no_head_of_faith' ) )]"
			layoutpolicy_horizontal = expanding
			spacing = 5

			text_label_left = {
				name = "header"
				layoutpolicy_horizontal = expanding

				text = "RITE_CREATION_VIEW_CONFIRM_HOF"
				default_format = "#low"
			}

			hbox = {
				name = "spiritual"
				visible = "[RiteCreationWindow.HasParameter( 'spiritual_head_of_faith' )]"

				layoutpolicy_horizontal = expanding
				spacing = 10

				icon_doctrine = {
					size = { 35 35 }
					texture = "[GetDoctrine( 'doctrine_spiritual_head' ).GetIcon]"
				}

				text_multi = {
					name = "desc"

					text = "RITE_CREATION_VIEW_CONFIRM_HOF_DESC"
					autoresize = yes
					max_width = 390
				}

				expand = {}
			}

			hbox = {
				name = "temporal"
				visible = "[RiteCreationWindow.HasParameter( 'temporal_head_of_faith' )]"

				layoutpolicy_horizontal = expanding
				spacing = 10

				icon_doctrine = {
					size = { 35 35 }
					texture = "[GetDoctrine( 'doctrine_temporal_head' ).GetIcon]"
