				layoutpolicy_horizontal = expanding
				autoresize = no
				margin_right = 5

				text = "[DoctrineGroupItem.GetGroupType.GetName( GetPlayer.GetFaith )]"

				default_format = "#S"
				align = nobaseline
			}

			expand = {}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 5
			margin_left = 10

			hbox = {
				datacontext = "[DoctrineGroupItem.GetSelectedDoctrineItem]"
				datacontext = "[DoctrineItem.GetDoctrine]"
