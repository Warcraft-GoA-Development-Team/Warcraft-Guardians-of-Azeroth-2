### Brief: key ( database key )
# Name of 'doctrine_group'
# The key will be used for the doctrine icon, combined with the path in the define FAITH_DOCTRINE_ICON_PATH
# Localization is selected by: <key> + "_name"
#
key = {
	### Brief: category ( database key )
	# What doctrine category type is this group part of?
	#
	category = <key>

	### Brief: main_rite (bool)
	# Flags if the doctrine is only applied when practiced by the main rite. Default is no.
	# This flag only enables UI warnings - the actual implementation of this logic is left to script
	#
	main_rite = no

	### Brief: divergence ( enum )
	# How this group interprets doctrine divergence
	# - category: Different doctrines within the group are separate customs.
	#			  Final impact on divergence is the sum of 2 compared doctrines from the group
	# - sequence: Different doctrines form a sequence of opinions on a spectrum with clear opposites.
	#			  Final impact on divergence is absolute difference of 2 compared doctrines
	divergence = category/sequence

	### Brief: doctrine_lock ( enum )
	# Whether this group is tied to a specific religion / faith / rite or not.
	# specific changes can make a rite lose this doctrine group.
	# If the target faith or religion has the same faith-locked or religion-locked doctrine the rite will not lose it on change.
	# default is none (not locked)
	#	rite: removed when characters of this rite create a new rite
	#	faith: removed when the rite diverges enough to move to a different faith
	#		or a new rite is created with enough divergence to create a new faith.
	#		Will also remove rite-locked doctrines. The new faith's faith-locked doctrines will be applied.
	#	religion: removed when the rite is moved to a faith of a different religion.
	#		Will also remove rite-locked and faith-locked doctrines
	doctrine_lock = none|rite|faith|religion

	### Brief: is_available_on_create ( trigger )
	# When should this doctrine group be shown when choosing doctrines?
	# If not shown, the group will go away entirely on create if present on the old faith.
	#
	# Supported scopes:
	#	root ( Faith )
	#
	is_available_on_create = { ... }
}
