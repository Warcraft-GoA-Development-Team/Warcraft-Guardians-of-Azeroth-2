#   Animations below are for male only versions					#
#   Animations that are for retargeting to female go above.		#
#################################################################

pdxmesh = {
	name = "male_body_mesh"
	file = "male_body.mesh"
	streaming = Never

	import = {
		type = skeletal_animation_set
		name = "common_body"
	}

	meshsettings = {
		name = "male_bodyShape"
		index = 0
		texture_diffuse = "male_body_diffuse.dds"
		texture_normal = "male_body_normal.dds"
