### ENTITIES ####

# COM
entity = {
	name = "m_legwear_sec_ccp4_sami_com_01_entity"
	pdxmesh = "m_legwear_sec_ccp4_sami_com_01_mesh"

	attribute = { name = "bs_body_infant_1"					blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_infant" }
	attribute = { name = "bs_body_fat_1"					blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_fat" }
	attribute = { name = "bs_body_gaunt_1"					blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_gaunt" }
	attribute = { name = "bs_body_muscular_1"				blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_muscular" }
	attribute = { name = "wc_muscle_surface" blend_shape = "wc_extended_m_legwear_sec_ccp4_sami_com_01_bs_muscular" }
	attribute = { name = "bs_body_dwarf_1"					blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_dwarf" }
	attribute = { name = "bs_body_old_1"					blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_old" }
	attribute = { name = "bs_body_long_skirt"				blend_shape = "m_legwear_sec_ccp4_sami_com_01_bs_clothed" }

	game_data = {
        portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/m_legwear/ccp4_sami/com_01/m_legwear_sec_ccp4_sami_com_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "ccp4_sami_legwear_com_01"	#A "variation" object in gfx/portraits/accessory_variations/
			}
        }
	}
}

