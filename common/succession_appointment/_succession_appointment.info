
#######################################################################
# Structure
#######################################################################

key = {

	# fixed point script value that determines base candidate score
	# root - appointment candidate
	# scope:title - title for appointment
	candidate_score = {
		value = 0
	}

	# categories of people that are by default eligible to be in succession for the title
	#
	default_candidates = { holder_close_family landed_vassal }

	# Meritocratic appointment where default candidates are all eligible people of certain level
	# Supported level sources are currencies with levels
	# If level is set:
	#	- default_candidates are ignored
	#	- cooldown is sometimes enforced
	#
	level = merit/prestige/piety/influence

	### brief: allow_children ( bool )
	# Whether or not to allow children to be evaluated for this succession
	#
	allow_children = no

	### brief: allowed_candidate_tier
	# Which candidates are allowed based on the relationship between their tier and the title's tier.
	# Landed rulers can only be appointed to lower-level landed titles if they are dejure liege of the title 
	#
	# possible values:
	#	lower: default, candidates are only valid if of lower tier than the title
	#	lower_or_equal: allows same-tier candidates as well
	#	any: no restriction
	#
	allowed_candidate_tier = lower

	### brief: use_investment_cap ( bool )
	# Wether or not appointment investment with investor use investment cap script value
	#
	use_investment_cap = yes

	### brief: keep_top_tier_titles_together ( bool )
	# If true, succession will move titles of the same tier together (e.g. duke holding two duchies will pass them both to their primary heir)
	# default is no
	#
	keep_top_tier_titles_together = no

	### brief: allow_out_of_realm_investment
	# Allows people with a different liege to invest in candidacy score.
	# normally candidacy score investment requires investor and target to have the same liege (or be both independent)
	# default is none (normal requirement, investor and target must always have same liege)
	#
	# possible values:
	#	- none (no title allows out-of-realm investment, requirement always applies)
	#	- all (all titles allow out-of-realm investment, requirement never applies)
	#	- landed (landed titles allow out-of-realm investment, requirement applies to landless titles)
	#	- landless (landless titles allow out-of-realm investment, requirement applies to landed titles)
	#
	allow_out_of_realm_investment = none

	### brief: cooldown ( bool )
	# Wether or not candidates appointed to a title will incur a cooldown before being eligible for apointment to another title
	# take care when disabling cooldown in appointment types when same-tier or higher-tier candidates are allowed: sidegrading can cause succession loops
	# default is no
	#
	cooldown = no
}

